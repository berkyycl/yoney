---
/** Model parametre kartı: altıgen tablo + eksen notları */
import { AXES, standSvg, type StandCard } from '../lib/standChart';

interface Props {
	card: StandCard;
	size?: 'large' | 'small';
	rank?: number;
}
const { card, size = 'small', rank } = Astro.props;
const svg = standSvg([{ card, color: 'var(--a2)' }], { size: 300, title: `${card.name} parametreleri` });
---

<article class:list={['stand-card', `stand-${size}`, 'pose']}>
	<div class="stand-chart tilt">
		<span class="shine"></span>
		<Fragment set:html={svg} />
	</div>
	<div class="stand-info">
		<p class="stand-tag">{rank ? <span class="stand-rank">#{rank}</span> : null}{card.provider ?? 'Sağlayıcı bilinmiyor'}</p>
		<h3 class="stand-name">{card.name}</h3>
		<dl class="stand-grades">
			{AXES.map(ax => {
				const r = card.axes[ax.id];
				return (
					<div title={r.rank ? `${r.total} model arasında ${r.rank}. sırada` : 'Bu eksende veri yok'}>
						<dt>{ax.label}</dt>
						<dd data-g={r.grade}>{r.grade}</dd>
					</div>
				);
			})}
		</dl>
	</div>
</article>

<style>
	.stand-card {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 10px;
		min-width: 0;
	}

	.stand-large {
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
		align-items: center;
		gap: 36px;
	}

	.stand-chart {
		position: relative;
		max-width: 420px;
		width: 100%;
		margin: 0 auto;
	}

	.stand-tag {
		display: flex;
		align-items: center;
		gap: 10px;
		margin: 0 0 6px;
		color: var(--muted);
		font-size: 0.72rem;
		font-weight: 800;
		font-stretch: 80%;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.stand-rank {
		color: var(--a2);
		font-family: var(--font-serif);
		font-size: 1.5rem;
		font-style: italic;
		font-weight: 900;
		letter-spacing: 0;
	}

	.stand-name {
		margin: 0 0 16px;
		font-size: 1.7rem;
		line-height: 0.98;
		text-transform: uppercase;
	}

	.stand-large .stand-name {
		font-size: clamp(2.4rem, 5vw, 4rem);
		transform: skewX(-6deg);
		transform-origin: left;
		text-shadow: 4px 4px 0 var(--a2);
	}

	.stand-grades {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0 18px;
		margin: 0;
	}

	.stand-small .stand-grades {
		grid-template-columns: 1fr 1fr 1fr;
		gap: 0 10px;
	}

	.stand-grades div {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
		padding: 7px 0;
		border-bottom: 1px solid var(--rule);
	}

	.stand-grades dt {
		color: var(--text-2);
		font-size: 0.8rem;
		font-weight: 700;
	}

	.stand-small .stand-grades dt {
		font-size: 0.7rem;
	}

	.stand-grades dd {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.35rem;
		line-height: 1;
		color: var(--text);
	}

	.stand-grades dd[data-g='A'] { color: var(--a1); }
	.stand-grades dd[data-g='?'] { color: var(--muted); }

	@media (max-width: 760px) {
		.stand-large {
			grid-template-columns: 1fr;
			gap: 20px;
		}
	}
</style>

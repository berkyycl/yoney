---
/** Model parametre kartı: altıgen tablo + eksen eksen LMArena puanı ve sıra */
import { AXES, fmtScore, standSvg, type StandCard } from '../lib/standChart';

interface Props {
	card: StandCard;
	size?: 'large' | 'small';
	rank?: number;
}
const { card, size = 'small', rank } = Astro.props;
const svg = standSvg([{ card, color: 'var(--a2)' }], { size: 300, title: `${card.name} parametreleri` });
---

<article class:list={['stand-card', `stand-${size}`, 'pose']}>
	<div class="stand-chart tilt">
		<span class="shine"></span>
		<Fragment set:html={svg} />
	</div>
	<div class="stand-info">
		<p class="stand-tag">{rank ? <span class="stand-rank">#{rank}</span> : null}{card.provider ?? 'Sağlayıcı bilinmiyor'}</p>
		<h3 class="stand-name">{card.name}</h3>
		<dl class="stand-scores">
			{AXES.map(ax => {
				const r = card.axes[ax.id];
				return (
					<div class:list={{ top: r.rank === 1, none: r.score == null }}>
						<dt>{ax.label}</dt>
						<dd>
							<strong>{fmtScore(r.score)}</strong>
							<small>{r.rank ? `${r.rank}. / ${r.total}` : 'veri yok'}</small>
						</dd>
					</div>
				);
			})}
		</dl>
	</div>
</article>

<style>
	.stand-card {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 10px;
		min-width: 0;
	}

	.stand-large {
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
		align-items: center;
		gap: 36px;
	}

	.stand-chart {
		position: relative;
		max-width: 420px;
		width: 100%;
		margin: 0 auto;
	}

	.stand-tag {
		display: flex;
		align-items: center;
		gap: 10px;
		margin: 0 0 6px;
		color: var(--muted);
		font-size: 0.72rem;
		font-weight: 800;
		font-stretch: 80%;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.stand-rank {
		color: var(--a2);
		font-family: var(--font-serif);
		font-size: 1.5rem;
		font-style: italic;
		font-weight: 900;
		letter-spacing: 0;
	}

	.stand-name {
		margin: 0 0 16px;
		font-size: 1.7rem;
		line-height: 0.98;
		text-transform: uppercase;
	}

	.stand-large .stand-name {
		font-size: clamp(2.4rem, 5vw, 4rem);
		transform: skewX(-6deg);
		transform-origin: left;
		text-shadow: 4px 4px 0 var(--a2);
	}

	/* Eksen eksen puan ve sıra */
	.stand-scores {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0 18px;
		margin: 0;
	}

	.stand-scores div {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
		padding: 7px 0;
		border-bottom: 1px solid var(--rule);
	}

	.stand-scores dt {
		color: var(--text-2);
		font-size: 0.8rem;
		font-weight: 700;
	}

	.stand-scores dd {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		margin: 0;
		line-height: 1.05;
	}

	.stand-scores strong {
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 400;
		color: var(--text);
		font-variant-numeric: tabular-nums;
	}

	.stand-scores small {
		color: var(--muted);
		font-size: 0.66rem;
		font-weight: 700;
	}

	.stand-scores .top strong {
		color: var(--a1);
	}

	.stand-scores .none strong {
		color: var(--muted);
	}

	.stand-small .stand-scores {
		grid-template-columns: 1fr 1fr 1fr;
		gap: 0 10px;
	}

	.stand-small .stand-scores dt {
		font-size: 0.68rem;
	}

	.stand-small .stand-scores strong {
		font-size: 1.05rem;
	}

	@media (max-width: 760px) {
		.stand-large {
			grid-template-columns: 1fr;
			gap: 20px;
		}
		.stand-small .stand-scores {
			grid-template-columns: 1fr 1fr;
		}
	}
</style>

---
/**
 * Görseli olmayan ya da yüklenemeyen haberler ve bölüm kapakları için bölüm
 * rengi ve deseniyle kapak afişi: soyut kompozisyon, amblem ve (verilirse)
 * dev harflerle bir etiket (haberin konu ettiği model ya da kaynak adı).
 * `seed` verilirse (ör. haberin adresi) dört kompozisyondan biri seçilir;
 * aynı bölümdeki görselsiz haberler birbirinin aynısı görünmez.
 */
import { getCategory } from '../lib/categories';

interface Props {
	cat: string;
	seed?: string;
	label?: string;
}
const category = getCategory(Astro.props.cat);
const { seed = '', label } = Astro.props;
let h = 0;
for (const ch of seed) h = (h * 31 + ch.charCodeAt(0)) >>> 0;
const v = seed ? h % 4 : 0;
---

<div class:list={['art', { labeled: !!label }]} data-cat={category.id} data-v={v} aria-hidden="true">
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={category.emblem} /></svg>
	{label && <span class="art-label">{label}</span>}
</div>

<style>
	/* 0: sağ üstte daire, çapraz şerit (varsayılan, global.css) */
	/* 1: sol altta daire, ters yönde şerit */
	.art[data-v='1'] {
		background:
			radial-gradient(circle at 22% 76%, var(--a3) 0 18%, transparent 18.4%),
			linear-gradient(62deg, transparent 0 40%, var(--c) 40% 62%, transparent 62%),
			var(--pat),
			var(--bg-2);
	}

	/* 2: ortada büyük daire, yatay bant */
	.art[data-v='2'] {
		background:
			linear-gradient(transparent 0 60%, var(--c) 60% 76%, transparent 76%),
			radial-gradient(circle at 50% 46%, var(--a1) 0 27%, transparent 27.4%),
			var(--pat),
			var(--bg-2);
	}

	.art[data-v='2'] svg {
		color: var(--on-a1);
		filter: none;
	}

	/* 3: dikey ikiye bölünmüş zemin, küçük daire */
	.art[data-v='3'] {
		background:
			radial-gradient(circle at 64% 30%, var(--a2) 0 10%, transparent 10.4%),
			linear-gradient(90deg, var(--bg-2) 0 46%, transparent 46%),
			var(--pat),
			var(--c);
	}

	/* Etiketli kapak: amblem köşeye çekilir, ad dev harflerle */
	.art.labeled {
		place-items: end start;
		padding: 7% 8%;
		container-type: inline-size;
	}

	.art.labeled svg {
		position: absolute;
		top: 9%;
		right: 8%;
		width: 20%;
		max-width: 72px;
	}

	.art-label {
		position: relative;
		max-width: 88%;
		color: #fff8ec;
		font-family: var(--font-display);
		font-size: clamp(1.1rem, 13cqi, 4.2rem);
		line-height: 0.92;
		letter-spacing: 0.01em;
		text-transform: uppercase;
		text-shadow: 3px 3px 0 #170f33, -1px -1px 0 #170f33, 1px -1px 0 #170f33, -1px 1px 0 #170f33;
		overflow-wrap: anywhere;
		transform: skewX(-6deg);
	}
</style>

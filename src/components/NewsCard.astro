---
import { NEWS_CATEGORIES, newsCategoryName } from '../lib/categories';
import { sourceLabel } from '../lib/articles';

interface Props {
	article: any;
	hidden?: boolean;
	featured?: boolean;
}
const { article: a, hidden = false, featured = false } = Astro.props;

const cat = NEWS_CATEGORIES.some(c => c.id === a.kategori) ? a.kategori : 'diger';
const day = new Date(a.date).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', timeZone: 'Europe/Istanbul' });
const scoreCount = a.benchmarklar?.length ?? 0;
---

<article class="news-card" data-category={cat} data-featured={featured ? '1' : undefined} hidden={hidden}>
	<div class:list={['card-media', { 'no-img': !a.gorsel_url }]} data-cat={cat}>
		{a.gorsel_url && (
			<img src={a.gorsel_url} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.parentElement.classList.add('no-img');this.remove()" />
		)}
	</div>
	<div class="card-body">
		<div class="card-meta">
			<span class="cat" data-cat={cat}>{newsCategoryName(cat)}</span>
			{scoreCount > 0 && <span class="score-flag" title="Haberde geçen benchmark skoru">{scoreCount} skor</span>}
		</div>
		<h3 class="card-title"><a href={`/haber/${a.slug}`}>{a.baslik_tr}</a></h3>
		<p class="card-summary">{a.ozet_tr}</p>
		<div class="card-foot">
			<span class="card-source" lang="en">{sourceLabel(a.source)}</span>
			<time datetime={a.date} data-rel>{day}</time>
		</div>
	</div>
</article>

<style>
	.news-card {
		position: relative;
		display: flex;
		flex-direction: column;
		overflow: hidden;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
	}

	.news-card:hover {
		transform: translateY(-3px);
		border-color: var(--border-strong);
		box-shadow: var(--shadow-md);
	}

	.card-media {
		position: relative;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: var(--surface-2);
	}

	.card-media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.45s ease;
	}

	.news-card:hover .card-media img {
		transform: scale(1.04);
	}

	/* Görseli olmayan ya da yüklenemeyen haber: kategori renginde zemin */
	.card-media.no-img {
		background:
			radial-gradient(90% 120% at 0% 0%, color-mix(in srgb, var(--c) 40%, transparent) 0%, transparent 65%),
			radial-gradient(80% 100% at 100% 100%, color-mix(in srgb, var(--accent-2) 22%, transparent) 0%, transparent 60%),
			var(--surface-2);
	}

	.card-body {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 16px 18px 18px;
	}

	.card-meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
	}

	.score-flag {
		padding: 2px 8px;
		border-radius: 999px;
		background: var(--accent-soft);
		color: var(--accent-text);
		font-size: 0.72rem;
		font-weight: 600;
		white-space: nowrap;
	}

	.card-title {
		margin: 0;
		font-size: 1.075rem;
		font-weight: 650;
		line-height: 1.35;
		letter-spacing: -0.015em;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.card-title a {
		color: var(--text);
		text-decoration: none;
	}

	/* Kartın tamamı tıklanabilir */
	.card-title a::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
	}

	.card-summary {
		margin: 0;
		color: var(--text-2);
		font-size: 0.925rem;
		line-height: 1.55;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.card-foot {
		display: flex;
		justify-content: space-between;
		gap: 12px;
		margin-top: auto;
		padding-top: 6px;
		color: var(--muted);
		font-size: 0.8rem;
	}

	.card-source {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.card-foot time {
		flex-shrink: 0;
	}
</style>

---
/**
 * Haber kutusu. Görünümler:
 *  card   kart (üstte poster görsel, başlık, özet, açılır "Özetle")
 *  big    büyük kart (ızgarada iki sütun)
 *  row    liste satırı (solda görsel)
 *  brief  kısa haber (görselsiz)
 *  mini   numaralı kısa liste öğesi
 * Görsel iki kat çizilir: üstteki kopya paletin renk alanlarına ayrılmış
 * posterdir; fare üstüne gelince alttaki gerçek renkli fotoğraf görünür.
 */
import Art from './Art.astro';
import { categoryOf, getCategory } from '../lib/categories';
import { sourceLabel } from '../lib/articles';

interface Props {
	article: any;
	variant?: 'card' | 'big' | 'row' | 'brief' | 'mini';
	hidden?: boolean;
	eager?: boolean;
	delay?: number;
}
const { article: a, variant = 'card', hidden = false, eager = false, delay } = Astro.props;

const cat = getCategory(categoryOf(a));
const day = new Date(a.date).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', timeZone: 'Europe/Istanbul' });
const href = `/haber/${a.slug}`;
const hasMedia = variant === 'card' || variant === 'big' || variant === 'row';
const hasSummary = variant === 'card' || variant === 'big' || variant === 'row';
const points: string[] = (a.onemli_maddeler ?? []).slice(0, 3);
const scoreCount = a.benchmarklar?.length ?? 0;
const onError = "this.parentElement.querySelectorAll('img').forEach(function(i){i.remove()})";
---

<article
	class:list={['story', `story-${variant}`, 'reveal-color', 'pose']}
	data-cat={cat.id}
	data-category={cat.id}
	hidden={hidden}
	style={delay ? `--delay:${delay}s` : undefined}
>
	{hasMedia && (
		<a class="story-media poster tilt" href={href} tabindex="-1" aria-hidden="true">
			<Art cat={cat.id} seed={a.slug} />
			{a.gorsel_url && (
				<>
					<img class="img-true" src={a.gorsel_url} alt="" loading={eager ? 'eager' : 'lazy'} decoding="async" referrerpolicy="no-referrer" onerror={onError} />
					<img class="img-poster" src={a.gorsel_url} alt="" loading={eager ? 'eager' : 'lazy'} decoding="async" referrerpolicy="no-referrer" />
				</>
			)}
			<span class="shine"></span>
		</a>
	)}
	<div class="story-body">
		{variant !== 'mini' && (
			<a class="chip" href={`/kategori/${cat.id}`} data-cat={cat.id}><span><span class="num">{cat.numeral}</span> {cat.name}</span></a>
		)}
		<h3 class="story-title"><a href={href}>{a.baslik_tr}</a></h3>
		{hasSummary && <p class="story-summary">{a.ozet_tr}</p>}
		{hasSummary && points.length > 0 && (
			<details class="story-points">
				<summary>Özetle <span>{points.length} madde</span></summary>
				<ol>
					{points.map(p => <li>{p}</li>)}
				</ol>
			</details>
		)}
		<p class="story-meta">
			<span lang="en">{sourceLabel(a.source)}</span>
			<span class="dot" aria-hidden="true">◆</span>
			<time datetime={a.date} data-rel>{day}</time>
			{scoreCount > 0 && variant !== 'mini' && (
				<>
					<span class="dot" aria-hidden="true">◆</span>
					<span class="score-note">{scoreCount} skor</span>
				</>
			)}
		</p>
	</div>
</article>

<style>
	.story {
		position: relative;
		min-width: 0;
	}

	/* ---- Görsel ---- */
	.story-media {
		aspect-ratio: 16 / 10;
		border: 2px solid var(--line);
		box-shadow: 8px 8px 0 var(--c);
	}

	.story:hover .story-media {
		box-shadow: 12px 12px 0 var(--c);
	}

	.story-body {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 10px;
		min-width: 0;
	}

	.story-title {
		margin: 0;
		font-size: 1.5rem;
		line-height: 1.04;
		letter-spacing: 0.005em;
	}

	.story-title a {
		color: var(--text);
		text-decoration: none;
		background-image: linear-gradient(var(--a1), var(--a1));
		background-size: 0 0.14em;
		background-position: 0 92%;
		background-repeat: no-repeat;
		transition: background-size 0.35s var(--ease-out);
	}

	.story-title a:hover,
	.story-title a:focus-visible {
		background-size: 100% 0.14em;
	}

	.story-summary {
		margin: 0;
		color: var(--text-2);
		font-size: 0.95rem;
		line-height: 1.55;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	/* ---- Açılır "Özetle" ---- */
	.story-points {
		width: 100%;
		border-top: 1px solid var(--rule);
	}

	.story-points summary {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 9px 0 2px;
		list-style: none;
		color: var(--text);
		font-size: 0.7rem;
		font-weight: 900;
		font-stretch: 80%;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		cursor: pointer;
	}

	.story-points summary::-webkit-details-marker {
		display: none;
	}

	.story-points summary::before {
		content: '';
		width: 0;
		height: 0;
		border-left: 7px solid var(--c);
		border-top: 5px solid transparent;
		border-bottom: 5px solid transparent;
		transition: transform 0.25s var(--ease-pose);
	}

	.story-points[open] summary::before {
		transform: rotate(90deg);
	}

	.story-points summary span {
		color: var(--muted);
		font-weight: 700;
	}

	.story-points ol {
		list-style: none;
		margin: 8px 0 4px;
		padding: 0;
		counter-reset: p;
		display: grid;
		gap: 8px;
	}

	.story-points li {
		counter-increment: p;
		display: grid;
		grid-template-columns: 1.6rem minmax(0, 1fr);
		color: var(--text-2);
		font-size: 0.88rem;
		line-height: 1.45;
	}

	.story-points li::before {
		content: counter(p);
		color: var(--c);
		font-family: var(--font-serif);
		font-size: 1.25rem;
		font-style: italic;
		font-weight: 900;
		line-height: 1;
	}

	.story-points[open] ol {
		animation: points-in 0.45s var(--ease-pose);
	}

	@keyframes points-in {
		from { opacity: 0; transform: translateY(-8px); }
	}

	.story-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 2px 8px;
		margin: 0;
		color: var(--muted);
		font-size: 0.72rem;
		font-weight: 700;
		font-stretch: 85%;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.story-meta .dot {
		color: var(--c);
		font-size: 0.6rem;
	}

	.score-note {
		color: var(--a1);
	}

	/* ---- Kart ---- */
	.story-card {
		display: flex;
		flex-direction: column;
		gap: 22px;
	}

	/* ---- Büyük kart ---- */
	.story-big {
		display: grid;
		grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
		gap: 30px;
		align-items: center;
	}

	.story-big .story-media {
		aspect-ratio: 4 / 3;
		box-shadow: 12px 12px 0 var(--c);
	}

	.story-big .story-title {
		font-size: clamp(1.9rem, 3vw, 2.6rem);
		line-height: 0.98;
		text-transform: uppercase;
	}

	.story-big .story-summary {
		font-size: 1.02rem;
		-webkit-line-clamp: 4;
	}

	/* ---- Liste satırı ---- */
	.story-row {
		display: grid;
		grid-template-columns: minmax(0, 36%) minmax(0, 1fr);
		gap: 26px;
		padding: 24px 0;
		border-bottom: 1px solid var(--rule);
	}

	.story-row .story-media {
		aspect-ratio: 4 / 3;
		box-shadow: 6px 6px 0 var(--c);
	}

	.story-row .story-title {
		font-size: 1.45rem;
	}

	/* ---- Kısa haber ---- */
	.story-brief .story-title {
		font-size: 1.2rem;
		line-height: 1.08;
	}

	/* ---- Numaralı kısa liste ---- */
	.story-mini .story-body {
		gap: 6px;
	}

	.story-mini .story-title {
		font-family: var(--font-sans);
		font-size: 1rem;
		font-weight: 800;
		line-height: 1.25;
		letter-spacing: 0;
	}

	@media (max-width: 760px) {
		.story-big {
			grid-template-columns: 1fr;
			gap: 22px;
		}
	}

	@media (max-width: 640px) {
		.story-row {
			grid-template-columns: minmax(0, 1fr) 108px;
			gap: 16px;
			padding: 20px 0;
		}
		.story-row .story-media {
			order: 2;
			aspect-ratio: 1;
			box-shadow: 4px 4px 0 var(--c);
		}
		.story-row .story-title {
			font-size: 1.2rem;
		}
		.story-row .story-summary,
		.story-row .story-points {
			display: none;
		}
		.story-media {
			box-shadow: 6px 6px 0 var(--c);
		}
		.story:hover .story-media {
			box-shadow: 6px 6px 0 var(--c);
		}
	}
</style>

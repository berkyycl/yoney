---
/**
 * Haber kutusu. Görünümler:
 *  lead   manşet (büyük görsel, büyük başlık, özet)
 *  second ikincil manşet (görsel + başlık)
 *  brief  kısa haber (yalnızca başlık)
 *  row    liste satırı (solda görsel, sağda başlık + özet)
 *  card   kart (üstte görsel)
 *  mini   numaralı kısa liste öğesi
 */
import Art from './Art.astro';
import { categoryOf, getCategory } from '../lib/categories';
import { sourceLabel } from '../lib/articles';

interface Props {
	article: any;
	variant?: 'lead' | 'second' | 'brief' | 'row' | 'card' | 'mini';
	hidden?: boolean;
	eager?: boolean;
}
const { article: a, variant = 'card', hidden = false, eager = false } = Astro.props;

const cat = getCategory(categoryOf(a));
const day = new Date(a.date).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', timeZone: 'Europe/Istanbul' });
const href = `/haber/${a.slug}`;
const hasMedia = variant !== 'brief' && variant !== 'mini';
const hasSummary = variant === 'lead' || variant === 'row' || variant === 'card';
const scoreCount = a.benchmarklar?.length ?? 0;
const Heading = variant === 'lead' ? 'h2' : 'h3';
---

<article class:list={['story', `story-${variant}`, 'reveal']} data-cat={cat.id} data-category={cat.id} hidden={hidden}>
	{hasMedia && (
		<a class="story-media frame" href={href} tabindex="-1" aria-hidden="true">
			<div class="media">
				<Art cat={cat.id} seed={a.slug} />
				{a.gorsel_url && (
					<img src={a.gorsel_url} alt="" loading={eager ? 'eager' : 'lazy'} decoding="async" referrerpolicy="no-referrer" onerror="this.remove()" />
				)}
			</div>
		</a>
	)}
	<div class="story-body">
		{variant !== 'mini' && <a class="kicker" href={`/kategori/${cat.id}`}>{cat.name}</a>}
		<Heading class="story-title"><a href={href}>{a.baslik_tr}</a></Heading>
		{hasSummary && <p class="story-summary">{a.ozet_tr}</p>}
		<p class="story-meta">
			<span lang="en">{sourceLabel(a.source)}</span>
			<span aria-hidden="true">·</span>
			<time datetime={a.date} data-rel>{day}</time>
			{scoreCount > 0 && variant !== 'mini' && (
				<>
					<span aria-hidden="true">·</span>
					<span class="score-note">{scoreCount} skor</span>
				</>
			)}
		</p>
	</div>
</article>

<style>
	.story {
		position: relative;
		min-width: 0;
	}

	.story-media {
		display: block;
	}

	.story-media .media {
		aspect-ratio: 16 / 10;
	}

	/* Görsel, soyut kompozisyonun üstünde durur; yüklenemezse kompozisyon görünür */
	.story-media img {
		position: relative;
	}

	.story-body {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 8px;
		min-width: 0;
	}

	.story-title {
		margin: 0;
		font-weight: 800;
		line-height: 1.12;
		letter-spacing: -0.012em;
	}

	.story-title a {
		color: var(--ink);
		text-decoration: none;
		background-image: linear-gradient(var(--c), var(--c));
		background-size: 0 3px;
		background-position: 0 100%;
		background-repeat: no-repeat;
		transition: background-size 0.3s ease;
	}

	.story-title a:hover,
	.story-title a:focus-visible {
		background-size: 100% 3px;
	}

	.story-summary {
		margin: 0;
		color: var(--ink-2);
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.story-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 2px 7px;
		margin: 0;
		color: var(--ink-3);
		font-size: 0.78rem;
		font-weight: 600;
	}

	.score-note {
		color: var(--ink);
	}

	/* ---- Manşet ---- */
	.story-lead .story-media .media {
		aspect-ratio: 3 / 2;
	}

	.story-lead .frame::before {
		inset: 14px -14px -14px 14px;
	}

	.story-lead .story-body {
		margin-top: 30px;
		gap: 12px;
	}

	.story-lead .story-title {
		font-size: clamp(2rem, 3.8vw, 3.3rem);
		font-weight: 900;
		line-height: 1.02;
		letter-spacing: -0.022em;
	}

	.story-lead .story-summary {
		font-size: 1.12rem;
		line-height: 1.6;
	}

	/* ---- İkincil manşet ---- */
	.story-second .story-media .media {
		aspect-ratio: 16 / 9;
	}

	.story-second .frame::before {
		inset: 8px -8px -8px 8px;
	}

	.story-second .story-body {
		margin-top: 20px;
	}

	.story-second .story-title {
		font-size: 1.4rem;
	}

	/* ---- Kısa haber ---- */
	.story-brief .story-title {
		font-size: 1.15rem;
		line-height: 1.18;
	}

	/* ---- Liste satırı ---- */
	.story-row {
		display: grid;
		grid-template-columns: minmax(0, 38%) minmax(0, 1fr);
		gap: 26px;
		padding: 26px 0;
		border-bottom: 1px solid var(--rule-strong);
	}

	.story-row:first-child {
		padding-top: 4px;
	}

	.story-row .story-media .media {
		aspect-ratio: 4 / 3;
	}

	.story-row .frame::before {
		inset: 7px -7px -7px 7px;
	}

	.story-row .story-title {
		font-size: 1.5rem;
	}

	.story-row .story-summary {
		font-size: 0.97rem;
		-webkit-line-clamp: 3;
	}

	/* ---- Kart ---- */
	.story-card .story-media .media {
		aspect-ratio: 16 / 10;
	}

	.story-card .frame::before {
		inset: 8px -8px -8px 8px;
	}

	.story-card .story-body {
		margin-top: 20px;
	}

	.story-card .story-title {
		font-size: 1.3rem;
	}

	.story-card .story-summary {
		font-size: 0.93rem;
		-webkit-line-clamp: 2;
	}

	/* ---- Numaralı kısa liste ---- */
	.story-mini .story-title {
		font-size: 1.02rem;
		line-height: 1.22;
	}

	.story-mini .story-body {
		gap: 5px;
	}

	@media (max-width: 640px) {
		.story-row {
			grid-template-columns: minmax(0, 1fr) 104px;
			gap: 16px;
			padding: 20px 0;
		}
		.story-row .story-media {
			order: 2;
		}
		.story-row .story-media .media {
			aspect-ratio: 1;
		}
		.story-row .frame::before {
			inset: 5px -5px -5px 5px;
		}
		.story-row .story-title {
			font-size: 1.15rem;
		}
		.story-row .story-summary {
			display: none;
		}
		.story-lead .story-body {
			margin-top: 24px;
		}
	}
</style>

---
/**
 * Kapak bandı: düz ve keskin renk alanlarından oluşan ressamvari bir kompozisyon
 * (mor zemin, altın güneş, pembe ve turkuaz çapraz alanlar). Renkler temadan
 * bağımsızdır; üstündeki yazı her zaman krem renktir.
 */
interface Props {
	height?: number;
}
const { height = 150 } = Astro.props;
---

<div class="art-banner" style={`--h:${height}px`}>
	<svg class="art-svg" viewBox="0 0 1200 200" preserveAspectRatio="xMinYMid slice" aria-hidden="true" focusable="false">
		<rect width="1200" height="200" fill="#4a1f78" />
		<polygon points="0,0 70,0 30,200 0,200" fill="#00a39a" />
		<polygon points="70,0 96,0 56,200 30,200" fill="#b6e34a" />
		<polygon points="700,0 905,0 765,200 560,200" fill="#ff2e7e" />
		<polygon points="905,0 930,0 790,200 765,200" fill="#19121f" opacity="0.35" />
		<circle cx="1070" cy="52" r="104" fill="#ffc21a" />
		<g stroke="#f5eedf" stroke-width="2" opacity="0.6">
			<line x1="1070" y1="52" x2="1200" y2="-40" />
			<line x1="1070" y1="52" x2="1200" y2="20" />
			<line x1="1070" y1="52" x2="1200" y2="84" />
			<line x1="1070" y1="52" x2="1200" y2="150" />
		</g>
		<circle cx="1070" cy="52" r="104" fill="none" stroke="#19121f" stroke-width="3" />
		<circle cx="430" cy="-6" r="58" fill="#ffc21a" />
		<circle cx="430" cy="-6" r="58" fill="none" stroke="#19121f" stroke-width="3" />
		<circle cx="612" cy="44" r="26" fill="#ff6a3d" />
		<circle cx="612" cy="44" r="26" fill="none" stroke="#19121f" stroke-width="3" />
		<polygon points="930,200 1200,150 1200,200" fill="#49b6ff" />
		<line x1="0" y1="197" x2="1200" y2="197" stroke="#19121f" stroke-width="6" />
	</svg>
	<div class="art-content">
		<slot />
	</div>
</div>

<style>
	.art-banner {
		position: relative;
		min-height: var(--h);
		overflow: hidden;
		border: 2px solid var(--line);
		background: #4a1f78;
		color: #fff8ec;
	}

	.art-svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.art-content {
		position: relative;
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 12px 32px;
		min-height: var(--h);
		padding: 22px 28px 22px clamp(28px, 8%, 104px);
		text-shadow: 0 1px 12px rgba(25, 18, 31, 0.45);
	}

	@media (max-width: 640px) {
		.art-content {
			padding: 18px 18px 18px 54px;
		}
	}
</style>

---
/** Bölüm (kategori) kapağı: desenli renk zemini, Roma rakamı, amblem, ad, slogan ve son başlıklar */
import type { NewsCategory } from '../lib/categories';

interface Props {
	category: NewsCategory;
	count: number;
	headlines?: { title: string; slug: string }[];
	size?: 'small' | 'large';
	delay?: number;
}
const { category: c, count, headlines = [], size = 'small', delay } = Astro.props;
---

<article class:list={['chapter', `chapter-${size}`, 'pose']} data-cat={c.id} style={delay ? `--delay:${delay}s` : undefined}>
	<a class="chapter-cover tilt" href={`/kategori/${c.id}`} aria-label={`${c.name} bölümü`}>
		<span class="shine"></span>
		<span class="chapter-num" aria-hidden="true">{c.numeral}</span>
		<svg class="chapter-emblem" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={c.emblem} /></svg>
		<span class="chapter-name">{c.name}</span>
		<span class="chapter-tag">{c.tagline}</span>
		<span class="chapter-count">{count} haber →</span>
	</a>
	{headlines.length > 0 && (
		<ul class="chapter-heads">
			{headlines.map(h => <li><a href={`/haber/${h.slug}`}>{h.title}</a></li>)}
		</ul>
	)}
</article>

<style>
	.chapter {
		display: flex;
		flex-direction: column;
		gap: 18px;
		min-width: 0;
	}

	.chapter-cover {
		position: relative;
		display: grid;
		grid-template-columns: 1fr auto;
		grid-template-rows: auto 1fr auto auto;
		gap: 4px 12px;
		min-height: 250px;
		padding: 18px 20px 20px;
		overflow: hidden;
		background: var(--pat), var(--c);
		color: var(--c-on);
		border: 2px solid var(--line);
		box-shadow: 8px 8px 0 var(--shadow);
		text-decoration: none;
	}

	.chapter-large .chapter-cover {
		min-height: 330px;
		padding: 24px 28px 26px;
	}

	.chapter-num {
		grid-column: 1;
		grid-row: 1;
		font-family: var(--font-serif);
		font-size: 3.4rem;
		font-style: italic;
		font-weight: 900;
		line-height: 0.85;
	}

	.chapter-large .chapter-num {
		font-size: 5rem;
	}

	.chapter-emblem {
		grid-column: 2;
		grid-row: 1 / 3;
		width: 70px;
		height: 70px;
		transition: transform 0.6s var(--ease-pose);
	}

	.chapter-large .chapter-emblem {
		width: 104px;
		height: 104px;
	}

	.chapter-cover:hover .chapter-emblem {
		transform: rotate(-14deg) scale(1.15);
	}

	.chapter-name {
		grid-column: 1 / -1;
		grid-row: 3;
		font-family: var(--font-display);
		font-size: 2rem;
		line-height: 0.95;
		text-transform: uppercase;
	}

	.chapter-large .chapter-name {
		font-size: clamp(2.4rem, 4vw, 3.2rem);
	}

	.chapter-tag {
		grid-column: 1 / -1;
		grid-row: 4;
		font-family: var(--font-serif);
		font-size: 1.05rem;
		font-style: italic;
		font-weight: 600;
		line-height: 1.3;
	}

	.chapter-count {
		position: absolute;
		right: 16px;
		bottom: 14px;
		font-size: 0.68rem;
		font-weight: 900;
		font-stretch: 80%;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		opacity: 0;
		transform: translateX(-10px);
		transition: opacity 0.25s ease, transform 0.35s var(--ease-pose);
	}

	.chapter-cover:hover .chapter-count {
		opacity: 1;
		transform: none;
	}

	.chapter-heads {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.chapter-heads li {
		padding: 10px 0;
		border-bottom: 1px solid var(--rule);
		line-height: 1.3;
	}

	.chapter-heads li::before {
		content: '◆';
		margin-right: 8px;
		color: var(--c);
		font-size: 0.7rem;
	}

	.chapter-heads a {
		color: var(--text);
		text-decoration: none;
		font-weight: 700;
	}

	.chapter-heads a:hover {
		color: var(--a1);
	}
</style>

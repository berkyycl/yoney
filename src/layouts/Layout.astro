---
import '../styles/global.css';
import BrandMark from '../components/BrandMark.astro';

interface Props {
	title: string;
	description?: string;
	image?: string;
	type?: string;
	articleDate?: string;
	canonicalUrl?: string;
}

const {
	title,
	description = "Yöney: Türkiye'nin yapay zekâ haber, model çıkışları ve doğrulanmış benchmark takip platformu.",
	image = "/og-default.png",
	type = "website",
	articleDate,
	canonicalUrl
} = Astro.props;

const canonical = canonicalUrl || Astro.url.href;
// Sosyal medya önizlemeleri göreli adresleri çözemez; görsel her zaman tam adres olmalı
let ogImage = new URL('/og-default.png', Astro.site ?? Astro.url).href;
try {
	if (image) ogImage = new URL(image, Astro.site ?? Astro.url).href;
} catch {
	// Bozuk görsel adresi derlemeyi durdurmasın; varsayılan görsel kalır
}

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const NAV = [
	{ href: '/', label: 'Haberler', active: path === '/' || path.startsWith('/haber') },
	{ href: '/benchmarklar', label: 'Benchmarklar', active: path.startsWith('/benchmarklar') },
	{ href: '/karsilastir', label: 'Karşılaştır', active: path.startsWith('/karsilastir') },
	{ href: '/ne-degisti', label: 'Ne Değişti', active: path.startsWith('/ne-degisti') },
];

// Site 3 saatte bir yeniden derlenir; derleme sunucusu UTC'de çalıştığı için saat dilimi açıkça verilir
const updated = new Date().toLocaleString('tr-TR', {
	timeZone: 'Europe/Istanbul', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit'
});
---

<!doctype html>
<html lang="tr">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#f6f6f8" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0a0a0d" media="(prefers-color-scheme: dark)" />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{ogImage && <meta property="og:image" content={ogImage} />}
		<meta property="og:locale" content="tr_TR" />
		<meta property="og:site_name" content="Yöney" />

		<!-- Twitter Cards -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonical} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{ogImage && <meta name="twitter:image" content={ogImage} />}

		{articleDate && <meta property="article:published_time" content={articleDate} />}

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400..700&family=Geist+Mono:wght@400..600&display=swap" rel="stylesheet">

		<!-- Kayıtlı tema seçimini sayfa çizilmeden uygula (beyaz/siyah yanıp sönmesin) -->
		<script is:inline>
			try {
				var t = localStorage.getItem('yoney-tema');
				if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
			} catch (e) {}
		</script>
	</head>
	<body>
		<header class="site-header">
			<div class="container header-inner">
				<a href="/" class="brand" aria-label="Yöney ana sayfa">
					<span class="brand-mark"><BrandMark id="ym-head" /></span>
					<span>yöney</span>
				</a>
				<nav class="nav" id="mainNav" aria-label="Ana menü">
					{NAV.map(n => (
						<a href={n.href} class:list={['nav-link', { active: n.active }]} aria-current={n.active ? 'page' : undefined}>{n.label}</a>
					))}
				</nav>
				<div class="header-actions">
					<button class="icon-btn theme-toggle" id="themeToggle" type="button" aria-label="Açık/koyu temayı değiştir" title="Tema">
						<svg class="i-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
						<svg class="i-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
					</button>
					<button class="icon-btn menu-toggle" id="menuToggle" type="button" aria-label="Menü" aria-expanded="false" aria-controls="mainNav">
						<svg class="i-menu" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
						<svg class="i-close" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
					</button>
				</div>
			</div>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="container footer-inner">
				<div class="footer-brand">
					<a href="/" class="brand" aria-label="Yöney ana sayfa">
						<span class="brand-mark"><BrandMark id="ym-foot" size={26} /></span>
						<span>yöney</span>
					</a>
					<p>Yapay zekâ haberleri ve doğrulanmış benchmark skorları. Türkçe, otomatik, her 3 saatte bir güncel.</p>
				</div>
				<div class="footer-col">
					<h2>Keşfet</h2>
					<ul>
						<li><a href="/">Haberler</a></li>
						<li><a href="/benchmarklar">Benchmarklar</a></li>
						<li><a href="/karsilastir">Karşılaştır</a></li>
						<li><a href="/ne-degisti">Ne Değişti</a></li>
					</ul>
				</div>
				<div class="footer-col">
					<h2>Yöney</h2>
					<ul>
						<li><a href="/kaynaklar">Kaynaklar</a></li>
						<li><a href="/hakkinda">Hakkında</a></li>
						<li><a href="/sitemap.xml">Site haritası</a></li>
					</ul>
				</div>
			</div>
			<div class="container footer-bottom">
				<p>Özetler ve yorumlar yapay zekâ ile üretilir; her zaman orijinal kaynağı kontrol edin.</p>
				<p>Son güncelleme: {updated}</p>
			</div>
		</footer>
	</body>
</html>

<script>
	// Tema düğmesi
	const root = document.documentElement;
	const current = () => root.dataset.theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
	document.getElementById('themeToggle')?.addEventListener('click', () => {
		const next = current() === 'dark' ? 'light' : 'dark';
		root.dataset.theme = next;
		try { localStorage.setItem('yoney-tema', next); } catch {}
	});

	// Mobil menü
	const header = document.querySelector('.site-header');
	const menuBtn = document.getElementById('menuToggle');
	menuBtn?.addEventListener('click', () => {
		const open = header?.classList.toggle('menu-open') ?? false;
		menuBtn.setAttribute('aria-expanded', String(open));
	});

	// "3 saat önce" gibi göreli tarihler (sunucudaki mutlak tarih yedek olarak kalır)
	for (const t of document.querySelectorAll<HTMLTimeElement>('time[data-rel]')) {
		const ms = Date.now() - new Date(t.dateTime).getTime();
		if (!Number.isFinite(ms) || ms < 0) continue;
		const min = ms / 60000;
		let txt = '';
		if (min < 60) txt = `${Math.max(1, Math.round(min))} dk önce`;
		else if (min < 1440) txt = `${Math.floor(min / 60)} saat önce`;
		else if (min < 2880) txt = 'dün';
		else if (min < 10080) txt = `${Math.floor(min / 1440)} gün önce`;
		if (txt) {
			t.title = t.textContent?.trim() ?? '';
			t.textContent = txt;
		}
	}
</script>

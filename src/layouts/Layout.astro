---
import '../styles/global.css';
import { NEWS_CATEGORIES } from '../lib/categories';
import { PALETTE_BG, type Palette } from '../lib/palettes';

interface Props {
	title: string;
	description?: string;
	image?: string;
	type?: string;
	articleDate?: string;
	canonicalUrl?: string;
	/** Bölümün sabit renk paleti (src/lib/palettes.ts) */
	palette?: Palette;
	/** Geniş düzen: ana sayfadaki iki yan sütun için */
	wide?: boolean;
}

const {
	title,
	description = "Yöney: Türkiye'nin yapay zekâ haber, model çıkışları ve doğrulanmış benchmark takip platformu.",
	image = "/og-default.png",
	type = "website",
	articleDate,
	canonicalUrl,
	palette = 'altin',
	wide = false
} = Astro.props;

const canonical = canonicalUrl || Astro.url.href;
// Sosyal medya önizlemeleri göreli adresleri çözemez; görsel her zaman tam adres olmalı
let ogImage = new URL('/og-default.png', Astro.site ?? Astro.url).href;
try {
	if (image) ogImage = new URL(image, Astro.site ?? Astro.url).href;
} catch {
	// Bozuk görsel adresi derlemeyi durdurmasın; varsayılan görsel kalır
}

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const NAV = [
	{ href: '/', label: 'Haberler', active: path === '/' || path.startsWith('/haber') },
	{ href: '/kategori', label: 'Bölümler', active: path.startsWith('/kategori') },
	{ href: '/benchmarklar', label: 'Benchmark', active: path.startsWith('/benchmarklar') },
	{ href: '/karsilastir', label: 'Karşılaştır', active: path.startsWith('/karsilastir') },
	{ href: '/ne-degisti', label: 'Ne Değişti', active: path.startsWith('/ne-degisti') },
];

// Site 3 saatte bir yeniden derlenir; derleme sunucusu UTC'de çalıştığı için saat dilimi açıkça verilir
const TZ = 'Europe/Istanbul';
const now = new Date();
const dateLine = now.toLocaleDateString('tr-TR', { timeZone: TZ, weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
const updated = now.toLocaleString('tr-TR', { timeZone: TZ, day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' });
// Günlük gazete gibi sayı numarası: yılın kaçıncı günü
const [y, m, d] = now.toLocaleDateString('en-CA', { timeZone: TZ }).split('-').map(Number);
const issue = Math.round((Date.UTC(y, m - 1, d) - Date.UTC(y, 0, 0)) / 864e5);

---

<!doctype html>
<html lang="tr" data-palette={palette}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content={PALETTE_BG[palette]} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{ogImage && <meta property="og:image" content={ogImage} />}
		<meta property="og:locale" content="tr_TR" />
		<meta property="og:site_name" content="Yöney" />

		<!-- Twitter Cards -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonical} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{ogImage && <meta name="twitter:image" content={ogImage} />}

		{articleDate && <meta property="article:published_time" content={articleDate} />}

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Anton&family=Archivo:wdth,wght@62..125,400..900&family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&display=swap" rel="stylesheet">

		<!--
			Renk kayması: palet sayfanın bölümüne göre sabittir (html[data-palette]).
			Başka bir bölüme geçerken yeni palet, önceki sayfada tıklanan noktadan
			dairesel bir dalga olarak yayılır.
		-->
		<script is:inline>
			(function () {
				var d = document.documentElement;
				d.classList.add('js');
				try {
					var xy = (sessionStorage.getItem('yoney-dalga') || '').split(',');
					if (xy.length === 2) {
						d.style.setProperty('--fx', xy[0] + 'px');
						d.style.setProperty('--fy', xy[1] + 'px');
					}
					sessionStorage.removeItem('yoney-dalga');
				} catch (e) {}
			})();
		</script>
	</head>
	<body>
		<svg class="sr-only" aria-hidden="true" focusable="false">
			<defs>
				<!-- Manşet görselinin etrafındaki dalgalı aura -->
				<filter id="aura" x="-25%" y="-25%" width="150%" height="150%">
					<feTurbulence type="fractalNoise" baseFrequency="0.011 0.028" numOctaves="2" seed="4" result="noise">
						<animate attributeName="baseFrequency" dur="11s" values="0.011 0.028;0.018 0.045;0.011 0.028" repeatCount="indefinite" />
					</feTurbulence>
					<feDisplacementMap in="SourceGraphic" in2="noise" scale="34" xChannelSelector="R" yChannelSelector="G" />
				</filter>
			</defs>
		</svg>

		<div class="backdrop" aria-hidden="true">
			<svg viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice">
				<circle class="b1 drift-a" cx="1390" cy="150" r="250" />
				<circle class="bl spin" cx="1390" cy="150" r="330" stroke-dasharray="4 22" />
				<polygon class="b2 drift-b" points="0,600 560,360 820,1000 0,1000" />
				<polygon class="b3 drift-a" points="880,1000 1600,560 1600,720 1060,1000" />
				<circle class="b4 drift-b" cx="250" cy="210" r="86" />
				<path class="b1 drift-b" d="M760 120l14 40 40 14-40 14-14 40-14-40-40-14 40-14z" />
				<path class="b3 drift-a" d="M1180 760l10 28 28 10-28 10-10 28-10-28-28-10 28-10z" />
				<path class="b2 drift-a" d="M120 470l8 22 22 8-22 8-8 22-8-22-22-8 22-8z" />
			</svg>
		</div>

		<div class="topline">
			<div class="container">
				<span class="hide-sm">{dateLine}</span>
				<span class="issue">Sayı № {issue}</span>
				<span class="live clock-wrap" title="İstanbul saati"><time class="clock" id="clock">{now.toLocaleTimeString('tr-TR', { timeZone: TZ, hour: '2-digit', minute: '2-digit' })}</time></span>
			</div>
		</div>

		<header class="site-header">
			<div class="container header-inner">
				<a href="/" class="logo" aria-label="Yöney ana sayfa">
					<span class="logo-word" aria-hidden="true"><span>Y</span><span class="o">Ö</span><span>N</span><span>E</span><span>Y</span></span>
					<svg class="logo-arrow" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" aria-hidden="true"><path d="M5 19 19 5M9 5h10v10" /></svg>
				</a>
				<nav class="nav" id="mainNav" aria-label="Ana menü">
					{NAV.map(n => (
						<a href={n.href} class:list={['nav-link', { active: n.active }]} aria-current={n.active ? 'page' : undefined}>{n.label}</a>
					))}
				</nav>
				<div class="header-actions">
					<button class="icon-btn menu-toggle" id="menuToggle" type="button" aria-label="Menü" aria-expanded="false" aria-controls="mainNav">
						<svg class="i-menu" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="square" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
						<svg class="i-close" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="square" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
					</button>
				</div>
			</div>
		</header>

		<main class:list={{ wide }}>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="container">
				<p class="footer-word" aria-hidden="true"><span>Y</span><span class="o">Ö</span><span>N</span><span>E</span><span>Y</span></p>
				<div class="footer-inner">
					<div class="footer-about">
						<p class="footer-motto">Yapay zekânın tuhaf ve harika dünyası, her gün Türkçe.</p>
						<p>Resmi duyurular, bağımsız basın ve topluluktan derlenen haberler; doğrulanmış benchmark skorları. Her şey otomatik, 3 saatte bir güncel.</p>
					</div>
					<div class="footer-col">
						<h2>Bölümler</h2>
						<ul>
							{NEWS_CATEGORIES.map(c => <li><a href={`/kategori/${c.id}`}>{c.name}</a></li>)}
						</ul>
					</div>
					<div class="footer-col">
						<h2>Keşfet</h2>
						<ul>
							<li><a href="/">Haberler</a></li>
							<li><a href="/benchmarklar">Benchmark</a></li>
							<li><a href="/karsilastir">Karşılaştır</a></li>
							<li><a href="/ne-degisti">Ne Değişti</a></li>
						</ul>
					</div>
					<div class="footer-col">
						<h2>Yöney</h2>
						<ul>
							<li><a href="/kaynaklar">Kaynaklar</a></li>
							<li><a href="/hakkinda">Hakkında</a></li>
							<li><a href="/sitemap.xml">Site haritası</a></li>
						</ul>
					</div>
				</div>
				<div class="footer-bottom">
					<p>Özetler ve yorumlar yapay zekâ ile üretilir; her zaman orijinal kaynağı kontrol edin.</p>
					<p>Son baskı: {updated}</p>
				</div>
			</div>
		</footer>
	</body>
</html>

<script>
	import '../scripts/fx';
</script>

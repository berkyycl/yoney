---
import Layout from '../layouts/Layout.astro';
import ArtBanner from '../components/ArtBanner.astro';
import Story from '../components/Story.astro';
import ChapterTile from '../components/ChapterTile.astro';
import { loadArticles } from '../lib/articles';
import { loadBenchmarkData } from '../lib/benchmarks';
import { NEWS_CATEGORIES, categoryOf } from '../lib/categories';

const PAGE = 10;
const articles = loadArticles();
const time = (a: any) => new Date(a.date).getTime();

// Ön sayfa resmi kaynaklar ve bağımsız basından kurulur; topluluk (Reddit) yan sütunda
const editorialAll = articles.filter(a => a.sourceTier !== 'topluluk');
const editorial = editorialAll.length > 0 ? editorialAll : articles;
const community = articles.filter(a => a.sourceTier === 'topluluk');

// Manşet adayları: son 3 günün görselli haberleri, önce önem sonra tarih
const newest = editorial.length ? time(editorial[0]) : 0;
const ranked = editorial
	.filter(a => a.gorsel_url && newest - time(a) < 3 * 864e5)
	.sort((a, b) => (b.onem ?? 0) - (a.onem ?? 0) || time(b) - time(a));

const used = new Set<string>();
const take = (list: any[], n: number) => {
	const out: any[] = [];
	for (const a of list) {
		if (out.length >= n) break;
		if (used.has(a.slug)) continue;
		used.add(a.slug);
		out.push(a);
	}
	return out;
};
const [lead] = take([...ranked, ...editorial], 1);
const seconds = take([...ranked, ...editorial.filter(a => a.gorsel_url)], 2);
const briefs = take(editorial, 4);
const feed = editorial.filter(a => !used.has(a.slug));
const rail = community.slice(0, 7);

// Arena'da zirve: LMArena genel sıralamasında her modelin en iyi sonucu
const bench = loadBenchmarkData();
const arena: { model: string; provider: string | null; score: number }[] = [];
const seenModels = new Set<string>();
for (const e of bench.entries.filter(e => e.bench === 'lmarena-text').sort((a, b) => b.score - a.score)) {
	if (seenModels.has(e.key)) continue;
	seenModels.add(e.key);
	arena.push({ model: e.model, provider: e.provider, score: e.score });
	if (arena.length === 5) break;
}

const chapters = NEWS_CATEGORIES.map(c => ({ c, count: articles.filter(a => categoryOf(a) === c.id).length }));
const sourceCount = new Set(articles.map(a => a.source)).size;
const today = new Date().toLocaleDateString('tr-TR', { timeZone: 'Europe/Istanbul', weekday: 'long', day: 'numeric', month: 'long' });
---

<Layout title="Yöney: Türkiye'nin yapay zekâ haber ve benchmark takibi">
	<ArtBanner height={160}>
		<div class="banner-text">
			<p class="banner-date">{today}</p>
			<h1 class="banner-title">Yapay zekâ gündemi</h1>
		</div>
		<dl class="banner-stats">
			<div><dt>haber</dt><dd>{articles.length}</dd></div>
			<div><dt>kaynak</dt><dd>{sourceCount}</dd></div>
			<div><dt>sıralama</dt><dd>{bench.benchmarks.length}</dd></div>
		</dl>
	</ArtBanner>

	{!lead ? (
		<p class="empty">Henüz haber bulunmuyor. Otomatik güncelleme ilk turunu tamamladığında son bir ayın haberleri burada listelenecek.</p>
	) : (
		<>
			<section class="front" aria-label="Manşet">
				<div class="front-lead">
					<Story article={lead} variant="lead" eager />
				</div>
				{seconds.length > 0 && (
					<div class="front-side">
						{seconds.map(a => <Story article={a} variant="second" />)}
					</div>
				)}
			</section>

			{briefs.length > 0 && (
				<section class="briefs" aria-label="Kısa haberler">
					{briefs.map(a => <Story article={a} variant="brief" />)}
				</section>
			)}

			<div class="split">
				<section class="feed" aria-labelledby="feedTitle">
					<div class="section-head">
						<span class="sec-num">01</span>
						<h2 id="feedTitle">Son haberler</h2>
						<a class="sec-more" href="/kategori">Bölümler →</a>
					</div>
					<div class="feed-list" id="feed" data-paged={PAGE}>
						{feed.map((a, i) => <Story article={a} variant="row" hidden={i >= PAGE} />)}
					</div>
					<div class="feed-foot">
						<button class="btn" type="button" data-more="feed" hidden={feed.length <= PAGE}>Daha fazla haber</button>
						<p class="muted" data-count="feed">{Math.min(PAGE, feed.length)} / {feed.length} haber</p>
					</div>
				</section>

				<aside class="rail">
					{arena.length > 0 && (
						<section class="rail-box">
							<div class="section-head">
								<span class="sec-num">02</span>
								<h2>Arena'da zirve</h2>
							</div>
							<ol class="arena">
								{arena.map((r, i) => (
									<li>
										<span class="arena-rank">{i + 1}</span>
										<span class="arena-name"><strong>{r.model}</strong>{r.provider && <small>{r.provider}</small>}</span>
										<span class="arena-score">{r.score.toLocaleString('tr-TR')}</span>
									</li>
								))}
							</ol>
							<p class="rail-note">LMArena genel sıralaması, kullanıcı oylarıyla (ELO). <a href="/benchmarklar">Tüm sıralamalar →</a></p>
						</section>
					)}

					{rail.length > 0 && (
						<section class="rail-box">
							<div class="section-head">
								<span class="sec-num">03</span>
								<h2>Topluluktan</h2>
							</div>
							<ol class="numbered">
								{rail.map(a => <li><Story article={a} variant="mini" /></li>)}
							</ol>
						</section>
					)}
				</aside>
			</div>

			<section class="chapters" aria-labelledby="chaptersTitle">
				<div class="section-head">
					<span class="sec-num">04</span>
					<h2 id="chaptersTitle">Bölümler</h2>
					<a class="sec-more" href="/kategori">Tümü →</a>
				</div>
				<div class="chapters-grid">
					{chapters.map(({ c, count }) => <ChapterTile category={c} count={count} />)}
				</div>
			</section>
		</>
	)}
</Layout>

<script>
	import '../scripts/paged';
</script>

<style>
	/* ---------- Kapak bandı ---------- */
	:global(.art-banner) {
		margin-bottom: 40px;
	}

	.banner-date {
		margin: 0 0 6px;
		font-size: 0.72rem;
		font-weight: 800;
		font-stretch: 82%;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.banner-title {
		margin: 0;
		color: #fff8ec;
		font-size: clamp(2.3rem, 5.4vw, 4rem);
		font-style: italic;
		font-weight: 800;
		line-height: 0.95;
		letter-spacing: -0.02em;
	}

	.banner-stats {
		display: flex;
		gap: 10px;
		margin: 0;
	}

	/* Sayılar, arkadaki renk alanından bağımsız okunabilsin diye krem kutucuklarda */
	.banner-stats div {
		display: flex;
		flex-direction: column-reverse;
		align-items: flex-start;
		min-width: 74px;
		padding: 6px 10px 7px;
		background: #fff8ec;
		color: #19121f;
		border: 2px solid #19121f;
		text-shadow: none;
	}

	.banner-stats dt {
		font-size: 0.68rem;
		font-weight: 800;
		font-stretch: 82%;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.banner-stats dd {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.9rem;
		font-weight: 900;
		line-height: 1;
	}

	/* ---------- Ön sayfa ---------- */
	.front {
		display: grid;
		grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
		gap: 48px;
		padding-bottom: 40px;
	}

	.front-side {
		display: flex;
		flex-direction: column;
		gap: 40px;
		padding-left: 40px;
		border-left: 1px solid var(--rule-strong);
	}

	.briefs {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		margin-bottom: 56px;
		border-top: 2px solid var(--line);
		border-bottom: 2px solid var(--line);
	}

	.briefs > :global(.story) {
		padding: 22px 22px 24px;
		border-left: 1px solid var(--rule-strong);
	}

	.briefs > :global(.story:first-child) {
		padding-left: 0;
		border-left: 0;
	}

	.briefs > :global(.story:last-child) {
		padding-right: 0;
	}

	/* ---------- Akış + yan sütun ---------- */
	.split {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 340px;
		gap: 56px;
		margin-bottom: 64px;
	}

	.feed-foot {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 10px;
		margin-top: 32px;
	}

	.feed-foot p {
		margin: 0;
		font-size: 0.85rem;
	}

	.rail {
		display: flex;
		flex-direction: column;
		gap: 48px;
	}

	.rail .section-head h2 {
		font-size: 1.45rem;
	}

	.arena {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.arena li {
		display: grid;
		grid-template-columns: 2rem minmax(0, 1fr) auto;
		align-items: center;
		gap: 10px;
		padding: 11px 0;
		border-bottom: 1px solid var(--rule);
	}

	.arena-rank {
		font-family: var(--font-display);
		font-style: italic;
		font-weight: 900;
		font-size: 1.6rem;
		line-height: 1;
		color: var(--ink-3);
	}

	.arena li:first-child .arena-rank {
		color: var(--magenta);
	}

	.arena-name {
		display: flex;
		flex-direction: column;
		min-width: 0;
		line-height: 1.25;
	}

	.arena-name strong {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.arena-name small {
		color: var(--ink-3);
		font-size: 0.75rem;
	}

	.arena-score {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 1.15rem;
		font-variant-numeric: tabular-nums;
	}

	.rail-note {
		margin: 12px 0 0;
		color: var(--ink-3);
		font-size: 0.82rem;
	}

	.numbered {
		list-style: none;
		margin: 0;
		padding: 0;
		counter-reset: n;
	}

	.numbered > li {
		counter-increment: n;
		display: grid;
		grid-template-columns: 2.4rem minmax(0, 1fr);
		gap: 6px;
		padding: 14px 0;
		border-bottom: 1px solid var(--rule);
	}

	.numbered > li::before {
		content: counter(n, decimal-leading-zero);
		font-family: var(--font-display);
		font-style: italic;
		font-weight: 900;
		font-size: 1.45rem;
		line-height: 1;
		color: var(--teal);
	}

	/* ---------- Bölümler ---------- */
	.chapters-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 24px;
	}

	@media (max-width: 1080px) {
		.split {
			grid-template-columns: 1fr;
		}
		.rail {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 40px;
		}
	}

	@media (max-width: 900px) {
		.front {
			grid-template-columns: 1fr;
			gap: 36px;
		}
		.front-side {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 28px;
			padding: 32px 0 0;
			border-left: 0;
			border-top: 1px solid var(--rule-strong);
		}
		.briefs {
			grid-template-columns: 1fr 1fr;
		}
		.briefs > :global(.story:nth-child(odd)) {
			padding-left: 0;
			border-left: 0;
		}
		.briefs > :global(.story:nth-child(n + 3)) {
			border-top: 1px solid var(--rule-strong);
		}
		.chapters-grid {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (max-width: 640px) {
		.banner-stats div {
			min-width: 0;
			padding: 4px 8px 5px;
		}
		.banner-stats dd {
			font-size: 1.5rem;
		}
		.front-side {
			grid-template-columns: 1fr;
		}
		.briefs {
			grid-template-columns: 1fr;
		}
		.briefs > :global(.story) {
			padding: 18px 0;
			border-left: 0;
		}
		.briefs > :global(.story + .story) {
			border-top: 1px solid var(--rule-strong);
		}
		.rail {
			grid-template-columns: 1fr;
		}
		.chapters-grid {
			gap: 16px;
		}
	}
</style>

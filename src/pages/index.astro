---
import Layout from '../layouts/Layout.astro';
import fs from 'fs';
import path from 'path';

const articlesDir = path.join(process.cwd(), 'data', 'articles');
let articles = [];
if (fs.existsSync(articlesDir)) {
    const files = fs.readdirSync(articlesDir).filter(f => f.endsWith('.json'));
    articles = files.map(f => {
        return JSON.parse(fs.readFileSync(path.join(articlesDir, f), 'utf-8'));
    });
}
articles.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const categories = [
    { id: "all", name: "Tüm Haberler" },
    { id: "model-cikisi", name: "Model Çıkışı" },
    { id: "guncelleme", name: "Güncelleme" },
    { id: "benchmark", name: "Benchmark" },
    { id: "arastirma", name: "Araştırma" },
    { id: "fiyat-limit", name: "Fiyat & Limit" },
    { id: "arac-sdk", name: "Araç & SDK" },
    { id: "politika", name: "Politika & Regülasyon" }
];
---

<Layout title="Yöney: Türkiye'nin yapay zekâ haber ve benchmark takibi">
	<div class="category-bar">
		<button class="cat-pill active" data-cat="all">Tümü ({articles.length})</button>
		{categories.slice(1).map(cat => {
			const count = articles.filter(a => a.kategori === cat.id).length;
			return count > 0 ? (
				<button class="cat-pill" data-cat={cat.id}>{cat.name} ({count})</button>
			) : null;
		})}
	</div>

	<div class="articles-container">
		{articles.length === 0 ? (
			<div class="empty-state">
				<p>Henüz haber bulunmuyor. GitHub Actions pipeline'ı ilk turu tamamladığında son 1 ayın haberleri burada listelenecektir.</p>
			</div>
		) : (
			<div class="news-feed">
				{articles.map((article, i) => (
					<article class={`article-card ${i === 0 ? "featured-card" : ""}`} data-category={article.kategori || "diger"}>
						{article.gorsel_url && (
							<div class="card-image">
								<a href={`/haber/${article.slug}`}>
									<img src={article.gorsel_url} alt={article.baslik_tr} loading={i === 0 ? "eager" : "lazy"} />
								</a>
							</div>
						)}
						<div class="card-content">
							<div class="article-meta">
								<span class="source">{article.source}</span>
								<span class="category-badge">{article.kategori || "Genel"}</span>
								<span class="date">{new Date(article.date).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
							</div>

							<h2><a href={`/haber/${article.slug}`}>{article.baslik_tr}</a></h2>
							<p class="summary">{article.ozet_tr}</p>

							{article.benchmarklar && article.benchmarklar.length > 0 && (
								<div class="benchmark-highlight">
									📊 <strong>{article.benchmarklar.length} Doğrulanmış Benchmark:</strong> {article.benchmarklar.map((b: any) => `${b.model} (${b.benchmark}: ${b.skor} ${b.birim})`).join(', ')}
								</div>
							)}

							<div class="card-footer">
								<div class="tags">
									{article.etiketler && article.etiketler.map((tag: string) => (
										<span class="tag">#{tag}</span>
									))}
								</div>
								<a href={article.url} target="_blank" rel="noopener noreferrer" class="source-text-link">
									{article.source} kaynağında gör ↗
								</a>
							</div>
						</div>
					</article>
				))}
			</div>
		)}
	</div>
</Layout>

<script>
	const buttons = document.querySelectorAll('.cat-pill');
	const cards = document.querySelectorAll('.article-card');

	buttons.forEach(btn => {
		btn.addEventListener('click', () => {
			buttons.forEach(b => b.classList.remove('active'));
			btn.classList.add('active');
			const targetCat = btn.getAttribute('data-cat');

			cards.forEach(card => {
				const cardCat = card.getAttribute('data-category');
				if (targetCat === 'all' || cardCat === targetCat) {
					(card as HTMLElement).style.display = 'flex';
				} else {
					(card as HTMLElement).style.display = 'none';
				}
			});
		});
	});
</script>

<style>
	.category-bar {
		display: flex;
		gap: 0.5rem;
		overflow-x: auto;
		padding: 0.5rem 0 1.5rem 0;
		margin-bottom: 2rem;
		border-bottom: 1px solid var(--border-color);
		scrollbar-width: thin;
	}

	.cat-pill {
		background: none;
		border: 1px solid var(--border-color);
		padding: 0.4rem 0.85rem;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		cursor: pointer;
		white-space: nowrap;
		color: var(--text-color);
		transition: all 0.15s ease;
	}

	.cat-pill:hover, .cat-pill.active {
		background: var(--text-color);
		color: var(--bg-color);
		border-color: var(--text-color);
	}

	.news-feed {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
	}

	.article-card {
		display: flex;
		gap: 2rem;
		border-bottom: 1px solid var(--border-color);
		padding-bottom: 2.5rem;
		align-items: flex-start;
	}

	.featured-card {
		flex-direction: column;
	}

	.featured-card .card-image {
		width: 100%;
		max-height: 420px;
	}

	.featured-card h2 {
		font-size: 2.3rem;
		margin: 0.75rem 0;
	}

	.card-image {
		flex-shrink: 0;
		width: 260px;
		height: 170px;
		overflow: hidden;
		background: rgba(0, 0, 0, 0.04);
		border: 1px solid var(--border-color);
	}

	.card-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.25s ease;
		display: block;
	}

	.card-image a:hover img {
		transform: scale(1.03);
	}

	.card-content {
		flex: 1;
		display: flex;
		flex-direction: column;
	}

	.article-meta {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		text-transform: uppercase;
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.5rem;
		color: var(--secondary-color);
	}

	.source {
		font-weight: 700;
		color: var(--accent-color);
	}

	.category-badge {
		background: rgba(0, 0, 0, 0.05);
		padding: 0.1rem 0.4rem;
		font-size: 0.75rem;
	}

	h2 {
		font-size: 1.6rem;
		margin: 0.25rem 0 0.75rem 0;
		line-height: 1.3;
	}

	h2 a {
		text-decoration: none;
		color: inherit;
	}

	h2 a:hover {
		color: var(--accent-color);
	}

	.summary {
		font-size: 1.05rem;
		line-height: 1.6;
		margin-bottom: 1rem;
		color: var(--text-color);
	}

	.benchmark-highlight {
		background: rgba(180, 50, 50, 0.04);
		border-left: 3px solid var(--accent-color);
		padding: 0.5rem 0.75rem;
		font-size: 0.85rem;
		margin-bottom: 1rem;
		font-family: var(--font-mono);
	}

	.card-footer {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 1rem;
		margin-top: auto;
	}

	.tags {
		display: flex;
		gap: 0.4rem;
		flex-wrap: wrap;
	}

	.tag {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--secondary-color);
	}

	/* Kaynağa git: kutusuz, minik, sade yazı stili */
	.source-text-link {
		font-size: 0.8rem;
		color: var(--secondary-color);
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.source-text-link:hover {
		color: var(--accent-color);
		text-decoration: underline;
	}

	@media (max-width: 768px) {
		.article-card {
			flex-direction: column;
		}
		.card-image {
			width: 100%;
			height: 200px;
		}
	}
</style>

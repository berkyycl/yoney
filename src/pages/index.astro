---
import Layout from '../layouts/Layout.astro';
import NewsCard from '../components/NewsCard.astro';
import { loadArticles, sourceLabel } from '../lib/articles';
import { loadBenchmarkData } from '../lib/benchmarks';
import { NEWS_CATEGORIES, newsCategoryName } from '../lib/categories';

const PAGE = 12;
const articles = loadArticles();
const catOf = (a: any) => (NEWS_CATEGORIES.some(c => c.id === a.kategori) ? a.kategori : 'diger');
const time = (a: any) => new Date(a.date).getTime();
const day = (a: any) => new Date(a.date).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', timeZone: 'Europe/Istanbul' });

// Öne çıkanlar: son 3 günün görselli haberlerinden en önemlileri
const newest = articles.length ? time(articles[0]) : 0;
const withImage = articles.filter(a => a.gorsel_url);
const featured = withImage
	.filter(a => newest - time(a) < 3 * 864e5)
	.sort((a, b) => (b.onem ?? 0) - (a.onem ?? 0) || time(b) - time(a))
	.slice(0, 3);
for (const a of withImage) {
	if (featured.length >= 3) break;
	if (!featured.includes(a)) featured.push(a);
}
const featuredSlugs = new Set(featured.map(a => a.slug));

const categories = NEWS_CATEGORIES
	.map(c => ({ ...c, count: articles.filter(a => catOf(a) === c.id).length }))
	.filter(c => c.count > 0);

const sourceCount = new Set(articles.map(a => a.source)).size;
const benchCount = loadBenchmarkData().benchmarks.length;

// İlk görünümde öne çıkanlar listede tekrar etmez; ilk sayfadan sonrası "Daha fazla" ile açılır
let shown = 0;
const feed = articles.map(a => {
	const isFeatured = featuredSlugs.has(a.slug);
	const hidden = isFeatured || shown >= PAGE;
	if (!isFeatured) shown++;
	return { a, isFeatured, hidden };
});
const restCount = articles.length - featured.length;
---

<Layout title="Yöney: Türkiye'nin yapay zekâ haber ve benchmark takibi">
	<section class="hero">
		<div class="hero-text">
			<p class="live-pill"><span class="live-dot"></span>Her 3 saatte bir güncellenir</p>
			<h1>Yapay zekâda bugün <span class="grad">neler oluyor?</span></h1>
			<p class="lead">Model çıkışları, güncellemeler ve doğrulanmış benchmark skorları. Resmi kaynaklardan ve bağımsız basından derlenip Türkçeye aktarılır.</p>
		</div>
		<div class="stats">
			<div class="stat"><span class="stat-label">Haber</span><span class="stat-value">{articles.length}</span></div>
			<div class="stat"><span class="stat-label">Kaynak</span><span class="stat-value">{sourceCount}</span></div>
			<a class="stat stat-link" href="/benchmarklar"><span class="stat-label">Benchmark</span><span class="stat-value">{benchCount}</span></a>
		</div>
	</section>

	{articles.length === 0 ? (
		<p class="empty">Henüz haber bulunmuyor. Otomatik güncelleme ilk turunu tamamladığında son bir ayın haberleri burada listelenecek.</p>
	) : (
		<>
			{featured.length > 0 && (
				<section class="featured" id="featured" aria-label="Öne çıkanlar">
					{featured.map((a, i) => (
						<article class:list={['feat', i === 0 ? 'feat-main' : 'feat-side']} data-cat={catOf(a)}>
							<img src={a.gorsel_url} alt="" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" referrerpolicy="no-referrer" onerror="this.parentElement.classList.add('no-img');this.remove()" />
							<div class="feat-body">
								<span class="feat-cat cat" data-cat={catOf(a)}>{newsCategoryName(catOf(a))}</span>
								{i === 0
									? <h2><a href={`/haber/${a.slug}`}>{a.baslik_tr}</a></h2>
									: <h3><a href={`/haber/${a.slug}`}>{a.baslik_tr}</a></h3>}
								{i === 0 && <p>{a.ozet_tr}</p>}
								<span class="feat-meta"><span lang="en">{sourceLabel(a.source)}</span> ·<time datetime={a.date} data-rel>{day(a)}</time></span>
							</div>
						</article>
					))}
				</section>
			)}

			<div class="filter-bar" role="toolbar" aria-label="Kategoriye göre süz">
				<button class="chip-btn" type="button" data-cat="all" aria-pressed="true">Tümü <span class="count">{articles.length}</span></button>
				{categories.map(c => (
					<button class="chip-btn" type="button" data-cat={c.id} data-label={c.name} aria-pressed="false">
						<span class="cat" data-cat={c.id}></span>{c.name} <span class="count">{c.count}</span>
					</button>
				))}
			</div>

			<section aria-labelledby="feedTitle">
				<h2 class="feed-title" id="feedTitle">Son haberler</h2>
				<div class="news-grid">
					{feed.map(({ a, isFeatured, hidden }) => <NewsCard article={a} featured={isFeatured} hidden={hidden} />)}
				</div>
				<div class="feed-foot">
					<button class="btn" id="moreBtn" type="button" hidden={restCount <= PAGE}>Daha fazla haber</button>
					<p class="muted" id="feedCount">{Math.min(PAGE, restCount)} / {restCount} haber</p>
				</div>
			</section>
		</>
	)}
</Layout>

<script>
	const PAGE = 12;
	const cards = Array.from(document.querySelectorAll<HTMLElement>('.news-card'));
	const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-bar .chip-btn'));
	const featuredEl = document.getElementById('featured');
	const moreBtn = document.getElementById('moreBtn') as HTMLButtonElement | null;
	const countEl = document.getElementById('feedCount');
	const titleEl = document.getElementById('feedTitle');
	const filterBar = document.querySelector<HTMLElement>('.filter-bar');

	let cat = 'all';
	let limit = PAGE;

	const matching = () => cards.filter(c => (cat === 'all' ? c.dataset.featured !== '1' : c.dataset.category === cat));

	function render() {
		const m = matching();
		const visible = new Set(m.slice(0, limit));
		cards.forEach(c => { c.hidden = !visible.has(c); });
		if (featuredEl) featuredEl.hidden = cat !== 'all';
		if (moreBtn) moreBtn.hidden = m.length <= limit;
		if (countEl) countEl.textContent = `${Math.min(limit, m.length)} / ${m.length} haber`;
		const chip = chips.find(c => c.dataset.cat === cat);
		if (titleEl) titleEl.textContent = cat === 'all' ? 'Son haberler' : (chip?.dataset.label ?? 'Haberler');
		chips.forEach(c => c.setAttribute('aria-pressed', String(c.dataset.cat === cat)));
	}

	function select(next: string, scroll: boolean) {
		cat = chips.some(c => c.dataset.cat === next) ? next : 'all';
		limit = PAGE;
		render();
		history.replaceState(null, '', cat === 'all' ? location.pathname : `#${cat}`);
		// Süzgeç değişince listenin başına dön (yapışkan çubuğun altından)
		if (scroll && filterBar && filterBar.getBoundingClientRect().top <= 80) {
			const y = (titleEl?.getBoundingClientRect().top ?? 0) + window.scrollY - 140;
			window.scrollTo({ top: y, behavior: 'smooth' });
		}
	}

	chips.forEach(c => c.addEventListener('click', () => select(c.dataset.cat || 'all', true)));
	moreBtn?.addEventListener('click', () => { limit += PAGE; render(); });

	const fromHash = decodeURIComponent(location.hash.slice(1));
	if (fromHash) select(fromHash, false);
</script>

<style>
	/* ---------- Giriş ---------- */
	.hero {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 28px 40px;
		margin: 8px 0 36px;
	}

	.hero-text {
		max-width: 720px;
	}

	.live-pill {
		display: inline-flex;
		align-items: center;
		gap: 9px;
		margin: 0;
		padding: 5px 13px 5px 11px;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: var(--surface);
		color: var(--text-2);
		font-size: 0.8rem;
		font-weight: 500;
	}

	.hero h1 {
		margin: 18px 0 14px;
		font-size: clamp(2.2rem, 5.4vw, 3.6rem);
		font-weight: 700;
		letter-spacing: -0.045em;
		line-height: 1.04;
	}

	.hero .lead {
		max-width: 60ch;
	}

	.stats {
		display: flex;
		gap: 10px;
		margin: 0;
	}

	.stat {
		min-width: 108px;
		padding: 12px 16px;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
	}

	.stat-label {
		display: block;
		color: var(--muted);
		font-size: 0.78rem;
	}

	.stat-value {
		display: block;
		margin: 2px 0 0;
		font-size: 1.6rem;
		font-weight: 700;
		letter-spacing: -0.04em;
		font-variant-numeric: tabular-nums;
	}

	.stat-link {
		color: var(--text);
		text-decoration: none;
		transition: border-color 0.15s;
	}

	.stat-link:hover {
		border-color: var(--accent);
	}

	.stat-link .stat-value::after {
		content: ' →';
		color: var(--accent-text);
		font-size: 1rem;
	}

	/* ---------- Öne çıkanlar ---------- */
	.featured {
		display: grid;
		grid-template-columns: 1.65fr 1fr;
		grid-template-rows: 1fr 1fr;
		gap: 20px;
		margin-bottom: 36px;
	}

	.feat {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		min-height: 230px;
		border-radius: var(--radius-lg);
		background: #15151b;
		color: #fff;
	}

	.feat-main {
		grid-row: 1 / 3;
		min-height: 480px;
	}

	.feat img {
		position: absolute;
		inset: 0;
		z-index: -2;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s ease;
	}

	.feat::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		/* Açık renkli görsellerde de beyaz yazı okunsun diye metnin arkası koyulaştırılır */
		background: linear-gradient(to top, rgba(6, 6, 10, 0.95) 0%, rgba(6, 6, 10, 0.8) 38%, rgba(6, 6, 10, 0.3) 68%, rgba(6, 6, 10, 0) 90%);
	}

	.feat.no-img {
		background:
			radial-gradient(90% 90% at 10% 0%, color-mix(in srgb, var(--c) 55%, transparent) 0%, transparent 65%),
			radial-gradient(80% 80% at 100% 100%, rgba(14, 165, 233, 0.35) 0%, transparent 60%),
			#15151b;
	}

	.feat:hover img {
		transform: scale(1.04);
	}

	.feat-body {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 10px;
		padding: 24px;
	}

	.feat-main .feat-body {
		padding: 32px;
		max-width: 720px;
	}

	.feat-cat {
		padding: 4px 11px 4px 10px;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.14);
		-webkit-backdrop-filter: blur(8px);
		backdrop-filter: blur(8px);
		color: #fff;
	}

	.feat h2,
	.feat h3 {
		margin: 0;
		color: #fff;
		line-height: 1.22;
	}

	.feat h2 {
		font-size: clamp(1.5rem, 2.8vw, 2.2rem);
		font-weight: 700;
		letter-spacing: -0.035em;
	}

	.feat h3 {
		font-size: 1.15rem;
		letter-spacing: -0.02em;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.feat a {
		color: inherit;
		text-decoration: none;
	}

	.feat a::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	.feat p {
		margin: 0;
		color: rgba(255, 255, 255, 0.82);
		font-size: 1.02rem;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.feat-meta {
		color: rgba(255, 255, 255, 0.72);
		font-size: 0.82rem;
	}

	/* ---------- Kategori çubuğu ---------- */
	.filter-bar {
		position: sticky;
		top: var(--header-h);
		z-index: 20;
		display: flex;
		gap: 8px;
		margin: 0 -24px 8px;
		padding: 12px 24px;
		overflow-x: auto;
		scrollbar-width: none;
		background: var(--header-bg);
		-webkit-backdrop-filter: saturate(180%) blur(14px);
		backdrop-filter: saturate(180%) blur(14px);
	}

	.filter-bar::-webkit-scrollbar {
		display: none;
	}

	.filter-bar .cat {
		gap: 0;
	}

	.chip-btn[aria-pressed='true'] .cat::before {
		box-shadow: none;
	}

	/* ---------- Haber listesi ---------- */
	.feed-title {
		margin: 16px 0 18px;
		font-size: 1.4rem;
		letter-spacing: -0.03em;
	}

	.news-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 20px;
	}

	.feed-foot {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 10px;
		margin-top: 36px;
	}

	.feed-foot p {
		margin: 0;
		font-size: 0.85rem;
	}

	@media (max-width: 900px) {
		.featured {
			grid-template-columns: 1fr 1fr;
			grid-template-rows: auto auto;
		}
		.feat-main {
			grid-column: 1 / -1;
			grid-row: auto;
			min-height: 400px;
		}
	}

	@media (max-width: 640px) {
		.hero {
			margin-bottom: 28px;
		}
		.stats {
			width: 100%;
		}
		.stat {
			flex: 1;
			min-width: 0;
			padding: 10px 12px;
		}
		.stat-value {
		display: block;
			font-size: 1.35rem;
		}
		.featured {
			grid-template-columns: 1fr;
			gap: 14px;
		}
		.feat-main {
			min-height: 380px;
		}
		.feat::before {
			background: linear-gradient(to top, rgba(6, 6, 10, 0.96) 0%, rgba(6, 6, 10, 0.86) 55%, rgba(6, 6, 10, 0.35) 85%, rgba(6, 6, 10, 0.1) 100%);
		}
		.feat-main .feat-body,
		.feat-body {
			padding: 20px;
		}
		.feat-side {
			min-height: 200px;
		}
		.filter-bar {
			margin: 0 -16px 8px;
			padding: 10px 16px;
		}
		.news-grid {
			grid-template-columns: 1fr;
			gap: 16px;
		}
	}
</style>

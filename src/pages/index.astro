---
import Layout from '../layouts/Layout.astro';
import Story from '../components/Story.astro';
import Art from '../components/Art.astro';
import ChapterTile from '../components/ChapterTile.astro';
import StandCard from '../components/StandCard.astro';
import ModelRails from '../components/ModelRails.astro';
import { loadArticles, sourceLabel } from '../lib/articles';
import { loadBenchmarkData } from '../lib/benchmarks';
import { buildStands } from '../lib/stands';
import { NEWS_CATEGORIES, categoryOf, getCategory } from '../lib/categories';
import { articleModelKeys, modelMentions } from '../lib/mentions';

const PAGE = 8;
const articles = loadArticles();
const time = (a: any) => new Date(a.date).getTime();

// Ön sayfa resmi kaynaklar ve bağımsız basından kurulur; topluluk (Reddit) ayrı şeritte
const editorialAll = articles.filter(a => a.sourceTier !== 'topluluk');
const editorial = editorialAll.length > 0 ? editorialAll : articles;
const community = articles.filter(a => a.sourceTier === 'topluluk');

// Manşet: son 3 günün görselli haberlerinden önce önem sonra tarih
const newest = editorial.length ? time(editorial[0]) : 0;
const ranked = editorial
	.filter(a => a.gorsel_url && newest - time(a) < 3 * 864e5)
	.sort((a, b) => (b.onem ?? 0) - (a.onem ?? 0) || time(b) - time(a));
const lead = ranked[0] ?? editorial[0];
const leadCat = lead ? getCategory(categoryOf(lead)) : null;

/*
 * Popüler: okunma sayısı tutulmadığı için son 3 günün haberleri önem puanı,
 * tazelik ve konu ettiği modellerin ne kadar konuşulduğuna göre sıralanır.
 */
const buzz = new Map(modelMentions(articles, 14).map(m => [m.key, m.count]));
const popScore = (a: any) => {
	const hours = (newest - time(a)) / 36e5;
	const talk = articleModelKeys(a).reduce((s, k) => s + Math.min(buzz.get(k) ?? 0, 12), 0);
	return (a.onem ?? 3) * 10 + Math.min(talk, 24) * 0.8 + (a.gorsel_url ? 2 : 0) - hours * 0.25;
};
const popular = articles
	.filter(a => a !== lead && newest - time(a) < 3 * 864e5)
	.sort((a, b) => popScore(b) - popScore(a))
	.slice(0, 5);

// Gazete dilimleri: görselli yerlere görselli haberler, başlık listelerine kalanlar
const pool = editorial.filter(a => a !== lead && !popular.includes(a));
const take = (needImage: boolean) => {
	const i = needImage ? pool.findIndex(a => a.gorsel_url) : 0;
	return i >= 0 && pool.length ? pool.splice(i, 1)[0] : null;
};
const many = (n: number, needImage: boolean) => Array.from({ length: n }, () => take(needImage)).filter(Boolean) as any[];
const topFeature = take(true);
const topMid = many(2, true);
const topList = many(5, false);
const strip = many(4, true);
const wide = take(true);
const wideList = many(4, false);
const more = pool;
const ticker = articles.slice(0, 10);

const bench = loadBenchmarkData();
const stands = buildStands(bench.entries);
const champion = stands[0];
const contenders = stands.slice(1, 4);

const chapters = NEWS_CATEGORIES.map(c => ({ c, count: articles.filter(a => categoryOf(a) === c.id).length }));
const leadDay = lead ? new Date(lead.date).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', timeZone: 'Europe/Istanbul' }) : '';
---

<Layout title="Yöney: Türkiye'nin yapay zekâ haber ve benchmark takibi" palette="altin" wide>
	<div class="home">
	<ModelRails side="left" bench={bench} articles={articles} />
	<div class="home-main">
	{!lead ? (
		<p class="empty">Henüz haber bulunmuyor. Otomatik güncelleme ilk turunu tamamladığında son bir ayın haberleri burada listelenecek.</p>
	) : (
		<>
			<!-- Manşet sahnesi -->
			<section class="hero" data-cat={leadCat!.id} aria-label="Manşet">
				<div class="hero-stage">
					<div class="hero-aura" aria-hidden="true"></div>
					<a class="hero-media poster reveal-color tilt" href={`/haber/${lead.slug}`} tabindex="-1" aria-hidden="true">
						<Art cat={leadCat!.id} seed={lead.slug} label={sourceLabel(lead.source)} />
						{lead.gorsel_url && (
							<img src={lead.gorsel_url} alt="" decoding="async" referrerpolicy="no-referrer" onerror="this.remove()" />
						)}
						<span class="shine"></span>
					</a>
					<span class="hero-badge" aria-hidden="true">Manşet</span>
				</div>
				<div class="hero-copy pose">
					<a class="chip" href={`/kategori/${leadCat!.id}`} data-cat={leadCat!.id}><span><span class="num">{leadCat!.numeral}</span> {leadCat!.name}</span></a>
					<h1 class="hero-title"><a href={`/haber/${lead.slug}`}>{lead.baslik_tr}</a></h1>
					<p class="hero-deck deck">{lead.ozet_tr}</p>
					<div class="hero-meta">
						<span><strong lang="en">{sourceLabel(lead.source)}</strong> · <time datetime={lead.date} data-rel>{leadDay}</time></span>
						<a class="btn btn-fill" href={`/haber/${lead.slug}`}>Haberi oku →</a>
					</div>
				</div>
			</section>

			<!-- Popüler -->
			{popular.length > 0 && (
				<section class="popular" aria-labelledby="popTitle">
					<h2 class="popular-title" id="popTitle">Popüler</h2>
					<ol class="popular-list">
						{popular.map((a, i) => {
							const c = getCategory(categoryOf(a));
							return (
								<li class="pose" data-cat={c.id} style={`--delay:${i * 0.06}s`}>
									<span class="pop-num" aria-hidden="true">{i + 1}</span>
									<div class="pop-body">
										<a class="pop-kicker" href={`/kategori/${c.id}`}>{c.name}</a>
										<a class="pop-head" href={`/haber/${a.slug}`}>{a.baslik_tr}</a>
										<span class="pop-meta"><span lang="en">{sourceLabel(a.source)}</span> · <time datetime={a.date} data-rel>{new Date(a.date).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', timeZone: 'Europe/Istanbul' })}</time></span>
									</div>
								</li>
							);
						})}
					</ol>
				</section>
			)}

			<!-- Son dakika bandı -->
			<div class="ticker" role="region" aria-label="Son başlıklar">
				<span class="ticker-label">Son dakika</span>
				<div class="ticker-view">
					<div class="ticker-track">
						{[...ticker, ...ticker].map((a, i) => (
							<>
								<a href={`/haber/${a.slug}`} tabindex={i >= ticker.length ? -1 : undefined} aria-hidden={i >= ticker.length ? 'true' : undefined}>{a.baslik_tr}</a>
								<span class="ticker-sep" aria-hidden="true">◆</span>
							</>
						))}
					</div>
				</div>
			</div>

			<!-- Gündem -->
			<section class="block" aria-labelledby="feedTitle">
				<div class="section-head">
					<span class="sec-num">01</span>
					<h2 id="feedTitle">Gündem</h2>
					<span class="sec-line" aria-hidden="true"></span>
					<a class="sec-more" href="/kategori">Bölümler →</a>
				</div>
				<!-- Dilim 1: öne çıkan + iki haber + kısa kısa -->
				<div class="slice slice-top">
					{topFeature && <div class="col col-feature"><Story article={topFeature} variant="feature" eager /></div>}
					{topMid.length > 0 && (
						<div class="col col-mid">
							{topMid.map((a, i) => <Story article={a} variant="compact" delay={0.06 + i * 0.06} />)}
						</div>
					)}
					{topList.length > 0 && (
						<div class="col col-list">
							<p class="col-label">Kısa kısa</p>
							{topList.map((a, i) => <Story article={a} variant="text" delay={i * 0.05} />)}
						</div>
					)}
				</div>

				<!-- Dilim 2: dört sütun -->
				{strip.length > 0 && (
					<div class="slice slice-strip">
						{strip.map((a, i) => <div class="col"><Story article={a} variant="compact" delay={i * 0.06} /></div>)}
					</div>
				)}

				<!-- Dilim 3: geniş haber + başlıklar -->
				{wide && (
					<div class="slice slice-wide">
						<div class="col"><Story article={wide} variant="wide" /></div>
						{wideList.length > 0 && (
							<div class="col col-list">
								<p class="col-label">Gündemden</p>
								{wideList.map((a, i) => <Story article={a} variant="text" delay={i * 0.05} />)}
							</div>
						)}
					</div>
				)}

				<!-- Daha fazla haber -->
				{more.length > 0 && (
					<div class="slice slice-more">
						<p class="col-label">Daha fazla haber</p>
						<div class="more-list" id="feed" data-paged={PAGE}>
							{more.map((a, i) => <Story article={a} variant="row" hidden={i >= PAGE} />)}
						</div>
						<div class="feed-foot">
							<button class="btn" type="button" data-more="feed" hidden={more.length <= PAGE}>Daha fazla haber</button>
							<p class="muted" data-count="feed">{Math.min(PAGE, more.length)} / {more.length} haber</p>
						</div>
					</div>
				)}
			</section>

			<!-- Arena'nın zirvesi -->
			{champion && (
				<section class="block arena" aria-labelledby="arenaTitle">
					<div class="section-head">
						<span class="sec-num">02</span>
						<h2 id="arenaTitle">Arena'nın zirvesi</h2>
						<span class="sec-line" aria-hidden="true"></span>
						<a class="sec-more" href="/benchmarklar">Tüm sıralamalar →</a>
					</div>
					<p class="arena-note">Her model altı eksende LMArena puanıyla (ELO, kullanıcı oyları) ölçülür. Altıgen ne kadar genişse model o eksende sıralamanın o kadar üstündedir; köşelerde puan ve sıra yazar.</p>
					<div class="arena-grid">
						<StandCard card={champion} size="large" rank={1} />
						<div class="arena-side">
							{contenders.map((c, i) => <StandCard card={c} rank={i + 2} />)}
						</div>
					</div>
					<a class="btn arena-cta" href="/karsilastir">İki modeli karşı karşıya getir →</a>
				</section>
			)}

			<!-- Topluluktan -->
			{community.length > 0 && (
				<section class="block" aria-labelledby="crowdTitle">
					<div class="section-head">
						<span class="sec-num">03</span>
						<h2 id="crowdTitle">Topluluktan</h2>
						<span class="sec-line" aria-hidden="true"></span>
					</div>
					<ol class="crowd">
						{community.slice(0, 8).map((a, i) => <li class="pose" style={`--delay:${(i % 4) * 0.06}s`}><Story article={a} variant="mini" /></li>)}
					</ol>
				</section>
			)}

			<!-- Bölümler -->
			<section class="block" aria-labelledby="chaptersTitle">
				<div class="section-head">
					<span class="sec-num">04</span>
					<h2 id="chaptersTitle">Bölümler</h2>
					<span class="sec-line" aria-hidden="true"></span>
					<a class="sec-more" href="/kategori">Tümü →</a>
				</div>
				<div class="chapters-grid">
					{chapters.map(({ c, count }, i) => <ChapterTile category={c} count={count} delay={(i % 4) * 0.07} />)}
				</div>
			</section>
		</>
	)}
	</div>
	<ModelRails side="right" bench={bench} articles={articles} />
	</div>
</Layout>

<script>
	import '../scripts/paged';
</script>

<style>
	/* ---------- Üç sütun: sol pano · içerik · sağ pano ---------- */
	.home {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 56px 32px;
	}

	/* Orta sütundaki bölümler ekran yerine bu sütunun genişliğine göre düzenlenir */
	.home-main {
		grid-column: 1 / -1;
		grid-row: 1;
		min-width: 0;
		container: home / inline-size;
	}

	@media (min-width: 1280px) {
		.home {
			grid-template-columns: clamp(210px, 15vw, 270px) minmax(0, 1fr) clamp(210px, 15vw, 270px);
			gap: 0 clamp(24px, 2.2vw, 40px);
			align-items: start;
		}
		.home-main {
			grid-column: 2;
		}
		.home > :global(.rail) {
			position: sticky;
			top: calc(var(--header-h) + 26px);
			grid-row: 1;
			max-height: calc(100vh - var(--header-h) - 46px);
			overflow-y: auto;
			padding: 4px 10px 10px 2px;
			scrollbar-width: thin;
			scrollbar-color: var(--a2) transparent;
		}
		.home > :global(.rail-left) {
			grid-column: 1;
		}
		.home > :global(.rail-right) {
			grid-column: 3;
		}
	}

	@media (max-width: 760px) {
		.home {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	/* ---------- Manşet sahnesi ---------- */
	.hero {
		position: relative;
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		align-items: center;
		margin: 6px 0 56px;
	}

	.hero-stage {
		position: relative;
		grid-column: 1 / 9;
		grid-row: 1;
		/* Auranın taşan kenarı ekranın dışına kaçmasın */
		margin: 20px 0 20px 22px;
		transform: translate3d(calc(var(--px, 0) * 10px), calc(var(--py, 0) * 8px), 0) rotate(-1.5deg);
	}

	.hero-aura {
		position: absolute;
		inset: -26px;
		background: linear-gradient(120deg, var(--a2), var(--a1), var(--a3), var(--a4), var(--a2));
		background-size: 300% 300%;
		filter: url(#aura);
		animation: aura-flow 9s linear infinite;
	}

	@keyframes aura-flow {
		to { background-position: 300% 0; }
	}

	.hero-media {
		position: relative;
		aspect-ratio: 16 / 11;
		border: 3px solid var(--line);
	}

	.hero-badge {
		position: absolute;
		top: -18px;
		left: 26px;
		z-index: 4;
		padding: 0.4em 1em;
		background: var(--a1);
		color: var(--on-a1);
		border: 2px solid var(--line);
		font-family: var(--font-display);
		font-size: 1.1rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		transform: rotate(-6deg);
		box-shadow: 4px 4px 0 var(--shadow);
	}

	.hero-copy {
		position: relative;
		z-index: 5;
		grid-column: 7 / 13;
		grid-row: 1;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 16px;
		padding: 30px 30px 28px;
		background: var(--surface);
		border: 3px solid var(--line);
		box-shadow: 12px 12px 0 var(--a2);
		transform: translate3d(calc(var(--px, 0) * -14px), calc(var(--py, 0) * -10px), 0) rotate(1.2deg);
	}

	.hero-title {
		margin: 0;
		font-size: clamp(1.9rem, 4.6cqi, 3.7rem);
		line-height: 0.95;
		text-transform: uppercase;
	}

	.hero-title a {
		color: var(--text);
		text-decoration: none;
		text-shadow: 3px 3px 0 var(--shadow);
	}

	.hero-title a:hover {
		color: var(--a1);
	}

	.hero-deck {
		margin: 0;
		color: var(--text-2);
		font-size: 1.12rem;
		line-height: 1.5;
		display: -webkit-box;
		-webkit-line-clamp: 4;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.hero-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 14px;
		width: 100%;
		padding-top: 14px;
		border-top: 2px solid var(--rule);
		color: var(--muted);
		font-size: 0.8rem;
	}

	.hero-meta strong {
		color: var(--text);
	}

	/* ---------- Son dakika bandı ---------- */
	.ticker {
		display: flex;
		align-items: stretch;
		margin: 0 -24px 72px;
		background: var(--a2);
		color: var(--on-a2);
		border-top: 3px solid var(--line);
		border-bottom: 3px solid var(--line);
		transform: rotate(-1.2deg);
		overflow: hidden;
	}

	.ticker-label {
		display: flex;
		align-items: center;
		flex-shrink: 0;
		padding: 0 18px;
		background: var(--line);
		color: var(--bg);
		font-family: var(--font-display);
		font-size: 1.05rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.ticker-view {
		flex: 1;
		overflow: hidden;
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
		mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
	}

	.ticker-track {
		display: flex;
		align-items: center;
		gap: 22px;
		width: max-content;
		padding: 13px 0;
		animation: ticker 90s linear infinite;
	}

	.ticker:hover .ticker-track,
	.ticker:focus-within .ticker-track {
		animation-play-state: paused;
	}

	@keyframes ticker {
		to { transform: translateX(-50%); }
	}

	.ticker a {
		color: inherit;
		text-decoration: none;
		font-weight: 800;
		white-space: nowrap;
	}

	.ticker a:hover {
		text-decoration: underline;
	}

	.ticker-sep {
		font-size: 0.7rem;
	}

	/* ---------- Bloklar ---------- */
	.block {
		margin-bottom: 96px;
	}

	/* ---------- Popüler ---------- */
	.popular {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 0;
		margin: 0 0 40px;
		background: var(--surface);
		border: 3px solid var(--line);
		box-shadow: 10px 10px 0 var(--a1);
	}

	.popular-title {
		display: grid;
		place-items: center;
		margin: 0;
		padding: 0 12px;
		background: var(--a2);
		color: var(--on-a2);
		border-right: 3px solid var(--line);
		font-size: 1.5rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		writing-mode: vertical-rl;
		transform: rotate(180deg);
	}

	.popular-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
	}

	.popular-list li {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 12px;
		padding: 18px 18px 18px 16px;
	}

	.popular-list li + li {
		border-left: 1px solid var(--rule);
	}

	.pop-num {
		font-family: var(--font-display);
		font-size: 3.2rem;
		line-height: 0.8;
		color: var(--a1);
		text-shadow: 3px 3px 0 var(--a2);
	}

	.pop-body {
		display: flex;
		flex-direction: column;
		gap: 6px;
		min-width: 0;
	}

	.pop-kicker {
		color: var(--c);
		font-size: 0.64rem;
		font-weight: 900;
		font-stretch: 80%;
		letter-spacing: 0.14em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.pop-head {
		color: var(--text);
		font-family: var(--font-serif);
		font-size: 1rem;
		font-weight: 800;
		line-height: 1.2;
		text-decoration: none;
		display: -webkit-box;
		-webkit-line-clamp: 4;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.pop-head:hover {
		color: var(--a1);
	}

	.pop-meta {
		margin-top: auto;
		color: var(--muted);
		font-size: 0.66rem;
		font-weight: 700;
		font-stretch: 85%;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	/* ---------- Gazete dilimleri ---------- */
	.slice {
		display: grid;
		margin-bottom: 52px;
		padding-top: 26px;
		border-top: 4px solid var(--line);
	}

	.slice-top {
		grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
	}

	.slice-strip {
		grid-template-columns: repeat(4, minmax(0, 1fr));
		border-top-width: 1px;
		border-top-color: var(--rule);
	}

	.slice-wide {
		grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
	}

	/* Sütunlar arasında gazete çizgisi */
	.slice > .col {
		min-width: 0;
		padding: 0 26px;
	}

	.slice > .col:first-child {
		padding-left: 0;
	}

	.slice > .col:last-child {
		padding-right: 0;
	}

	.slice > .col + .col {
		border-left: 1px solid var(--rule);
	}

	.col-mid {
		display: flex;
		flex-direction: column;
		gap: 30px;
	}

	.col-list {
		display: flex;
		flex-direction: column;
	}

	.col-list > :global(.story) {
		padding: 14px 0;
		border-bottom: 1px solid var(--rule);
	}

	.col-list > :global(.story:last-child) {
		border-bottom: 0;
	}

	.col-label {
		margin: 0 0 4px;
		padding-bottom: 8px;
		border-bottom: 3px solid var(--a2);
		color: var(--text);
		font-family: var(--font-display);
		font-size: 1.15rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.slice-more {
		display: block;
	}

	.more-list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		column-gap: 44px;
	}

	.feed-foot {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12px;
		margin-top: 52px;
	}

	.feed-foot p {
		margin: 0;

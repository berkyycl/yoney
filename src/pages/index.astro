---
import Layout from '../layouts/Layout.astro';
import { loadArticles } from '../lib/articles';
import { NEWS_CATEGORIES, newsCategoryName } from '../lib/categories';

const articles = loadArticles();

// "Diğer" dahil tüm kategoriler; haberi olmayanlar gizlenir
const categories = NEWS_CATEGORIES;
const catOf = (a: any) => (categories.some(c => c.id === a.kategori) ? a.kategori : 'diger');
---

<Layout title="Yöney: Türkiye'nin yapay zekâ haber ve benchmark takibi">
	<div class="category-bar">
		<button class="cat-pill active" data-cat="all">Tümü ({articles.length})</button>
		{categories.map(cat => {
			const count = articles.filter(a => catOf(a) === cat.id).length;
			return count > 0 ? (
				<button class="cat-pill" data-cat={cat.id}>{cat.name} ({count})</button>
			) : null;
		})}
	</div>

	<div class="articles-container">
		{articles.length === 0 ? (
			<div class="empty-state">
				<p>Henüz haber bulunmuyor. Otomatik güncelleme ilk turunu tamamladığında son bir ayın haberleri burada listelenecek.</p>
			</div>
		) : (
			<>
				<div class="news-feed" id="newsFeed">
					{articles.map((article, i) => (
						<article class={`article-card ${i === 0 ? "featured-card" : ""}`} data-category={catOf(article)} data-index={i}>
							{article.gorsel_url && (
								<div class="card-image">
									<a href={`/haber/${article.slug}`} aria-hidden="true" tabindex="-1">
										<img src={article.gorsel_url} alt="" loading={i < 3 ? "eager" : "lazy"} referrerpolicy="no-referrer" onerror="this.closest('.card-image')?.remove()" />
									</a>
								</div>
							)}
							<div class="card-content">
								<div class="article-meta">
									<span class="source" lang="en">{article.source}</span>
									<span class="category-badge">{newsCategoryName(article.kategori)}</span>
									<span class="date">{new Date(article.date).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
								</div>

								<h2><a href={`/haber/${article.slug}`}>{article.baslik_tr}</a></h2>
								<p class="summary">{article.ozet_tr}</p>

								{article.benchmarklar && article.benchmarklar.length > 0 && (
									<div class="benchmark-highlight">
										<strong>Kaynakta geçen {article.benchmarklar.length} skor:</strong> {article.benchmarklar.slice(0, 3).map((b: any) => `${b.model} – ${b.benchmark}: ${b.birim === '%' ? '%' : ''}${b.skor}${b.birim && b.birim !== '%' ? ` ${b.birim}` : ''}`).join(' · ')}{article.benchmarklar.length > 3 && ` · +${article.benchmarklar.length - 3} daha`}
									</div>
								)}

								<div class="card-footer">
									<div class="tags">
										{article.etiketler && article.etiketler.map((tag: string) => (
											<span class="tag">#{tag}</span>
										))}
									</div>
									<a href={article.url} target="_blank" rel="noopener noreferrer" class="source-text-link">
										{article.source} kaynağında gör ↗
									</a>
								</div>
							</div>
						</article>
					))}
				</div>

				<!-- Sayfalama (Pagination Bar) -->
				<div class="pagination-bar" id="paginationBar">
					<button class="page-nav-btn" id="prevPageBtn" disabled>← Önceki</button>
					<div class="page-numbers" id="pageNumbers"></div>
					<button class="page-nav-btn" id="nextPageBtn">Sonraki →</button>
				</div>
			</>
		)}
	</div>
</Layout>

<script>
	const ITEMS_PER_PAGE = 10;
	let currentPage = 1;
	let currentCategory = 'all';

	const buttons = document.querySelectorAll('.cat-pill');
	const allCards = Array.from(document.querySelectorAll('.article-card')) as HTMLElement[];
	const prevBtn = document.getElementById('prevPageBtn') as HTMLButtonElement | null;
	const nextBtn = document.getElementById('nextPageBtn') as HTMLButtonElement | null;
	const pageNumbersContainer = document.getElementById('pageNumbers');

	function getMatchingCards() {
		return allCards.filter(card => {
			if (currentCategory === 'all') return true;
			return card.getAttribute('data-category') === currentCategory;
		});
	}

	function renderPage() {
		const matchingCards = getMatchingCards();
		const totalPages = Math.ceil(matchingCards.length / ITEMS_PER_PAGE) || 1;

		if (currentPage > totalPages) currentPage = totalPages;
		if (currentPage < 1) currentPage = 1;

		const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
		const endIndex = startIndex + ITEMS_PER_PAGE;

		// Hide all first
		allCards.forEach(card => card.style.display = 'none');

		// Show only current page items
		matchingCards.slice(startIndex, endIndex).forEach((card, idx) => {
			card.style.display = 'flex';
			// Keep featured layout only for first item of page 1 if 'all'
			if (currentPage === 1 && idx === 0 && currentCategory === 'all') {
				card.classList.add('featured-card');
			} else {
				card.classList.remove('featured-card');
			}
		});

		// Update Pagination Controls
		if (prevBtn) prevBtn.disabled = currentPage <= 1;
		if (nextBtn) nextBtn.disabled = currentPage >= totalPages;

		if (pageNumbersContainer) {
			pageNumbersContainer.innerHTML = '';
			// 20+ sayfada tüm numaralar mobilde taşıyordu: ilk, son ve mevcut sayfanın komşuları gösterilir
			const pages: (number | '…')[] = [];
			for (let p = 1; p <= totalPages; p++) {
				if (p === 1 || p === totalPages || Math.abs(p - currentPage) <= 1) pages.push(p);
				else if (pages[pages.length - 1] !== '…') pages.push('…');
			}
			for (const p of pages) {
				if (p === '…') {
					const gap = document.createElement('span');
					gap.className = 'page-gap';
					gap.textContent = '…';
					pageNumbersContainer.appendChild(gap);
					continue;
				}
				const pageBtn = document.createElement('button');
				pageBtn.className = `page-num-btn ${p === currentPage ? 'active' : ''}`;
				pageBtn.textContent = p.toString();
				if (p === currentPage) pageBtn.setAttribute('aria-current', 'page');
				pageBtn.addEventListener('click', () => {
					currentPage = p;
					renderPage();
					window.scrollTo({ top: 0, behavior: 'smooth' });
				});
				pageNumbersContainer.appendChild(pageBtn);
			}
		}
	}

	// Category filter click
	buttons.forEach(btn => {
		btn.addEventListener('click', () => {
			buttons.forEach(b => b.classList.remove('active'));
			btn.classList.add('active');
			currentCategory = btn.getAttribute('data-cat') || 'all';
			currentPage = 1;
			renderPage();
		});
	});

	// Pagination buttons
	if (prevBtn) {
		prevBtn.addEventListener('click', () => {
			if (currentPage > 1) {
				currentPage--;
				renderPage();
				window.scrollTo({ top: 0, behavior: 'smooth' });
			}
		});
	}

	if (nextBtn) {
		nextBtn.addEventListener('click', () => {
			const matchingCards = getMatchingCards();
			const totalPages = Math.ceil(matchingCards.length / ITEMS_PER_PAGE) || 1;
			if (currentPage < totalPages) {
				currentPage++;
				renderPage();
				window.scrollTo({ top: 0, behavior: 'smooth' });
			}
		});
	}

	// Initial render
	renderPage();
</script>

<style>
	.category-bar {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		padding: 0.5rem 0 1.5rem 0;
		margin-bottom: 2rem;
		border-bottom: 1px solid var(--border-color);
		scrollbar-width: thin;
	}

	.cat-pill {
		background: none;
		border: 1px solid var(--border-color);
		padding: 0.4rem 0.85rem;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		cursor: pointer;
		white-space: nowrap;
		color: var(--text-color);
		transition: all 0.15s ease;
	}

	.cat-pill:hover, .cat-pill.active {
		background: var(--text-color);
		color: var(--bg-color);
		border-color: var(--text-color);
	}

	.news-feed {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
	}

	.article-card {
		display: flex;
		gap: 2rem;
		border-bottom: 1px solid var(--border-color);
		padding-bottom: 2.5rem;
		align-items: flex-start;
	}

	.featured-card {
		flex-direction: column;
	}

	.featured-card .card-image {
		width: 100%;
		max-height: 420px;
	}

	.featured-card h2 {
		font-size: 2.3rem;
		margin: 0.75rem 0;
	}

	.card-image {
		flex-shrink: 0;
		width: 260px;
		height: 170px;
		overflow: hidden;
		background: rgba(0, 0, 0, 0.04);
		border: 1px solid var(--border-color);
	}

	.card-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.25s ease;
		display: block;
	}

	.card-image a:hover img {
		transform: scale(1.03);
	}

	.card-content {
		flex: 1;
		display: flex;
		flex-direction: column;
	}

	.article-meta {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		text-transform: uppercase;
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.5rem;
		color: var(--secondary-color);
	}

	.source {
		font-weight: 700;
		color: var(--accent-color);
	}

	.category-badge {
		background: rgba(0, 0, 0, 0.05);
		padding: 0.1rem 0.4rem;
		font-size: 0.75rem;
	}

	h2 {
		font-size: 1.6rem;
		margin: 0.25rem 0 0.75rem 0;
		line-height: 1.3;
	}

	h2 a {
		text-decoration: none;
		color: inherit;
	}

	h2 a:hover {
		color: var(--accent-color);
	}

	.summary {
		font-size: 1.05rem;
		line-height: 1.6;
		margin-bottom: 1rem;
		color: var(--text-color);
	}

	.benchmark-highlight {
		background: rgba(180, 50, 50, 0.04);
		border-left: 3px solid var(--accent-color);
		padding: 0.5rem 0.75rem;
		font-size: 0.85rem;
		margin-bottom: 1rem;
		font-family: var(--font-mono);
	}

	.card-footer {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 1rem;
		margin-top: auto;
	}

	.tags {
		display: flex;
		gap: 0.4rem;
		flex-wrap: wrap;
	}

	.tag {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--secondary-color);
	}

	/* Kaynağa git: kutusuz, minik, sade yazı stili */
	.source-text-link {
		font-size: 0.8rem;
		color: var(--secondary-color);
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.source-text-link:hover {
		color: var(--accent-color);
		text-decoration: underline;
	}

	/* Sayfalama Stilleri */
	.pagination-bar {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 0.75rem;
		margin-top: 3.5rem;
		padding: 1.5rem 0;
		border-top: 1px solid var(--border-color);
	}

	.page-nav-btn {
		background: none;
		border: 1px solid var(--border-color);
		padding: 0.45rem 0.9rem;
		font-family: var(--font-mono);
		font-size: 0.85rem;
		cursor: pointer;
		color: var(--text-color);
		transition: all 0.15s ease;
	}

	.page-nav-btn:disabled {
		opacity: 0.35;
		cursor: not-allowed;
	}

	.page-nav-btn:not(:disabled):hover {
		background: var(--text-color);
		color: var(--bg-color);
	}

	.page-numbers {
		display: flex;
		gap: 0.4rem;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
	}

	:global(.page-gap) {
		font-family: var(--font-mono);
		color: var(--text-muted);
		padding: 0 0.15rem;
	}

	:global(.page-num-btn) {
		background: none;
		border: 1px solid var(--border-color);
		width: 36px;
		height: 36px;
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-mono);
		font-size: 0.85rem;
		cursor: pointer;
		color: var(--text-color);
		transition: all 0.15s ease;
	}

	:global(.page-num-btn:hover) {
		border-color: var(--text-color);
	}

	:global(.page-num-btn.active) {
		background: var(--accent-color);
		border-color: var(--accent-color);
		color: #ffffff;
		font-weight: 600;
	}

	@media (max-width: 768px) {
		/* Mobilde kategoriler tek satırda yatay kaydırılır */
		.category-bar {
			flex-wrap: nowrap;
			overflow-x: auto;
		}
		.pagination-bar {
			flex-wrap: wrap;
			gap: 0.5rem;
		}
		.article-card {
			flex-direction: column;
		}
		.card-image {
			width: 100%;
			height: 200px;
		}
	}
</style>

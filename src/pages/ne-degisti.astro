---
import Layout from '../layouts/Layout.astro';
import { loadArticles, sourceLabel } from '../lib/articles';
import { newsCategoryName } from '../lib/categories';

const TYPES = ['model-cikisi', 'guncelleme', 'fiyat-limit'];
const articles = loadArticles().filter(a => TYPES.includes(a.kategori));

// Günlere göre grupla (İstanbul saatiyle)
const dayKey = (d: string) => new Date(d).toLocaleDateString('en-CA', { timeZone: 'Europe/Istanbul' });
const groups: { key: string; label: string; items: any[] }[] = [];
for (const a of articles) {
	const key = dayKey(a.date);
	let g = groups.find(x => x.key === key);
	if (!g) {
		g = { key, label: new Date(a.date).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', weekday: 'long', timeZone: 'Europe/Istanbul' }), items: [] };
		groups.push(g);
	}
	g.items.push(a);
}
const counts = TYPES.map(t => ({ id: t, name: newsCategoryName(t), count: articles.filter(a => a.kategori === t).length })).filter(t => t.count > 0);
---

<Layout title="Ne Değişti? | Yöney" description="Yapay zekâ modellerindeki yeni sürümler, güncellemeler, fiyat ve limit değişiklikleri: gün gün zaman tüneli.">
	<div class="changelog">
		<header class="page-head">
			<p class="kicker">Zaman tüneli</p>
			<h1>Ne değişti?</h1>
			<p class="lead">Yeni modeller, sürüm güncellemeleri, fiyat ve limit değişiklikleri; gün gün, tek bakışta.</p>
		</header>

		{articles.length === 0 ? (
			<p class="empty">Henüz sürüm güncellemesi veya fiyat değişikliği haberi bulunmuyor. Yeni duyurular geldikçe buraya eklenecek.</p>
		) : (
			<>
				<div class="chips filters" role="toolbar" aria-label="Türe göre süz">
					<button class="chip-btn" type="button" data-type="all" aria-pressed="true">Tümü <span class="count">{articles.length}</span></button>
					{counts.map(c => (
						<button class="chip-btn" type="button" data-type={c.id} aria-pressed="false"><span class="cat" data-cat={c.id}></span>{c.name} <span class="count">{c.count}</span></button>
					))}
				</div>

				<div class="timeline">
					{groups.map(g => (
						<section class="day" data-day>
							<h2 class="day-label">{g.label}</h2>
							<ol class="day-items">
								{g.items.map(a => (
									<li class="tl-item" data-type={a.kategori}>
										<span class="tl-dot" data-cat={a.kategori} aria-hidden="true"></span>
										<article class="tl-card">
											<div class="tl-meta">
												<span class="cat" data-cat={a.kategori}>{newsCategoryName(a.kategori)}</span>
												<span class="muted" lang="en">{sourceLabel(a.source)}</span>
											</div>
											<h3><a href={`/haber/${a.slug}`}>{a.baslik_tr}</a></h3>
											<p>{a.ozet_tr}</p>
											{a.onemli_maddeler && a.onemli_maddeler.length > 0 && (
												<ul class="points">
													{a.onemli_maddeler.slice(0, 3).map((p: string) => <li>{p}</li>)}
												</ul>
											)}
										</article>
									</li>
								))}
							</ol>
						</section>
					))}
				</div>
			</>
		)}
	</div>
</Layout>

<script>
	const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.filters .chip-btn'));
	const items = Array.from(document.querySelectorAll<HTMLElement>('.tl-item'));
	const days = Array.from(document.querySelectorAll<HTMLElement>('[data-day]'));

	chips.forEach(chip => chip.addEventListener('click', () => {
		const type = chip.dataset.type || 'all';
		chips.forEach(c => c.setAttribute('aria-pressed', String(c === chip)));
		items.forEach(i => { i.hidden = type !== 'all' && i.dataset.type !== type; });
		days.forEach(d => { d.hidden = !d.querySelector('.tl-item:not([hidden])'); });
	}));
</script>

<style>
	.changelog {
		max-width: 820px;
		margin: 0 auto;
	}

	.filters {
		margin-bottom: 32px;
	}

	.filters .cat {
		gap: 0;
	}

	.day + .day {
		margin-top: 36px;
	}

	.day-label {
		position: sticky;
		top: calc(var(--header-h) + 8px);
		z-index: 5;
		display: inline-block;
		margin: 0 0 16px;
		padding: 5px 12px;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: var(--surface);
		color: var(--text-2);
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0;
		box-shadow: var(--shadow-sm);
	}

	.day-items {
		list-style: none;
		margin: 0;
		padding: 0 0 0 28px;
		position: relative;
		display: grid;
		gap: 14px;
	}

	/* Dikey çizgi */
	.day-items::before {
		content: '';
		position: absolute;
		top: 8px;
		bottom: 8px;
		left: 7px;
		width: 2px;
		border-radius: 2px;
		background: var(--border);
	}

	.tl-item {
		position: relative;
	}

	.tl-dot {
		position: absolute;
		top: 22px;
		left: -27px;
		width: 14px;
		height: 14px;
		border: 3px solid var(--bg);
		border-radius: 50%;
		background: var(--c, var(--accent));
		box-shadow: 0 0 0 1px color-mix(in srgb, var(--c, var(--accent)) 50%, transparent);
	}

	.tl-card {
		padding: 18px 20px;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
		transition: border-color 0.15s, box-shadow 0.15s;
	}

	.tl-card:hover {
		border-color: var(--border-strong);
		box-shadow: var(--shadow-md);
	}

	.tl-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 6px 14px;
		margin-bottom: 8px;
		font-size: 0.8rem;
	}

	.tl-card h3 {
		margin: 0 0 8px;
		font-size: 1.15rem;
		letter-spacing: -0.02em;
		line-height: 1.35;
	}

	.tl-card h3 a {
		color: var(--text);
		text-decoration: none;
	}

	.tl-card h3 a:hover {
		color: var(--accent-text);
	}

	.tl-card p {
		margin: 0;
		color: var(--text-2);
		font-size: 0.95rem;
	}

	.points {
		margin: 12px 0 0;
		padding: 12px 0 0 1.1rem;
		border-top: 1px solid var(--border);
		color: var(--text-2);
		font-size: 0.9rem;
	}

	.points li + li {
		margin-top: 4px;
	}

	.points li::marker {
		color: var(--muted);
	}

	@media (max-width: 640px) {
		.day-items {
			padding-left: 22px;
		}
		.day-items::before {
			left: 5px;
		}
		.tl-dot {
			left: -22px;
		}
		.tl-card {
			padding: 16px;
		}
	}
</style>

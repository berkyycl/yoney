---
import Layout from '../layouts/Layout.astro';
import { loadArticles, sourceLabel } from '../lib/articles';
import { getCategory } from '../lib/categories';

const TYPES = ['model-cikisi', 'guncelleme', 'fiyat-limit'];
const articles = loadArticles().filter(a => TYPES.includes(a.kategori));

// Günlere göre grupla (İstanbul saatiyle)
const TZ = 'Europe/Istanbul';
const groups: { key: string; day: string; month: string; weekday: string; items: any[] }[] = [];
for (const a of articles) {
	const d = new Date(a.date);
	const key = d.toLocaleDateString('en-CA', { timeZone: TZ });
	let g = groups.find(x => x.key === key);
	if (!g) {
		g = {
			key,
			day: d.toLocaleDateString('tr-TR', { day: 'numeric', timeZone: TZ }),
			month: d.toLocaleDateString('tr-TR', { month: 'long', timeZone: TZ }),
			weekday: d.toLocaleDateString('tr-TR', { weekday: 'long', timeZone: TZ }),
			items: [],
		};
		groups.push(g);
	}
	g.items.push(a);
}
const counts = TYPES.map(t => ({ c: getCategory(t), count: articles.filter(a => a.kategori === t).length })).filter(t => t.count > 0);
---

<Layout title="Ne Değişti? | Yöney" description="Yapay zekâ modellerindeki yeni sürümler, güncellemeler, fiyat ve limit değişiklikleri: gün gün zaman çizelgesi." palette="mercan">
	<div class="changelog">
		<header class="page-head">
			<p class="overline">Zaman çizelgesi</p>
			<h1>Ne <em>değişti?</em></h1>
			<p class="lead">Yeni modeller, sürüm güncellemeleri, fiyat ve limit değişiklikleri; gün gün, tek bakışta.</p>
		</header>

		{articles.length === 0 ? (
			<p class="empty">Henüz sürüm güncellemesi veya fiyat değişikliği haberi bulunmuyor. Yeni duyurular geldikçe buraya eklenecek.</p>
		) : (
			<>
				<div class="chips filters" role="toolbar" aria-label="Türe göre süz">
					<button class="chip-btn" type="button" data-type="all" aria-pressed="true">Tümü <span class="count">{articles.length}</span></button>
					{counts.map(({ c, count }) => (
						<button class="chip-btn" type="button" data-type={c.id} data-cat={c.id} aria-pressed="false"><span class="swatch"></span>{c.name} <span class="count">{count}</span></button>
					))}
				</div>

				<div class="days">
					{groups.map(g => (
						<section class="day" data-day>
							<h2 class="day-label">
								<span class="day-num">{g.day}</span>
								<span class="day-rest">{g.month}<small>{g.weekday}</small></span>
							</h2>
							<ol class="day-items">
								{g.items.map((a, i) => {
									const c = getCategory(a.kategori);
									return (
										<li class="entry pose" data-type={c.id} data-cat={c.id} style={`--delay:${(i % 4) * 0.06}s`}>
											<div class="entry-meta">
												<a class="chip" href={`/kategori/${c.id}`} data-cat={c.id}><span><span class="num">{c.numeral}</span> {c.name}</span></a>
												<span class="muted" lang="en">{sourceLabel(a.source)}</span>
											</div>
											<h3><a href={`/haber/${a.slug}`}>{a.baslik_tr}</a></h3>
											<p>{a.ozet_tr}</p>
											{a.onemli_maddeler && a.onemli_maddeler.length > 0 && (
												<ul class="points">
													{a.onemli_maddeler.slice(0, 3).map((p: string) => <li>{p}</li>)}
												</ul>
											)}
										</li>
									);
								})}
							</ol>
						</section>
					))}
				</div>
			</>
		)}
	</div>
</Layout>

<script>
	const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.filters .chip-btn'));
	const items = Array.from(document.querySelectorAll<HTMLElement>('.entry'));
	const days = Array.from(document.querySelectorAll<HTMLElement>('[data-day]'));

	chips.forEach(chip => chip.addEventListener('click', () => {
		const type = chip.dataset.type || 'all';
		chips.forEach(c => c.setAttribute('aria-pressed', String(c === chip)));
		items.forEach(i => { i.hidden = type !== 'all' && i.dataset.type !== type; });
		days.forEach(d => { d.hidden = !d.querySelector('.entry:not([hidden])'); });
	}));
</script>

<style>
	.changelog {
		max-width: 1000px;
		margin: 0 auto;
	}

	.filters {
		margin-bottom: 52px;
	}

	.day {
		display: grid;
		grid-template-columns: 170px minmax(0, 1fr);
		gap: 36px;
		padding-top: 26px;
		border-top: 3px solid var(--line);
	}

	.day + .day {
		margin-top: 52px;
	}

	.day-label {
		position: sticky;
		top: calc(var(--header-h) + 24px);
		align-self: start;
		display: flex;
		align-items: flex-start;
		gap: 10px;
		margin: 0;
	}

	.day-num {
		font-size: 5rem;
		line-height: 0.8;
		color: var(--a1);
		text-shadow: 5px 5px 0 var(--a2);
	}

	.day-rest {
		display: flex;
		flex-direction: column;
		padding-top: 2px;
		font-family: var(--font-serif);
		font-size: 1.2rem;
		font-style: italic;
		font-weight: 800;
		line-height: 1.1;
		text-transform: none;
	}

	.day-rest small {
		margin-top: 6px;
		color: var(--muted);
		font-family: var(--font-sans);
		font-size: 0.66rem;
		font-style: normal;
		font-weight: 900;
		font-stretch: 80%;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.day-items {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 22px;
	}

	.entry {
		padding: 22px 24px;
		background: var(--surface);
		border: 2px solid var(--line);
		box-shadow: 8px 8px 0 var(--c);
		transition: transform 0.3s var(--ease-pose);
	}

	.entry:hover {
		transform: translate(-3px, -3px) rotate(-0.4deg);
	}

	.entry-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 6px 14px;
		margin-bottom: 12px;
		font-size: 0.78rem;
	}

	.entry h3 {
		margin: 0 0 10px;
		font-size: 1.65rem;
		line-height: 1.02;
	}

	.entry h3 a {
		color: var(--text);
		text-decoration: none;
	}

	.entry h3 a:hover {
		color: var(--a1);
	}

	.entry p {
		margin: 0;
		color: var(--text-2);
	}

	.points {
		margin: 14px 0 0;
		padding: 14px 0 0 1.1rem;
		border-top: 1px solid var(--rule);
		color: var(--text-2);
		font-size: 0.92rem;
	}

	.points li + li {
		margin-top: 5px;
	}

	.points li::marker {
		color: var(--c);
	}

	@media (max-width: 720px) {
		.day {
			grid-template-columns: 1fr;
			gap: 18px;
		}
		.day-label {
			position: static;
		}
		.day-num {
			font-size: 3.6rem;
		}
		.entry {
			padding: 18px;
			box-shadow: 6px 6px 0 var(--c);
		}
		.entry h3 {
			font-size: 1.35rem;
		}
	}
</style>

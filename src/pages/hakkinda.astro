---
import Layout from '../layouts/Layout.astro';

const FEATURES = [
	{
		t: 'Gelişmeleri takip ve analiz',
		d: 'Yeni model duyurularını, araştırma raporlarını ve teknik güncellemeleri düzenli olarak tarıyor, kapsamlı ve anlaşılır Türkçe içeriklere dönüştürüyoruz.',
	},
	{
		t: 'Doğrulanmış benchmarklar',
		d: 'Modellere ait resmi performans skorlarını ayıklayıp sıralamalar, parametre kartları ve yan yana karşılaştırmalar halinde sunuyoruz.',
	},
	{
		t: 'Sektörel etki',
		d: 'Her gelişmenin geliştiricilere, işletmelere ve kullanıcılara olası etkisini tarafsız bir bakışla yorumluyoruz.',
	},
];

const DONTS = [
	'Kendi benchmark testlerimizi üretmiyoruz; yalnızca doğrulanabilir ve resmi olarak yayımlanmış verileri kaynak göstererek derliyoruz.',
	'Spekülatif, doğrulanmamış veya tık tuzağı başlıklara yer vermiyoruz.',
	'Hiçbir şirketi ya da modeli öne çıkarmıyor; tüm gelişmelere eşit ve tarafsız yaklaşıyoruz.',
];
---

<Layout title="Hakkında | Yöney" palette="menekse">
	<div class="about">
		<header class="page-head">
			<p class="overline">Hakkında</p>
			<h1>Yapay zekâ gündemi, <em>tek yerde</em></h1>
		</header>

		<p class="manifesto pose">Yöney; yapay zekâ dünyasındaki önemli gelişmeleri, model çıkışlarını ve teknik ilerlemeleri tek bir yerden takip etmeyi sağlayan bağımsız ve güncel bir bilgi platformudur. Renkleri sahneye göre değişir; haberleri ise kaynağına sadık kalır.</p>

		<section>
			<div class="section-head">
				<span class="sec-num">01</span>
				<h2>Ne yapıyoruz?</h2>
				<span class="sec-line" aria-hidden="true"></span>
			</div>
			<div class="features">
				{FEATURES.map((f, i) => (
					<div class="feature pose" style={`--delay:${i * 0.08}s`}>
						<span class="feature-num">{['I', 'II', 'III'][i]}</span>
						<h3>{f.t}</h3>
						<p>{f.d}</p>
					</div>
				))}
			</div>
		</section>

		<section>
			<div class="section-head">
				<span class="sec-num">02</span>
				<h2>Ne yapmıyoruz?</h2>
				<span class="sec-line" aria-hidden="true"></span>
			</div>
			<ul class="donts">
				{DONTS.map(d => <li class="pose">{d}</li>)}
			</ul>
		</section>

		<section class="disclaimer">
			<h2>Sorumluluk reddi</h2>
			<p>Yöney üzerindeki içerikler ve teknik analizler yalnızca bilgilendirme amaçlıdır; yatırım, ticari veya teknik danışmanlık niteliği taşımaz. En güncel teknik detaylar ve kararlar için daima orijinal belgelere başvurulması önerilir.</p>
		</section>
	</div>
</Layout>

<style>
	.about {
		max-width: 1000px;
		margin: 0 auto;
	}

	.manifesto {
		margin: 0 0 80px;
		padding: 34px 36px;
		background: var(--a1);
		color: var(--on-a1);
		border: 3px solid var(--line);
		box-shadow: 14px 14px 0 var(--a2);
		font-family: var(--font-serif);
		font-size: clamp(1.4rem, 2.8vw, 2rem);
		font-style: italic;
		font-weight: 700;
		line-height: 1.35;
		transform: rotate(-1deg);
	}

	section {
		margin-bottom: 72px;
	}

	.features {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 24px;
	}

	.feature {
		padding: 24px;
		background: var(--surface);
		border: 2px solid var(--line);
		box-shadow: 8px 8px 0 var(--a3);
	}

	.feature-num {
		display: block;
		margin-bottom: 12px;
		color: var(--a2);
		font-family: var(--font-serif);
		font-size: 3rem;
		font-style: italic;
		font-weight: 900;
		line-height: 1;
	}

	.feature h3 {
		margin-bottom: 10px;
		font-size: 1.6rem;
		text-transform: uppercase;
	}

	.feature p {
		margin: 0;
		color: var(--text-2);
		font-size: 0.95rem;
		line-height: 1.6;
	}

	.donts {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 14px;
	}

	.donts li {
		display: grid;
		grid-template-columns: 3rem minmax(0, 1fr);
		align-items: center;
		padding: 18px 20px;
		background: var(--surface);
		border: 2px solid var(--line);
		color: var(--text-2);
		font-size: 1.02rem;
		line-height: 1.6;
	}

	.donts li::before {
		content: '✕';
		color: var(--a2);
		font-family: var(--font-display);
		font-size: 1.8rem;
	}

	.disclaimer {
		padding: 26px 28px;
		border: 2px dashed var(--line);
	}

	.disclaimer h2 {
		margin-bottom: 8px;
		font-size: 1.6rem;
		text-transform: uppercase;
	}

	.disclaimer p {
		margin: 0;
		color: var(--text-2);
		font-size: 0.95rem;
		line-height: 1.6;
	}

	@media (max-width: 760px) {
		.features {
			grid-template-columns: 1fr;
		}
		.manifesto {
			padding: 24px 22px;
			transform: none;
		}
	}
</style>

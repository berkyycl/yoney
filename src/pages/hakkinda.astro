---
import Layout from '../layouts/Layout.astro';
import ArtBanner from '../components/ArtBanner.astro';

const FEATURES = [
	{
		t: 'Gelişmeleri takip ve analiz',
		d: 'Yeni model duyurularını, araştırma raporlarını ve teknik güncellemeleri düzenli olarak tarıyor, kapsamlı ve anlaşılır Türkçe içeriklere dönüştürüyoruz.',
	},
	{
		t: 'Doğrulanmış benchmarklar',
		d: 'Modellere ait resmi performans skorlarını ayıklayıp sıralamalar ve yan yana karşılaştırmalar halinde sunuyoruz.',
	},
	{
		t: 'Sektörel etki',
		d: 'Her gelişmenin geliştiricilere, işletmelere ve kullanıcılara olası etkisini tarafsız bir bakışla yorumluyoruz.',
	},
];

const DONTS = [
	'Kendi benchmark testlerimizi üretmiyoruz; yalnızca doğrulanabilir ve resmi olarak yayımlanmış verileri kaynak göstererek derliyoruz.',
	'Spekülatif, doğrulanmamış veya tık tuzağı başlıklara yer vermiyoruz.',
	'Hiçbir şirketi ya da modeli öne çıkarmıyor; tüm gelişmelere eşit ve tarafsız yaklaşıyoruz.',
];
---

<Layout title="Hakkında | Yöney">
	<div class="about">
		<header class="page-head">
			<p class="overline">Hakkında</p>
			<h1>Yapay zekâ gündemi, <em>tek yerde ve Türkçe.</em></h1>
		</header>

		<p class="manifesto">Yöney; yapay zekâ dünyasındaki önemli gelişmeleri, model çıkışlarını ve teknik ilerlemeleri tek bir yerden takip etmeyi sağlayan bağımsız ve güncel bir bilgi platformudur.</p>

		<section>
			<div class="section-head">
				<span class="sec-num">01</span>
				<h2>Ne yapıyoruz?</h2>
			</div>
			<div class="features">
				{FEATURES.map((f, i) => (
					<div class="feature">
						<span class="feature-num">{['I', 'II', 'III'][i]}</span>
						<h3>{f.t}</h3>
						<p>{f.d}</p>
					</div>
				))}
			</div>
		</section>

		<section>
			<div class="section-head">
				<span class="sec-num">02</span>
				<h2>Ne yapmıyoruz?</h2>
			</div>
			<ul class="donts">
				{DONTS.map(d => <li>{d}</li>)}
			</ul>
		</section>

		<ArtBanner height={120}>
			<p class="disclaimer"><strong>Sorumluluk reddi.</strong> Yöney üzerindeki içerikler ve teknik analizler yalnızca bilgilendirme amaçlıdır; yatırım, ticari veya teknik danışmanlık niteliği taşımaz. En güncel teknik detaylar ve kararlar için daima orijinal belgelere başvurulması önerilir.</p>
		</ArtBanner>
	</div>
</Layout>

<style>
	.about {
		max-width: 960px;
		margin: 0 auto;
	}

	.manifesto {
		margin: 0 0 64px;
		padding: 28px 0;
		border-top: 3px solid var(--line);
		border-bottom: 1px solid var(--rule-strong);
		font-family: var(--font-display);
		font-size: clamp(1.4rem, 2.8vw, 2rem);
		font-style: italic;
		font-weight: 600;
		line-height: 1.35;
	}

	section {
		margin-bottom: 56px;
	}

	.features {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.feature {
		padding: 0 24px;
		border-left: 1px solid var(--rule-strong);
	}

	.feature:first-child {
		padding-left: 0;
		border-left: 0;
	}

	.feature-num {
		display: block;
		margin-bottom: 10px;
		color: var(--magenta);
		font-family: var(--font-display);
		font-size: 2.6rem;
		font-style: italic;
		font-weight: 900;
		line-height: 1;
	}

	.feature h3 {
		margin-bottom: 8px;
		font-size: 1.25rem;
	}

	.feature p {
		margin: 0;
		color: var(--ink-2);
		font-size: 0.95rem;
		line-height: 1.6;
	}

	.donts {
		list-style: none;
		margin: 0;
		padding: 0;
		counter-reset: d;
	}

	.donts li {
		counter-increment: d;
		display: grid;
		grid-template-columns: 2.6rem minmax(0, 1fr);
		padding: 16px 0;
		border-bottom: 1px solid var(--rule);
		color: var(--ink-2);
		font-size: 1.02rem;
		line-height: 1.6;
	}

	.donts li::before {
		content: '✕';
		color: var(--crimson);
		font-weight: 900;
	}

	.disclaimer {
		max-width: 70ch;
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.6;
	}

	@media (max-width: 760px) {
		.features {
			grid-template-columns: 1fr;
			gap: 28px;
		}
		.feature {
			padding: 0;
			border-left: 0;
		}
	}
</style>

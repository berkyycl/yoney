---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sayfa bulunamadı | Yöney" palette="gece">
	<div class="nf">
		<p class="code" aria-hidden="true"><span>4</span><span>0</span><span>4</span></p>
		<h1>Bu sayfa bulunamadı</h1>
		<p class="lead">Aradığınız haber kaldırılmış ya da adresi değişmiş olabilir. Gündem ise yerinde duruyor.</p>
		<div class="actions">
			<a class="btn btn-fill" href="/">Haberlere dön</a>
			<a class="btn" href="/kategori">Bölümler</a>
		</div>
	</div>
</Layout>

<style>
	.nf {
		max-width: 760px;
		margin: 20px auto 40px;
		text-align: center;
	}

	.code {
		display: flex;
		justify-content: center;
		gap: 0.04em;
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(7rem, 26vw, 15rem);
		line-height: 0.9;
		transform: skewX(-8deg);
	}

	.code span {
		display: inline-block;
		color: var(--a1);
		text-shadow: 8px 8px 0 var(--a2);
		animation: wobble 2.6s var(--ease-pose) infinite alternate;
	}

	.code span:nth-child(2) {
		color: var(--a3);
		animation-delay: 0.2s;
	}

	.code span:nth-child(3) {
		animation-delay: 0.4s;
	}

	@keyframes wobble {
		from { transform: rotate(-4deg) translateY(4px); }
		to { transform: rotate(4deg) translateY(-8px); }
	}

	h1 {
		margin: 30px 0 12px;
		font-size: clamp(2.2rem, 6vw, 3.6rem);
		text-transform: uppercase;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 16px;
		margin-top: 32px;
	}
</style>

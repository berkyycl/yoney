---
import Layout from '../layouts/Layout.astro';
import ArtBanner from '../components/ArtBanner.astro';
---

<Layout title="Sayfa bulunamadı | Yöney">
	<div class="nf">
		<ArtBanner height={220}>
			<p class="code">404</p>
		</ArtBanner>
		<h1>Bu sayfa bulunamadı</h1>
		<p class="lead">Aradığınız haber kaldırılmış ya da adresi değişmiş olabilir. Gündem ise yerinde duruyor.</p>
		<div class="actions">
			<a class="btn btn-solid" href="/">Haberlere dön</a>
			<a class="btn" href="/kategori">Bölümler</a>
		</div>
	</div>
</Layout>

<style>
	.nf {
		max-width: 760px;
		margin: 0 auto;
		text-align: center;
	}

	.code {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(5rem, 16vw, 9rem);
		font-style: italic;
		font-weight: 900;
		line-height: 0.9;
	}

	h1 {
		margin: 40px 0 12px;
		font-size: clamp(2rem, 5vw, 3rem);
		font-weight: 900;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 12px;
		margin-top: 28px;
	}
</style>

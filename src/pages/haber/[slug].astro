---
import Layout from '../../layouts/Layout.astro';
import Story from '../../components/Story.astro';
import Art from '../../components/Art.astro';
import StandCard from '../../components/StandCard.astro';
import { loadArticles, sourceLabel } from '../../lib/articles';
import { loadBenchmarkData } from '../../lib/benchmarks';
import { buildStands, standsForNames } from '../../lib/stands';
import { categoryOf, getCategory, tierName } from '../../lib/categories';
import { categoryPalette } from '../../lib/palettes';

export async function getStaticPaths() {
    return loadArticles().map(article => ({
        params: { slug: article.slug },
        props: { article }
    }));
}

const { article } = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": article.baslik_tr,
  "description": article.ozet_tr,
  "image": article.gorsel_url ? [article.gorsel_url] : [],
  "datePublished": article.date,
  "dateModified": article.date,
  "author": {
    "@type": "Organization",
    "name": article.source || "Yöney"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Yöney",
    "logo": {
      "@type": "ImageObject",
      "url": "https://yoney.dev/favicon.svg"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://yoney.dev/haber/${article.slug}`
  }
};

const cat = getCategory(categoryOf(article));
const dateStr = new Date(article.date).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Istanbul' });
const paragraphs: string[] = (article.detayli_icerik_tr ?? '').split(/\n+/).map((p: string) => p.trim()).filter(Boolean);
const points: string[] = article.onemli_maddeler ?? [];
const words = [article.ozet_tr, ...paragraphs, ...points].join(' ').split(/\s+/).filter(Boolean).length;
const readMin = Math.max(1, Math.round(words / 200));
const source = sourceLabel(article.source);

// Haberde adı geçen modellerin parametre kartları
const stands = standsForNames([...(article.anilan_modeller ?? []), ...(article.benchmarklar ?? []).map((b: any) => b.model)], buildStands(loadBenchmarkData().entries), 2);

// Skorlar: yüzdeler 100 üzerinden, diğerleri aynı birimdeki en yüksek skora göre çizilir
const scores: any[] = article.benchmarklar ?? [];
const maxByUnit = new Map<string, number>();
for (const b of scores) maxByUnit.set(b.birim ?? '', Math.max(maxByUnit.get(b.birim ?? '') ?? 0, Number(b.skor) || 0));
const scoreRows = scores.map(b => {
	const v = Number(b.skor) || 0;
	const max = b.birim === '%' ? 100 : maxByUnit.get(b.birim ?? '') || 1;
	return { ...b, w: Math.max(2, Math.min(100, (v / max) * 100)), label: b.birim === '%' ? `%${b.skor}` : `${b.skor}${b.birim ? ` ${b.birim}` : ''}` };
});

// Aynı bölümden en yeni 3 haber, yetmezse en yeni haberlerle tamamlanır
const others = loadArticles().filter(a => a.slug !== article.slug);
const related = others.filter(a => categoryOf(a) === cat.id).slice(0, 3);
for (const a of others) {
	if (related.length >= 3) break;
	if (!related.includes(a)) related.push(a);
}
---

<Layout
	title={`${article.baslik_tr} | Yöney`}
	description={article.ozet_tr}
	image={article.gorsel_url}
	type="article"
	articleDate={article.date}
 palette={categoryPalette(cat.id)}>
	<script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />

	<div class="progress" data-progress=".post" aria-hidden="true">
		<span class="progress-bar"></span>
		<svg class="progress-head" viewBox="0 0 30 30"><path d="M3 15h20M16 8l8 7-8 7" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="square" /></svg>
	</div>

	<article class="post" data-cat={cat.id}>
		<nav class="crumbs" aria-label="Konum">
			<a href="/">Haberler</a>
			<span aria-hidden="true">/</span>
			<a href={`/kategori/${cat.id}`}>Bölüm {cat.numeral} · {cat.name}</a>
		</nav>

		<header class="post-head">
			<div class="post-labels">
				<a class="chip" href={`/kategori/${cat.id}`} data-cat={cat.id}><span><span class="num">{cat.numeral}</span> {cat.name}</span></a>
				<span class="tier">{tierName(article.sourceTier)}</span>
			</div>
			<h1>{article.baslik_tr}</h1>
			<p class="deck post-deck">{article.ozet_tr}</p>
			<div class="byline">
				<p>
					<strong lang="en">{source}</strong> kaynağından derlendi
					<span class="muted"> · <time datetime={article.date}>{dateStr}</time> · {readMin} dk okuma</span>
				</p>
				<a class="btn btn-fill" href={article.url} target="_blank" rel="noopener noreferrer">Orijinal haber ↗</a>
			</div>
		</header>

		<figure class="post-hero">
			<div class="post-hero-media poster reveal-color tilt">
				<Art cat={cat.id} seed={article.slug} />
				{article.gorsel_url && (
					<>
						<img class="img-true" src={article.gorsel_url} alt="" referrerpolicy="no-referrer" onerror="this.parentElement.querySelectorAll('img').forEach(function(i){i.remove()})" />
						<img class="img-poster" src={article.gorsel_url} alt="" referrerpolicy="no-referrer" />
					</>
				)}
				<span class="shine"></span>
			</div>
			<figcaption>{article.gorsel_url ? <>Görsel: <span lang="en">{source}</span> · gerçek renkler için üstüne gelin</> : <>Bu haberin görseli yok; bölüm amblemi gösteriliyor.</>}</figcaption>
		</figure>

		{points.length > 0 && (
			<section class="takeaways" aria-labelledby="ozetle">
				<h2 id="ozetle" class="post-subhead">Özetle</h2>
				<ol>
					{points.map((m, i) => <li class="pose" style={`--delay:${i * 0.08}s`}><span class="tk-num">{i + 1}</span><p>{m}</p></li>)}
				</ol>
			</section>
		)}

		<div class="post-grid">
			<div class="post-main">
				{paragraphs.length > 0 && (
					<div class="prose">
						{paragraphs.map(p => <p>{p}</p>)}
					</div>
				)}

				{article.yorum_tr && (
					<blockquote class="verdict pose">
						<p class="verdict-label">Yöney yorumu</p>
						<p class="verdict-text">{article.yorum_tr}</p>
						<footer>Yapay zekâ tarafından üretilmiştir.</footer>
					</blockquote>
				)}

				{scoreRows.length > 0 && (
					<section class="scores" aria-labelledby="skorlar">
						<h2 id="skorlar" class="post-subhead">Haberdeki skorlar</h2>
						<p class="scores-note">Bu skorların kaynak metinde birebir geçtiği doğrulandı. Bilinen testlerin sonuçları <a href="/benchmarklar">Benchmark</a> sıralamalarına da eklenir.</p>
						<ul class="score-list">
							{scoreRows.map((r, i) => (
								<li class="pose" style={`--delay:${(i % 6) * 0.05}s`}>
									<div class="score-label">
										<strong>{r.model}</strong>
										<span>{r.benchmark}{r.degerlendirme_ayari ? ` · ${r.degerlendirme_ayari}` : ''}</span>
									</div>
									<div class="score-track"><span class="score-bar" style={`--w:${r.w.toFixed(1)}%`}></span></div>
									<span class="score-val">{r.label}</span>
								</li>
							))}
						</ul>
					</section>
				)}
			</div>

			<aside class="post-aside">
				{stands.length > 0 && (
					<section class="aside-block">
						<h2 class="aside-title">Haberdeki modeller</h2>
						<p class="aside-note">LMArena sıralamalarına göre parametreler (A en iyi, ? veri yok).</p>
						{stands.map(s => <StandCard card={s} />)}
					</section>
				)}
				<a class="chapter-box" href={`/kategori/${cat.id}`} data-cat={cat.id}>
					<span class="chapter-box-num">{cat.numeral}</span>
					<span class="chapter-box-text">
						<small>Bölüm</small>
						<strong>{cat.name}</strong>
						<em>{cat.tagline}</em>
					</span>
				</a>
			</aside>
		</div>

		<div class="tbc-zone" id="tbc">
			<a class="tbc" href={article.url} target="_blank" rel="noopener noreferrer">
				<span class="tbc-arrow"><span>Devamı kaynakta</span></span>
			</a>
			<p class="tbc-note">Bu haber <strong lang="en">{source}</strong> kaynağından derlenip Türkçeye aktarıldı. Ayrıntılar ve orijinal metin için oka tıklayın.</p>
		</div>
	</article>

	{related.length > 0 && (
		<section class="related" aria-labelledby="relatedTitle">
			<div class="section-head">
				<span class="sec-num">{cat.numeral}</span>
				<h2 id="relatedTitle">Aynı bölümden</h2>
				<span class="sec-line" aria-hidden="true"></span>
				<a class="sec-more" href={`/kategori/${cat.id}`}>Tümü →</a>
			</div>
			<div class="related-grid">
				{related.map((a, i) => <Story article={a} variant="card" delay={i * 0.08} />)}
			</div>
		</section>
	)}
</Layout>

<script>
	// Sona gelince sahne donar: sepya filtre ve sola bakan "devamı kaynakta" oku içeri kayar
	const post = document.querySelector<HTMLElement>('.post');
	const zone = document.getElementById('tbc');
	if (post && zone && 'IntersectionObserver' in window) {
		new IntersectionObserver(([en]) => {
			post.classList.toggle('frozen', en.isIntersecting);
		}, { threshold: 0.6 }).observe(zone);
	}
</script>

<style>
	/* ---------- Okuma ilerlemesi: ilerleyen bir yöney ---------- */
	.progress {
		position: fixed;
		top: calc(var(--header-h) + 4px);
		left: 0;
		right: 0;
		z-index: 59;
		height: 6px;
		pointer-events: none;
	}

	.progress-bar {
		position: absolute;
		inset: 0;
		background: linear-gradient(90deg, var(--a3), var(--a1), var(--a2));
		transform: scaleX(var(--p, 0));
		transform-origin: left;
	}

	.progress-head {
		position: absolute;
		top: -12px;
		left: 0;
		width: 30px;
		height: 30px;
		color: var(--a2);
		transform: translateX(calc(var(--p, 0) * (100vw - 30px)));
		filter: drop-shadow(2px 2px 0 var(--shadow));
	}

	.post {
		max-width: 1140px;
		margin: 0 auto;
	}

	.crumbs {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 26px;
		font-size: 0.72rem;
		font-weight: 800;
		font-stretch: 80%;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.crumbs a {
		color: var(--text-2);
		text-decoration: none;
	}

	.crumbs a:hover {
		color: var(--a1);
	}

	.crumbs span {
		color: var(--muted);
	}

	/* ---------- Başlık ---------- */
	.post-head {
		max-width: 980px;
	}

	.post-labels {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 14px;
		margin-bottom: 20px;
	}

	.tier {
		color: var(--muted);
		font-size: 0.7rem;
		font-weight: 800;
		font-stretch: 80%;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0 0 20px;
		font-size: clamp(2.6rem, 6.4vw, 5.4rem);
		line-height: 0.93;
		text-transform: uppercase;
		transform: skewX(-5deg);
		transform-origin: left bottom;
		text-shadow: 5px 5px 0 var(--c);
		overflow-wrap: anywhere;
	}

	.post-deck {
		margin: 0 0 28px;
		color: var(--text-2);
		font-size: clamp(1.2rem, 2.1vw, 1.5rem);
		line-height: 1.45;
	}

	.byline {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 14px 24px;
		padding: 16px 0;
		border-top: 3px solid var(--line);
		border-bottom: 1px solid var(--rule);
	}

	.byline p {
		margin: 0;
		font-size: 0.95rem;
	}

	/* ---------- Kapak görseli ---------- */
	.post-hero {
		margin: 44px 16px 0 0;
	}

	.post-hero-media {
		aspect-ratio: 21 / 10;
		border: 3px solid var(--line);
		box-shadow: 16px 16px 0 var(--c);
	}

	.post-hero figcaption {
		margin-top: 26px;
		color: var(--muted);
		font-size: 0.78rem;
	}

	.post-subhead {
		margin: 0 0 20px;
		font-size: clamp(1.8rem, 3vw, 2.4rem);
		text-transform: uppercase;
	}

	/* ---------- Özetle ---------- */
	.takeaways {
		margin-top: 56px;
	}

	.takeaways ol {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 20px;
	}

	.takeaways li {
		position: relative;
		padding: 22px 22px 20px;
		background: var(--surface);
		border: 2px solid var(--line);
		box-shadow: 7px 7px 0 var(--c);
	}

	.takeaways li:nth-child(2) { box-shadow: 7px 7px 0 var(--a1); }
	.takeaways li:nth-child(3) { box-shadow: 7px 7px 0 var(--a3); }
	.takeaways li:nth-child(4) { box-shadow: 7px 7px 0 var(--a2); }

	.tk-num {
		display: block;
		margin-bottom: 8px;
		color: var(--c);
		font-family: var(--font-serif);
		font-size: 3rem;
		font-style: italic;
		font-weight: 900;
		line-height: 0.85;
	}

	.takeaways li p {
		margin: 0;
		font-size: 1rem;
		line-height: 1.5;
	}

	/* ---------- Gövde ---------- */
	.post-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 320px;
		gap: 64px;
		margin-top: 60px;
	}

	.prose {
		max-width: 68ch;
	}

	.prose p {
		margin: 0 0 1.4em;
		color: var(--text);
		font-size: 1.13rem;
		line-height: 1.8;
	}

	/* İlk harf: bölüm renginde, gölgeli dev harf */
	.prose p:first-child::first-letter {
		float: left;
		margin: 0.06em 0.12em 0 0;
		font-family: var(--font-display);
		font-size: 4.6em;
		line-height: 0.8;
		color: var(--c);
		text-shadow: 4px 4px 0 var(--shadow);
	}

	/* ---------- Yöney yorumu ---------- */
	.verdict {
		position: relative;
		margin: 48px 0;
		padding: 34px 32px 28px 92px;
		background: var(--a1);
		color: var(--on-a1);
		border: 3px solid var(--line);
		box-shadow: 10px 10px 0 var(--a2);
		transform: rotate(-0.8deg);
	}

	.verdict::before {
		content: '“';
		position: absolute;
		top: 2px;
		left: 18px;
		font-family: var(--font-serif);
		font-size: 7rem;
		font-weight: 900;
		line-height: 1;
	}

	.verdict-label {
		margin: 0 0 8px;
		font-size: 0.72rem;
		font-weight: 900;
		font-stretch: 80%;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.verdict-text {
		margin: 0 0 12px;
		font-family: var(--font-serif);
		font-size: 1.4rem;
		font-style: italic;
		font-weight: 600;
		line-height: 1.42;
	}

	.verdict footer {
		font-size: 0.78rem;
		opacity: 0.8;
	}

	/* ---------- Skorlar (çubuk grafik) ---------- */
	.scores {
		margin: 56px 0 0;
	}

	.scores-note {
		margin: -8px 0 20px;
		color: var(--muted);
		font-size: 0.9rem;
	}

	.score-list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 3px solid var(--line);
	}

	.score-list li {
		display: grid;
		grid-template-columns: minmax(0, 14rem) minmax(0, 1fr) 7.5rem;
		align-items: center;
		gap: 16px;
		padding: 14px 0;
		border-bottom: 1px solid var(--rule);
	}

	.score-label {
		display: flex;
		flex-direction: column;
		min-width: 0;
		line-height: 1.25;
	}

	.score-label strong {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.score-label span {
		color: var(--muted);
		font-size: 0.8rem;
	}

	.score-track {
		height: 16px;
		background: var(--rule);
	}

	.score-bar {
		display: block;
		width: var(--w);
		height: 100%;
		background: repeating-linear-gradient(-45deg, var(--c) 0 8px, color-mix(in srgb, var(--c) 70%, var(--bg)) 8px 12px);
		transform-origin: left;
	}

	.js .pose .score-bar {
		transform: scaleX(0);
	}

	.js .pose.in .score-bar {
		transform: none;
		transition: transform 1s var(--ease-pose) 0.2s;
	}

	.score-val {
		font-family: var(--font-display);
		font-size: 1.35rem;
		text-align: right;
		white-space: nowrap;
	}

	/* ---------- Yan sütun ---------- */
	.post-aside {
		display: flex;
		flex-direction: column;
		gap: 36px;
	}

	.aside-title {
		margin: 0 0 4px;
		font-size: 1.6rem;
		text-transform: uppercase;
	}

	.aside-note {
		margin: 0 0 18px;
		color: var(--muted);
		font-size: 0.82rem;
	}

	.aside-block :global(.stand-card + .stand-card) {
		margin-top: 28px;
		padding-top: 24px;
		border-top: 1px solid var(--rule);
	}

	.chapter-box {
		position: sticky;
		top: calc(var(--header-h) + 30px);
		display: flex;
		align-items: stretch;
		color: var(--c-on);
		text-decoration: none;
		background: var(--pat), var(--c);
		border: 2px solid var(--line);
		box-shadow: 7px 7px 0 var(--shadow);
		transition: transform 0.3s var(--ease-pose);
	}

	.chapter-box:hover {
		transform: rotate(-2deg) scale(1.02);
	}

	.chapter-box-num {
		display: grid;
		place-items: center;
		min-width: 72px;
		border-right: 2px solid var(--line);
		font-family: var(--font-serif);
		font-size: 2.2rem;
		font-style: italic;
		font-weight: 900;
	}

	.chapter-box-text {
		display: flex;
		flex-direction: column;
		padding: 14px 16px;
		line-height: 1.25;
	}

	.chapter-box-text small {
		font-size: 0.66rem;
		font-weight: 900;
		font-stretch: 80%;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.chapter-box-text strong {
		font-family: var(--font-display);
		font-size: 1.5rem;
		font-weight: 400;
		text-transform: uppercase;
	}

	.chapter-box-text em {
		font-family: var(--font-serif);
		font-size: 0.95rem;
	}

	/* ---------- "Devamı kaynakta" ---------- */
	.tbc-zone {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 22px 36px;
		margin-top: 72px;
		padding: 40px 0 20px;
		border-top: 3px solid var(--line);
		overflow: hidden;
	}

	.tbc {
		display: inline-flex;
		text-decoration: none;
		filter: drop-shadow(3px 0 0 var(--shadow)) drop-shadow(-3px 0 0 var(--shadow)) drop-shadow(0 3px 0 var(--shadow)) drop-shadow(0 -3px 0 var(--shadow)) drop-shadow(8px 8px 0 var(--a2));
		transition: transform 0.75s var(--ease-pose);
	}

	/* JS varsa ok, sona gelinene kadar soldan dışarıda bekler */
	:global(.js) .tbc {
		transform: translateX(-130%);
	}

	:global(.js) .post.frozen .tbc,
	:global(.js) .tbc:focus-visible {
		transform: none;
	}

	/* Sola bakan ok */
	.tbc-arrow {
		display: inline-flex;
		align-items: center;
		padding: 0.8em 1.6em 0.8em 3.2em;
		background: #e8c66a;
		color: #2b2111;
		font-family: var(--font-display);
		font-size: clamp(1.3rem, 2.6vw, 1.9rem);
		letter-spacing: 0.04em;
		text-transform: uppercase;
		clip-path: polygon(34px 0, 100% 0, 100% 100%, 34px 100%, 0 50%);
		transition: transform 0.25s ease;
	}

	.tbc:hover .tbc-arrow {
		transform: translateX(-6px);
	}

	.tbc-note {
		flex: 1 1 260px;
		margin: 0;
		color: var(--muted);
	}

	/* Sahne donarken: sepya baskı */
	.post-hero-media,
	.prose,
	.verdict,
	.takeaways {
		transition: filter 0.6s ease;
	}

	.post.frozen .post-hero-media,
	.post.frozen .prose,
	.post.frozen .verdict,
	.post.frozen .takeaways,
	.post.frozen .scores {
		filter: sepia(0.85) saturate(1.25) hue-rotate(-10deg) contrast(1.05);
	}

	/* ---------- Benzer haberler ---------- */
	.related {
		max-width: 1140px;
		margin: 100px auto 0;
	}


---
import Layout from '../../layouts/Layout.astro';
import { loadArticles } from '../../lib/articles';
import { newsCategoryName, tierName } from '../../lib/categories';

export async function getStaticPaths() {
    return loadArticles().map(article => ({
        params: { slug: article.slug },
        props: { article }
    }));
}

const { article } = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": article.baslik_tr,
  "description": article.ozet_tr,
  "image": article.gorsel_url ? [article.gorsel_url] : [],
  "datePublished": article.date,
  "dateModified": article.date,
  "author": {
    "@type": "Organization",
    "name": article.source || "Yöney"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Yöney",
    "logo": {
      "@type": "ImageObject",
      "url": "https://yoney.dev/favicon.svg"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://yoney.dev/haber/${article.slug}`
  }
};
---

<Layout 
	title={`${article.baslik_tr} | Yöney`}
	description={article.ozet_tr}
	image={article.gorsel_url}
	type="article"
	articleDate={article.date}
>
	<script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
	<article class="article-detail">
		<header>
			<div class="meta">
				<span class="source-tier">{tierName(article.sourceTier)}</span>
				<span class="source" lang="en">{article.source}</span>
				<span class="category">{newsCategoryName(article.kategori)}</span>
				<span class="date">{new Date(article.date).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
			</div>
			<h1>{article.baslik_tr}</h1>
		</header>
 
		<div class="content">
			{article.gorsel_url && (
				<div class="article-hero-image">
					<img src={article.gorsel_url} alt="" referrerpolicy="no-referrer" onerror="this.closest('.article-hero-image')?.remove()" />
				</div>
			)}

			<p class="summary">{article.ozet_tr}</p>

			{article.onemli_maddeler && article.onemli_maddeler.length > 0 && (
				<div class="key-points">
					<h3>Öne Çıkan Başlıklar</h3>
					<ul>
						{article.onemli_maddeler.map((m: string) => (
							<li>{m}</li>
						))}
					</ul>
				</div>
			)}

			{article.detayli_icerik_tr && (
				<div class="detailed-body">
					{article.detayli_icerik_tr.split(/\n+/).map((p: string) => p.trim()).filter(Boolean).map((paragraph: string) => (
						<p>{paragraph}</p>
					))}
				</div>
			)}

			{article.yorum_tr && (
				<div class="ai-comment">
					<h3>YZ Yorumu</h3>
					<p>{article.yorum_tr}</p>
					<small>Yapay zekâ tarafından üretilmiştir.</small>
				</div>
			)}

			{article.benchmarklar && article.benchmarklar.length > 0 && (
				<div class="benchmarks">
					<h3>Benchmark Sonuçları</h3>
					<p class="bench-note">Bu skorların kaynak metinde birebir geçtiği doğrulandı. Bilinen testlerin sonuçları <a href="/benchmarklar">Benchmarklar</a> sayfasındaki sıralamalara da eklenir.</p>
					<div class="table-scroll">
					<table>
						<thead>
							<tr>
								<th>Model</th>
								<th>Benchmark</th>
								<th>Skor</th>
								<th>Ayar</th>
							</tr>
						</thead>
						<tbody>
							{article.benchmarklar.map(b => (
								<tr>
									<td>{b.model}</td>
									<td>{b.benchmark}</td>
									<td class="score">{b.birim === '%' ? `%${b.skor}` : `${b.skor} ${b.birim ?? ''}`}</td>
									<td>{b.degerlendirme_ayari || '-'}</td>
								</tr>
							))}
						</tbody>
					</table>
					</div>
				</div>
			)}

			<div class="source-link-container">
				<a href={article.url} target="_blank" rel="noopener noreferrer" class="source-text-link">
					{article.source} kaynağında orijinal haberi incele ↗
				</a>
			</div>
		</div>
	</article>
</Layout>

<style>
	.article-detail {
		max-width: 800px;
		margin: 0 auto;
	}

	header {
		margin-bottom: 2rem;
		border-bottom: 1px solid var(--border-color);
		padding-bottom: 1rem;
	}

	.meta {
		font-family: var(--font-mono);
		font-size: 0.9rem;
		margin-bottom: 1rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1rem;
		text-transform: uppercase;
		color: var(--secondary-color);
	}

	.source-tier {
		background-color: var(--accent-color);
		color: #fff;
		padding: 0.1rem 0.4rem;
	}

	h1 {
		font-size: clamp(1.8rem, 5vw, 2.5rem);
		margin-bottom: 0;
		overflow-wrap: anywhere;
	}

	.table-scroll {
		overflow-x: auto;
	}

	.summary {
		font-size: 1.25rem;
		line-height: 1.6;
		font-weight: 500;
		color: var(--text-color);
		margin-bottom: 2rem;
	}

	.key-points {
		background: rgba(0, 0, 0, 0.03);
		border: 1px solid var(--border-color);
		padding: 1.25rem 1.75rem;
		margin: 2rem 0;
	}

	.key-points h3 {
		margin-top: 0;
		font-family: var(--font-sans);
		font-size: 1rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--secondary-color);
	}

	.key-points ul {
		margin: 0.5rem 0 0 1.2rem;
		padding: 0;
		line-height: 1.7;
	}

	.detailed-body {
		font-size: 1.1rem;
		line-height: 1.8;
		margin: 2rem 0;
	}

	.detailed-body p {
		margin-bottom: 1.5rem;
	}

	.ai-comment {
		background-color: rgba(194, 54, 31, 0.05);
		border-left: 4px solid var(--accent-color);
		padding: 1rem 1.5rem;
		margin: 2rem 0;
	}

	.ai-comment h3 {
		margin-top: 0;
		color: var(--accent-color);
		font-family: var(--font-sans);
		font-size: 1rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	
	.ai-comment p {
		margin-bottom: 0.5rem;
	}

	.ai-comment small {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--secondary-color);
	}

	table {
		width: 100%;
		border-collapse: collapse;
		margin: 2rem 0;
		font-family: var(--font-mono);
		font-size: 0.9rem;
	}

	th, td {
		border: 1px solid var(--border-color);
		padding: 0.75rem;
		text-align: left;
	}

	th {
		background-color: rgba(0,0,0,0.02);
		font-family: var(--font-sans);
		font-weight: 600;
	}

	.score {
		font-weight: bold;
		text-align: right;
	}

	.article-hero-image {
		width: 100%;
		max-height: 440px;
		overflow: hidden;
		margin-bottom: 2rem;
		border: 1px solid var(--border-color);
	}

	.article-hero-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.bench-note {
		font-size: 0.85rem;
		color: var(--text-muted);
		margin: 0 0 0.5rem;
	}

	.source-link-container {
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px dashed var(--border-color);
	}

	.source-text-link {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--secondary-color);
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.source-text-link:hover {
		color: var(--accent-color);
		text-decoration: underline;
	}
</style>

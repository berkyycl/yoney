---
import Layout from '../../layouts/Layout.astro';
import NewsCard from '../../components/NewsCard.astro';
import { loadArticles, sourceLabel } from '../../lib/articles';
import { NEWS_CATEGORIES, newsCategoryName, tierName } from '../../lib/categories';

export async function getStaticPaths() {
    return loadArticles().map(article => ({
        params: { slug: article.slug },
        props: { article }
    }));
}

const { article } = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": article.baslik_tr,
  "description": article.ozet_tr,
  "image": article.gorsel_url ? [article.gorsel_url] : [],
  "datePublished": article.date,
  "dateModified": article.date,
  "author": {
    "@type": "Organization",
    "name": article.source || "Yöney"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Yöney",
    "logo": {
      "@type": "ImageObject",
      "url": "https://yoney.dev/favicon.svg"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://yoney.dev/haber/${article.slug}`
  }
};

const cat = NEWS_CATEGORIES.some(c => c.id === article.kategori) ? article.kategori : 'diger';
const dateStr = new Date(article.date).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Istanbul' });
const paragraphs: string[] = (article.detayli_icerik_tr ?? '').split(/\n+/).map((p: string) => p.trim()).filter(Boolean);
const points: string[] = article.onemli_maddeler ?? [];
const words = [article.ozet_tr, ...paragraphs, ...points].join(' ').split(/\s+/).filter(Boolean).length;
const readMin = Math.max(1, Math.round(words / 200));
const source = sourceLabel(article.source);

// Benzer haberler: aynı kategoriden en yeni 3 haber, yetmezse en yeni haberlerle tamamlanır
const others = loadArticles().filter(a => a.slug !== article.slug);
const related = others.filter(a => a.kategori === article.kategori).slice(0, 3);
for (const a of others) {
	if (related.length >= 3) break;
	if (!related.includes(a)) related.push(a);
}
---

<Layout
	title={`${article.baslik_tr} | Yöney`}
	description={article.ozet_tr}
	image={article.gorsel_url}
	type="article"
	articleDate={article.date}
>
	<script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
	<article class="post">
		<a href="/" class="back">
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
			Tüm haberler
		</a>

		<header class="post-head">
			<div class="post-tags">
				<span class="cat" data-cat={cat}>{newsCategoryName(cat)}</span>
				<span class={`tier tier-${article.sourceTier ?? 'topluluk'}`}>{tierName(article.sourceTier)}</span>
			</div>
			<h1>{article.baslik_tr}</h1>
			<p class="post-lead">{article.ozet_tr}</p>
			<div class="post-byline">
				<span class="avatar" aria-hidden="true">{source.charAt(0)}</span>
				<div class="byline-text">
					<strong lang="en">{source}</strong>
					<span><time datetime={article.date}>{dateStr}</time> · {readMin} dk okuma</span>
				</div>
				<a class="btn btn-sm" href={article.url} target="_blank" rel="noopener noreferrer">Orijinal haber ↗</a>
			</div>
		</header>

		{article.gorsel_url && (
			<figure class="post-hero">
				<img src={article.gorsel_url} alt="" referrerpolicy="no-referrer" onerror="this.closest('.post-hero')?.remove()" />
			</figure>
		)}

		<div class="post-body">
			{points.length > 0 && (
				<section class="callout key-points">
					<h2>Öne çıkanlar</h2>
					<ul>
						{points.map(m => (
							<li>
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
								<span>{m}</span>
							</li>
						))}
					</ul>
				</section>
			)}

			{paragraphs.length > 0 && (
				<div class="prose">
					{paragraphs.map(p => <p>{p}</p>)}
				</div>
			)}

			{article.yorum_tr && (
				<aside class="callout ai-note">
					<h2>
						<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l1.9 5.6L19.5 9.5l-5.6 1.9L12 17l-1.9-5.6L4.5 9.5l5.6-1.9L12 2zm7 12 .9 2.6 2.6.9-2.6.9L19 21l-.9-2.6-2.6-.9 2.6-.9L19 14z"/></svg>
						Yöney yorumu
					</h2>
					<p>{article.yorum_tr}</p>
					<small>Yapay zekâ tarafından üretilmiştir.</small>
				</aside>
			)}

			{article.benchmarklar && article.benchmarklar.length > 0 && (
				<section class="post-bench">
					<h2>Benchmark sonuçları</h2>
					<p class="bench-note">Bu skorların kaynak metinde birebir geçtiği doğrulandı. Bilinen testlerin sonuçları <a href="/benchmarklar">Benchmarklar</a> sayfasındaki sıralamalara da eklenir.</p>
					<div class="table-wrap">
						<table>
							<thead>
								<tr>
									<th>Model</th>
									<th>Benchmark</th>
									<th class="num">Skor</th>
									<th>Ayar</th>
								</tr>
							</thead>
							<tbody>
								{article.benchmarklar.map((b: any) => (
									<tr>
										<td class="strong">{b.model}</td>
										<td>{b.benchmark}</td>
										<td class="num">{b.birim === '%' ? `%${b.skor}` : `${b.skor} ${b.birim ?? ''}`}</td>
										<td class="muted">{b.degerlendirme_ayari || '-'}</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
				</section>
			)}

			<a class="source-cta" href={article.url} target="_blank" rel="noopener noreferrer">
				<span class="cta-text">
					<small>Kaynak</small>
					<strong lang="en">{source}</strong>
				</span>
				<span class="cta-go">Orijinal haberi oku ↗</span>
			</a>
		</div>
	</article>

	{related.length > 0 && (
		<section class="related" aria-labelledby="relatedTitle">
			<h2 id="relatedTitle">Benzer haberler</h2>
			<div class="related-grid">
				{related.map(a => <NewsCard article={a} />)}
			</div>
		</section>
	)}
</Layout>

<style>
	.post {
		max-width: 760px;
		margin: 0 auto;
	}

	.back {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-bottom: 28px;
		color: var(--muted);
		font-size: 0.9rem;
		font-weight: 500;
		text-decoration: none;
	}

	.back:hover {
		color: var(--text);
	}

	.post-tags {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 10px;
		margin-bottom: 16px;
	}

	.tier {
		padding: 3px 10px;
		border-radius: 999px;
		background: var(--surface-2);
		color: var(--text-2);
		font-size: 0.75rem;
		font-weight: 600;
	}

	.tier-resmi {
		background: var(--accent-soft);
		color: var(--accent-text);
	}

	h1 {
		margin-bottom: 16px;
		font-size: clamp(1.9rem, 4.6vw, 2.75rem);
		font-weight: 700;
		letter-spacing: -0.04em;
		line-height: 1.1;
		overflow-wrap: anywhere;
	}

	.post-lead {
		margin: 0 0 24px;
		color: var(--text-2);
		font-size: 1.2rem;
		line-height: 1.6;
	}

	.post-byline {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 16px 0;
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
	}

	.avatar {
		width: 40px;
		height: 40px;
		flex-shrink: 0;
		display: grid;
		place-items: center;
		border-radius: 12px;
		background: linear-gradient(135deg, var(--accent), var(--accent-2));
		color: #fff;
		font-weight: 700;
	}

	.byline-text {
		display: flex;
		flex-direction: column;
		min-width: 0;
		line-height: 1.35;
	}

	.byline-text span {
		color: var(--muted);
		font-size: 0.85rem;
	}

	.post-byline .btn {
		margin-left: auto;
	}

	.post-hero {
		margin: 28px 0 0;
		overflow: hidden;
		border-radius: var(--radius-lg);
		border: 1px solid var(--border);
		background: var(--surface-2);
	}

	.post-hero img {
		display: block;
		width: 100%;
		max-height: 480px;
		object-fit: cover;
	}

	.post-body {
		margin-top: 32px;
	}

	.callout {
		margin: 0 0 32px;
		padding: 22px 24px;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
	}

	.callout h2 {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-bottom: 12px;
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.key-points ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 12px;
	}

	.key-points li {
		display: flex;
		gap: 12px;
		line-height: 1.55;
	}

	.key-points li svg {
		flex-shrink: 0;
		margin-top: 3px;
		color: var(--accent);
	}

	.prose p {
		margin: 0 0 1.4em;
		font-size: 1.125rem;
		line-height: 1.8;
	}

	.ai-note {
		border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
		background:
			linear-gradient(135deg, var(--accent-soft), transparent 70%),
			var(--surface);
	}

	.ai-note h2 {
		color: var(--accent-text);
	}

	.ai-note p {
		margin: 0 0 10px;
		line-height: 1.7;
	}

	.ai-note small {
		color: var(--muted);
		font-size: 0.78rem;
	}

	.post-bench {
		margin-bottom: 32px;
	}

	.post-bench h2 {
		font-size: 1.3rem;
		letter-spacing: -0.03em;
	}

	.bench-note {
		margin: 0 0 14px;
		color: var(--muted);
		font-size: 0.9rem;
	}

	.table-wrap {
		overflow-x: auto;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
	}

	table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.925rem;
	}

	th {
		padding: 11px 14px;
		background: var(--surface-2);
		color: var(--muted);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-align: left;
		text-transform: uppercase;
	}

	td {
		padding: 11px 14px;
		border-top: 1px solid var(--border);
	}

	td.strong {
		font-weight: 600;
	}

	.num {
		text-align: right;
		font-family: var(--font-mono);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	td.num {
		font-weight: 600;
	}

	.source-cta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		margin-top: 40px;
		padding: 20px 24px;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
		color: var(--text);
		text-decoration: none;
		transition: border-color 0.15s, box-shadow 0.15s;
	}

	.source-cta:hover {
		border-color: var(--accent);
		box-shadow: 0 0 0 3px var(--accent-soft);
	}

	.cta-text {
		display: flex;
		flex-direction: column;
		line-height: 1.35;
	}

	.cta-text small {
		color: var(--muted);
		font-size: 0.78rem;
	}

	.cta-go {
		color: var(--accent-text);
		font-weight: 600;
		white-space: nowrap;
	}

	.related {
		margin-top: 72px;
		padding-top: 40px;
		border-top: 1px solid var(--border);
	}

	.related h2 {
		margin-bottom: 20px;
		font-size: 1.4rem;
		letter-spacing: -0.03em;
	}

	.related-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 20px;
	}

	@media (max-width: 640px) {
		.post-lead {
			font-size: 1.08rem;
		}
		.post-byline {
			flex-wrap: wrap;
		}
		.post-byline .btn {
			margin-left: 0;
			width: 100%;
		}
		.callout {
			padding: 18px;
		}
		.prose p {
			font-size: 1.06rem;
		}
		.source-cta {
			flex-direction: column;
			align-items: flex-start;
		}
		.related-grid {
			grid-template-columns: 1fr;
		}
	}
</style>

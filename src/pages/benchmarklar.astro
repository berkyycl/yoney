---
import Layout from '../layouts/Layout.astro';
import fs from 'fs';
import path from 'path';
import { BENCHMARK_CATEGORIES, BENCHMARK_CATALOG } from '../data/benchmarkCatalog';

const benchmarkFile = path.join(process.cwd(), 'data', 'benchmarks.json');
let benchmarks = [];
if (fs.existsSync(benchmarkFile)) {
    benchmarks = JSON.parse(fs.readFileSync(benchmarkFile, 'utf-8'));
}

// Tüm kullanılabilir test isimleri
const availableTests = Array.from(new Set(benchmarks.map(b => b.benchmark))).sort();
---

<Layout title="Benchmark Sıralamaları (Liderlik Tablosu) | Yöney">
	<div class="benchmarks-page">
		<!-- Üst Başlık -->
		<div class="header-section">
			<span class="badge">Doğrulanmış Testler & LMArena</span>
			<h1>Yapay Zekâ Benchmark Sıralaması</h1>
			<p class="subtitle">Tüm yapay zekâ modellerinin genel zekâ, kodlama, matematik, muhakeme, görsel ve LMSYS Chatbot Arena'daki doğrulanmış X-Y sütun grafiği.</p>
		</div>

		<!-- 1. Kategori Filtre Butonları (12 Kategori) -->
		<div class="category-filter-bar">
			<span class="filter-label">Kategoriler:</span>
			<div class="filter-pills" id="categoryPills">
				{BENCHMARK_CATEGORIES.map((cat, idx) => (
					<button class={`cat-btn ${idx === 0 ? 'active' : ''}`} data-cat={cat.id}>
						{cat.name}
					</button>
				))}
			</div>
		</div>

		<!-- 2. Test Seçim Açılır Menüsü & Metrik Bilgi Kartı -->
		<div class="test-selector-card">
			<div class="selector-left">
				<label for="benchmarkSelect">İncelenen Benchmark Testi:</label>
				<select id="benchmarkSelect">
					{BENCHMARK_CATALOG.map((meta, idx) => (
						<option value={meta.id} data-category={meta.category} selected={meta.id === 'Chatbot Arena ELO' || idx === 0}>
							{meta.name} ({meta.unit})
						</option>
					))}
				</select>
			</div>

			<div class="test-meta-info" id="testMetaInfo">
				<div class="meta-badge-row">
					<span class="category-tag" id="metaCategoryTag">Sohbet & İnsan Tercihi</span>
					<span class="unit-tag" id="metaUnitTag">Birim: ELO</span>
					<span class="sort-tag" id="metaSortTag">Yüksek Skor İyi</span>
				</div>
				<p class="test-explanation" id="metaDescription">
					LMSYS Chatbot Arena insan tercihlerine dayalı küresel ELO sıralaması.
				</p>
			</div>
		</div>

		<!-- 3. İnteraktif X-Y Sütun Grafiği (En İyiden En Kötüye) -->
		<div class="chart-container-card">
			<div class="chart-top-bar">
				<div>
					<h2 id="chartTitle">Chatbot Arena ELO Sıralaması</h2>
					<span class="chart-sub" id="chartModelCount">30 model listeleniyor (En iyiden en kötüye)</span>
				</div>
				<div class="chart-legend">
					<span class="legend-box fill-gold">1. Sıra (Zirve)</span>
					<span class="legend-box fill-silver">İlk 3</span>
					<span class="legend-box fill-standard">Diğer Modeller</span>
				</div>
			</div>

			<!-- X-Y Sütun Grafiği Alanı -->
			<div class="xy-chart-wrapper">
				<div class="y-axis" id="yAxis">
					<!-- Y ekseni kılavuz çizgileri ve değerleri -->
				</div>
				<div class="chart-scroll-area">
					<div class="columns-grid" id="columnsGrid">
						<!-- JavaScript ile sıralı dikey sütunlar buraya dinamik eklenecek -->
					</div>
				</div>
			</div>
		</div>

		<!-- 4. Liderlik Tablosu & Veri Ayrıntıları -->
		<div class="table-card">
			<div class="table-card-header">
				<h3>📋 Detaylı Liderlik Tablosu</h3>
				<span class="table-note">Model kartları ve kaynak referanslarıyla birlikte listelenir</span>
			</div>
			<div class="table-wrapper">
				<table id="leaderboardTable">
					<thead>
						<tr>
							<th class="th-rank">Sıra</th>
							<th>Model</th>
							<th class="th-score">Skor</th>
							<th>Ayar / Test Metodu</th>
							<th>Kaynak</th>
							<th class="th-date">Tarih</th>
						</tr>
					</thead>
					<tbody id="tableBody">
					</tbody>
				</table>
			</div>
		</div>
	</div>
</Layout>

<script is:inline define:vars={{ benchmarks, catalog: BENCHMARK_CATALOG }}>
	const allData = benchmarks;
	const metaCatalog = catalog;

	let currentCategory = 'all';
	let currentTest = 'Chatbot Arena ELO';

	const selectEl = document.getElementById('benchmarkSelect');
	const catButtons = document.querySelectorAll('.cat-btn');
	const columnsGrid = document.getElementById('columnsGrid');
	const tableBody = document.getElementById('tableBody');
	const yAxisEl = document.getElementById('yAxis');

	// Meta info elements
	const metaCategoryTag = document.getElementById('metaCategoryTag');
	const metaUnitTag = document.getElementById('metaUnitTag');
	const metaSortTag = document.getElementById('metaSortTag');
	const metaDescription = document.getElementById('metaDescription');
	const chartTitle = document.getElementById('chartTitle');
	const chartModelCount = document.getElementById('chartModelCount');

	function getMeta(testName) {
		const found = metaCatalog.find(m => m.id === testName || m.name === testName);
		if (found) return found;
		return {
			id: testName,
			name: testName,
			description: 'Doğrulanmış teknik değerlendirme sonucu.',
			category: 'genel-zeka',
			unit: allData.find(b => b.benchmark === testName)?.birim || '',
			higherIsBetter: true
		};
	}

	function filterSelectOptions() {
		if (!selectEl) return;
		const options = Array.from(selectEl.options);
		let firstVisible = null;

		options.forEach(opt => {
			const optCat = opt.getAttribute('data-category');
			if (currentCategory === 'all' || optCat === currentCategory) {
				opt.style.display = 'block';
				if (!firstVisible) firstVisible = opt.value;
			} else {
				opt.style.display = 'none';
			}
		});

		// Eğer seçili olan gizlendiyse ilk görünürü seç
		const currentOpt = options.find(o => o.value === selectEl.value);
		if (currentOpt && currentOpt.style.display === 'none' && firstVisible) {
			selectEl.value = firstVisible;
			currentTest = firstVisible;
		}
	}

	function renderChartAndTable() {
		const meta = getMeta(currentTest);

		// Başlık ve meta bilgileri güncelle
		if (chartTitle) chartTitle.textContent = `${meta.name} Sıralaması`;
		if (metaCategoryTag) metaCategoryTag.textContent = meta.category.toUpperCase().replace('-', ' ');
		if (metaUnitTag) metaUnitTag.textContent = `Birim: ${meta.unit || '-'}`;
		if (metaSortTag) metaSortTag.textContent = meta.higherIsBetter ? 'Yüksek Skor Daha İyi' : 'Düşük Süre Daha İyi';
		if (metaDescription) metaDescription.textContent = meta.description;

		// Bu teste ait modelleri filtrele
		let items = allData.filter(b => b.benchmark === currentTest);

		// Eğer tam isimle bulunamazsa esnek eşleştirme yap
		if (items.length === 0) {
			items = allData.filter(b => b.benchmark.toLowerCase().includes(currentTest.toLowerCase()));
		}

		// En iyiden en kötüye sırala
		if (meta.higherIsBetter) {
			items.sort((a, b) => b.skor - a.skor);
		} else {
			items.sort((a, b) => a.skor - b.skor);
		}

		if (chartModelCount) chartModelCount.textContent = `${items.length} yapay zekâ modeli listeleniyor (En iyiden en kötüye)`;

		if (columnsGrid) columnsGrid.innerHTML = '';
		if (tableBody) tableBody.innerHTML = '';
		if (yAxisEl) yAxisEl.innerHTML = '';

		if (items.length === 0) {
			if (columnsGrid) columnsGrid.innerHTML = '<div class="empty-chart">Bu benchmark için henüz kayıtlı model skoru bulunmuyor.</div>';
			return;
		}

		// Y ekseni min ve max belirleme
		const scores = items.map(i => i.skor);
		const maxScore = Math.max(...scores);
		const minScore = meta.higherIsBetter ? (Math.min(...scores) > 500 ? Math.floor(Math.min(...scores) * 0.9) : 0) : 0;
		const range = maxScore - minScore || 1;

		// Y ekseni kılavuz etiketleri
		if (yAxisEl) {
			const steps = 4;
			for (let s = steps; s >= 0; s--) {
				const val = Math.round(minScore + (range * (s / steps)));
				const yLabel = document.createElement('div');
				yLabel.className = 'y-tick';
				yLabel.innerHTML = `<span>${val}</span><div class="grid-line"></div>`;
				yAxisEl.appendChild(yLabel);
			}
		}

		// X ekseni sütunlarını üret
		items.forEach((item, index) => {
			const rank = index + 1;
			const isLeader = rank === 1;
			const isTopThree = rank <= 3;

			// Sütun yüksekliği oranı (%)
			const heightPct = Math.max(12, Math.min(100, ((item.skor - minScore) / range) * 100));

			// Sütun DOM kartı
			const colWrapper = document.createElement('div');
			colWrapper.className = `column-item ${isLeader ? 'is-first' : isTopThree ? 'is-top3' : ''}`;
			colWrapper.style.animationDelay = `${Math.min(index * 0.04, 1.2)}s`;

			colWrapper.innerHTML = `
				<div class="col-bar-slot">
					<div class="score-popup">${item.skor} ${item.birim}</div>
					<div class="bar-pillar ${isLeader ? 'pillar-gold' : isTopThree ? 'pillar-silver' : 'pillar-default'}" 
					     style="height: 0%;" 
					     data-target-height="${heightPct}%">
						${isLeader ? '<span class="crown-badge">👑 #1</span>' : rank <= 3 ? `<span class="rank-badge">#${rank}</span>` : ''}
					</div>
				</div>
				<div class="col-footer">
					<span class="col-rank">#${rank}</span>
					<span class="col-name" title="${item.model}">${item.model}</span>
				</div>
			`;
			columnsGrid.appendChild(colWrapper);

			// Tablo Satırı
			const tr = document.createElement('tr');
			tr.className = isLeader ? 'tr-leader' : isTopThree ? 'tr-top3' : '';
			tr.innerHTML = `
				<td class="td-rank">
					<span class="rank-number ${isLeader ? 'rank-gold' : isTopThree ? 'rank-silver' : ''}">${rank}</span>
				</td>
				<td>
					<strong>${item.model}</strong>
					${isLeader ? ' <span class="winner-chip">🏆 Zirvede</span>' : ''}
				</td>
				<td class="th-score score-val">${item.skor} ${item.birim}</td>
				<td class="text-muted-col">${item.degerlendirme_ayari || '-'}</td>
				<td>
					${item.url ? `<a href="${item.url}" target="_blank" rel="noopener noreferrer" class="link-src">${item.source} ↗</a>` : item.source}
				</td>
				<td class="th-date text-muted-col">${item.date ? new Date(item.date).toLocaleDateString('tr-TR') : '-'}</td>
			`;
			tableBody.appendChild(tr);
		});

		// Sütun yükselme animasyonunu tetikle
		setTimeout(() => {
			document.querySelectorAll('.bar-pillar').forEach(bar => {
				const th = bar.getAttribute('data-target-height');
				if (th) bar.style.height = th;
			});
		}, 80);
	}

	// Kategori butonları dinleyicisi
	catButtons.forEach(btn => {
		btn.addEventListener('click', () => {
			catButtons.forEach(b => b.classList.remove('active'));
			btn.classList.add('active');
			currentCategory = btn.getAttribute('data-cat') || 'all';
			filterSelectOptions();
			renderChartAndTable();
		});
	});

	// Select dropdown dinleyicisi
	if (selectEl) {
		selectEl.addEventListener('change', () => {
			currentTest = selectEl.value;
			renderChartAndTable();
		});
	}

	// Başlat
	window.addEventListener('DOMContentLoaded', () => {
		filterSelectOptions();
		renderChartAndTable();
	});

	if (document.readyState === 'complete' || document.readyState === 'interactive') {
		filterSelectOptions();
		renderChartAndTable();
	}
</script>

<style>
	.benchmarks-page {
		max-width: 1200px;
		margin: 0 auto;
	}

	.header-section {
		margin-bottom: 2rem;
	}

	.badge {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		text-transform: uppercase;
		background: var(--accent-color);
		color: #ffffff;
		padding: 0.2rem 0.6rem;
		display: inline-block;
		margin-bottom: 0.75rem;
		border-radius: 3px;
		font-weight: 600;
	}

	h1 {
		font-size: 2.5rem;
		margin: 0 0 0.5rem 0;
	}

	.subtitle {
		font-size: 1.1rem;
		color: var(--text-muted);
		line-height: 1.6;
		max-width: 900px;
	}

	/* Kategori Filtre Çubuğu (12 Kategori) */
	.category-filter-bar {
		margin-bottom: 1.75rem;
		padding: 1rem 1.25rem;
		background: var(--card-bg);
		border: 1px solid var(--border-color);
		border-radius: 6px;
	}

	.filter-label {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		text-transform: uppercase;
		color: var(--text-muted);
		display: block;
		margin-bottom: 0.75rem;
		font-weight: 700;
	}

	.filter-pills {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.cat-btn {
		background: none;
		border: 1px solid var(--border-color);
		padding: 0.45rem 0.9rem;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		cursor: pointer;
		color: var(--text-color);
		border-radius: 4px;
		transition: all 0.15s ease;
		white-space: nowrap;
	}

	.cat-btn:hover {
		border-color: var(--accent-color);
		color: var(--accent-color);
	}

	.cat-btn.active {
		background: var(--accent-color);
		border-color: var(--accent-color);
		color: #ffffff;
		font-weight: 600;
	}

	/* Test Seçici ve Bilgi Kutusu */
	.test-selector-card {
		display: flex;
		gap: 2rem;
		background: var(--card-bg);
		border: 1px solid var(--border-color);
		padding: 1.5rem;
		border-radius: 6px;
		margin-bottom: 2rem;
		align-items: center;
	}

	.selector-left {
		flex: 1;
		max-width: 380px;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.selector-left label {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		text-transform: uppercase;
		font-weight: 600;
		color: var(--text-muted);
	}

	select {
		padding: 0.75rem 1rem;
		font-family: var(--font-sans);
		font-size: 1.05rem;
		border: 1px solid var(--border-color);
		background: var(--bg-color);
		color: var(--text-color);
		border-radius: 4px;
		cursor: pointer;
		font-weight: 600;
		outline: none;
	}

	select:focus {
		border-color: var(--accent-color);
	}

	.test-meta-info {
		flex: 2;
		border-left: 1px solid var(--border-color);
		padding-left: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.meta-badge-row {
		display: flex;
		gap: 0.6rem;
		flex-wrap: wrap;
	}

	.category-tag, .unit-tag, .sort-tag {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		padding: 0.2rem 0.5rem;
		border-radius: 3px;
		border: 1px solid var(--border-color);
	}

	.category-tag {
		background: rgba(37, 99, 235, 0.12);
		color: #3b82f6;
		font-weight: 600;
	}

	.unit-tag {
		background: rgba(255, 255, 255, 0.05);
		color: var(--text-color);
	}

	.sort-tag {
		background: rgba(5, 150, 105, 0.12);
		color: #10b981;
	}

	.test-explanation {
		margin: 0;
		font-size: 0.95rem;
		color: var(--text-muted);
		line-height: 1.5;
	}

	/* X-Y Sütun Grafiği */
	.chart-container-card {
		background: var(--card-bg);
		border: 1px solid var(--border-color);
		border-radius: 6px;
		padding: 2rem;
		margin-bottom: 2.5rem;
		box-shadow: 0 4px 20px rgba(0,0,0,0.03);
	}

	.chart-top-bar {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 2rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--border-color);
	}

	h2 {
		font-size: 1.6rem;
		margin: 0 0 0.25rem 0;
	}

	.chart-sub {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--text-muted);
	}

	.chart-legend {
		display: flex;
		gap: 1rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
	}

	.legend-box {
		padding: 0.2rem 0.5rem;
		border-radius: 3px;
	}

	.fill-gold {
		background: linear-gradient(135deg, #f59e0b, #d97706);
		color: #ffffff;
		font-weight: bold;
	}

	.fill-silver {
		background: #2563eb;
		color: #ffffff;
	}

	.fill-standard {
		background: rgba(255, 255, 255, 0.1);
		color: var(--text-muted);
	}

	/* X-Y Chart Layout */
	.xy-chart-wrapper {
		display: flex;
		height: 380px;
		position: relative;
	}

	.y-axis {
		width: 50px;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding-bottom: 60px;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--text-muted);
		border-right: 2px solid var(--border-color);
		position: relative;
	}

	:global(.y-tick) {
		display: flex;
		align-items: center;
		position: relative;
		width: 100%;
	}

	:global(.grid-line) {
		position: absolute;
		left: 50px;
		right: -10000px;
		height: 1px;
		background: rgba(255, 255, 255, 0.04);
		pointer-events: none;
	}

	.chart-scroll-area {
		flex: 1;
		overflow-x: auto;
		overflow-y: hidden;
		padding-bottom: 10px;
		scrollbar-width: thin;
	}

	.columns-grid {
		display: flex;
		align-items: flex-end;
		height: 100%;
		padding-left: 1.5rem;
		padding-right: 2rem;
		gap: 1.5rem;
		min-width: max-content;
	}

	:global(.column-item) {
		display: flex;
		flex-direction: column;
		align-items: center;
		width: 54px;
		height: 100%;
		justify-content: flex-end;
		animation: fadeInCol 0.4s ease forwards;
	}

	:global(.col-bar-slot) {
		width: 100%;
		height: 310px;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		align-items: center;
		position: relative;
	}

	:global(.score-popup) {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--text-color);
		margin-bottom: 0.4rem;
		white-space: nowrap;
	}

	:global(.bar-pillar) {
		width: 38px;
		border-radius: 6px 6px 0 0;
		transition: height 0.9s cubic-bezier(0.34, 1.56, 0.64, 1);
		display: flex;
		flex-direction: column;
		align-items: center;
		padding-top: 0.35rem;
		position: relative;
	}

	:global(.pillar-gold) {
		background: linear-gradient(180deg, #f59e0b 0%, #d97706 100%);
		box-shadow: 0 4px 14px rgba(245, 158, 11, 0.4);
	}

	:global(.pillar-silver) {
		background: linear-gradient(180deg, #3b82f6 0%, #1d4ed8 100%);
		box-shadow: 0 4px 10px rgba(37, 99, 235, 0.3);
	}

	:global(.pillar-default) {
		background: linear-gradient(180deg, #64748b 0%, #334155 100%);
		opacity: 0.85;
	}

	:global(.pillar-default:hover) {
		opacity: 1;
	}

	:global(.crown-badge) {
		font-size: 0.75rem;
		font-family: var(--font-mono);
		color: #ffffff;
		font-weight: 800;
		white-space: nowrap;
	}

	:global(.rank-badge) {
		font-size: 0.7rem;
		font-family: var(--font-mono);
		color: #ffffff;
		font-weight: 700;
	}

	:global(.col-footer) {
		height: 120px;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: flex-start;
		padding-top: 0.5rem;
		width: 100%;
		border-top: 2px solid var(--border-color);
		overflow: visible;
	}

	:global(.col-rank) {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--accent-color);
		font-weight: 700;
		margin-bottom: 4px;
	}

	:global(.col-name) {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		color: var(--text-color);
		white-space: nowrap;
		overflow: visible;
		text-overflow: unset;
		max-width: unset;
		/* Rotate so full name is always readable */
		transform: rotate(-45deg) translateX(-8px);
		transform-origin: top left;
		display: inline-block;
		margin-top: 6px;
		line-height: 1.2;
	}

	:global(.empty-chart) {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		font-family: var(--font-mono);
		color: var(--text-muted);

---
import Layout from '../layouts/Layout.astro';
import fs from 'fs';
import path from 'path';

const benchmarkFile = path.join(process.cwd(), 'data', 'benchmarks.json');
let benchmarks = [];
if (fs.existsSync(benchmarkFile)) {
    benchmarks = JSON.parse(fs.readFileSync(benchmarkFile, 'utf-8'));
}

// Group by benchmark name
const grouped = benchmarks.reduce((acc, curr) => {
    if (!acc[curr.benchmark]) acc[curr.benchmark] = [];
    acc[curr.benchmark].push(curr);
    return acc;
}, {});

const benchmarkNames = Object.keys(grouped).sort();
---

<Layout title="Benchmarklar | Yöney">
	<div class="benchmarks-page">
		<div class="header-section">
			<span class="badge">Doğrulanmış Testler</span>
			<h1>Yapay Zekâ Benchmarkları</h1>
			<p class="subtitle">Endüstri standardı değerlendirme testleri (MMLU, HumanEval, MATH, Chatbot Arena vb.) ve modellerin doğrulanmış skorları.</p>
		</div>

		<div class="benchmark-container">
			<div class="tabs-sidebar">
				<span class="tabs-label">Benchmark Testleri</span>
				<div class="tabs">
					{benchmarkNames.map((name, idx) => (
						<button class={`tab-btn ${idx === 0 ? 'active' : ''}`} data-target={name}>
							<span class="btn-name">{name}</span>
							<span class="btn-count">{grouped[name].length} model</span>
						</button>
					))}
				</div>
			</div>

			<div class="content-area">
				{benchmarkNames.map((name, idx) => {
					const items = [...grouped[name]].sort((a,b) => b.skor - a.skor);
					const maxScore = items.length > 0 ? items[0].skor : 100;
					return (
						<div class="tab-content" id={`tab-${name}`} style={idx === 0 ? 'display:block;' : 'display:none;'}>
							<div class="content-header">
								<div>
									<h2>{name}</h2>
									<p class="test-desc">En yüksek skor alan modeller ve resmi kaynak referansları.</p>
								</div>
								<span class="unit-badge">Birim: {items[0]?.birim || ''}</span>
							</div>

							<!-- Görsel Bar Grafiği -->
							<div class="chart-bars">
								{items.map(item => {
									const pct = Math.min(100, Math.max(10, (item.skor / (maxScore || 1)) * 100));
									return (
										<div class="bar-row">
											<div class="bar-model-info">
												<span class="model-name">{item.model}</span>
												<span class="model-score">{item.skor} {item.birim}</span>
											</div>
											<div class="bar-track">
												<div class="bar-fill" style={`width: ${pct}%;`}></div>
											</div>
										</div>
									);
								})}
							</div>

							<!-- Detay Tablosu -->
							<div class="table-container">
								<table>
									<thead>
										<tr>
											<th>Model</th>
											<th>Skor</th>
											<th>Ayar / Metot</th>
											<th>Kaynak</th>
											<th>Tarih</th>
										</tr>
									</thead>
									<tbody>
										{items.map(b => (
											<tr>
												<td><strong>{b.model}</strong></td>
												<td class="tabular-val">{b.skor} {b.birim}</td>
												<td>{b.degerlendirme_ayari || '-'}</td>
												<td>
													{b.url ? (
														<a href={b.url} target="_blank" rel="noopener noreferrer" class="src-link">
															{b.source} ↗
														</a>
													) : b.source}
												</td>
												<td class="date-col">{new Date(b.date).toLocaleDateString('tr-TR')}</td>
											</tr>
										))}
									</tbody>
								</table>
							</div>
						</div>
					);
				})}
			</div>
		</div>
	</div>
</Layout>

<script is:inline>
	document.addEventListener('DOMContentLoaded', () => {
		const buttons = document.querySelectorAll('.tab-btn');
		const contents = document.querySelectorAll('.tab-content');

		buttons.forEach(btn => {
			btn.addEventListener('click', () => {
				const target = btn.getAttribute('data-target');
				buttons.forEach(b => b.classList.remove('active'));
				contents.forEach(c => c.style.display = 'none');

				btn.classList.add('active');
				const activeContent = document.getElementById(`tab-${target}`);
				if (activeContent) {
					activeContent.style.display = 'block';
				}
			});
		});
	});
</script>

<style>
	.benchmarks-page {
		max-width: 1100px;
		margin: 0 auto;
	}

	.header-section {
		margin-bottom: 2.5rem;
	}

	.badge {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		text-transform: uppercase;
		background: var(--text-color);
		color: var(--bg-color);
		padding: 0.2rem 0.5rem;
		display: inline-block;
		margin-bottom: 0.75rem;
	}

	h1 {
		font-size: 2.4rem;
		margin: 0 0 0.5rem 0;
	}

	.subtitle {
		font-size: 1.1rem;
		color: var(--secondary-color);
		line-height: 1.6;
	}

	.benchmark-container {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	@media (min-width: 820px) {
		.benchmark-container {
			flex-direction: row;
			align-items: flex-start;
		}
	}

	.tabs-sidebar {
		min-width: 260px;
		background: var(--card-bg);
		border: 1px solid var(--border-color);
		padding: 1.25rem;
		border-radius: 4px;
	}

	.tabs-label {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		text-transform: uppercase;
		color: var(--text-muted);
		display: block;
		margin-bottom: 1rem;
		font-weight: 600;
	}

	.tabs {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.tab-btn {
		background: none;
		border: 1px solid transparent;
		padding: 0.75rem 0.9rem;
		text-align: left;
		cursor: pointer;
		display: flex;
		justify-content: space-between;
		align-items: center;
		transition: all 0.15s ease;
		color: var(--text-color);
		border-radius: 3px;
	}

	.tab-btn:hover {
		background: rgba(255, 255, 255, 0.05);
		border-color: var(--border-color);
	}

	.tab-btn.active {
		background: var(--accent-color);
		color: #ffffff;
		font-weight: 600;
	}

	.btn-name {
		font-size: 0.9rem;
	}

	.btn-count {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		opacity: 0.85;
	}

	.content-area {
		flex: 1;
		min-width: 0;
		background: var(--card-bg);
		border: 1px solid var(--border-color);
		padding: 2rem;
		border-radius: 4px;
	}

	.content-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 2rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--border-color);
	}

	h2 {
		font-size: 1.8rem;
		margin: 0 0 0.25rem 0;
	}

	.test-desc {
		color: var(--text-muted);
		font-size: 0.95rem;
		margin: 0;
	}

	.unit-badge {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		background: rgba(255, 255, 255, 0.08);
		color: var(--text-muted);
		padding: 0.25rem 0.6rem;
		border-radius: 3px;
		border: 1px solid var(--border-color);
	}

	/* CSS Bar Chart */
	.chart-bars {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		margin-bottom: 2.5rem;
		padding: 1.5rem;
		background: rgba(0, 0, 0, 0.15);
		border: 1px solid var(--border-color);
		border-radius: 4px;
	}

	.bar-row {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.bar-model-info {
		display: flex;
		justify-content: space-between;
		font-size: 0.95rem;
		color: var(--text-color);
	}

	.model-name {
		font-weight: 600;
	}

	.model-score {
		font-family: var(--font-mono);
		font-weight: 700;
		color: var(--accent-color);
	}

	.bar-track {
		height: 12px;
		background: rgba(255, 255, 255, 0.08);
		border-radius: 6px;
		overflow: hidden;
	}

	.bar-fill {
		height: 100%;
		background: linear-gradient(90deg, #2563eb, var(--accent-color));
		border-radius: 6px;
		transition: width 0.6s ease;
	}

	/* Table */
	.table-container {
		overflow-x: auto;
	}

	table {
		width: 100%;
		border-collapse: collapse;
		font-family: var(--font-sans);
		color: var(--text-color);
	}

	th, td {
		border-bottom: 1px solid var(--border-color);
		padding: 0.85rem 1rem;
		text-align: left;
	}

	th {
		background: rgba(255, 255, 255, 0.03);
		font-family: var(--font-mono);
		font-size: 0.8rem;
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.tabular-val {
		font-family: var(--font-mono);
		font-weight: 600;
		color: var(--accent-color);
	}

	.src-link {
		color: var(--text-muted);
		text-decoration: none;
		font-size: 0.85rem;
		transition: color 0.15s;
	}

	.src-link:hover {
		color: var(--accent-color);
		text-decoration: underline;
	}

	.date-col {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--text-muted);
	}
</style>

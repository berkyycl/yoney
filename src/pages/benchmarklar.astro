---
import Layout from '../layouts/Layout.astro';
import { loadBenchmarkData } from '../lib/benchmarks';
import { BENCHMARK_CATEGORIES } from '../data/benchmarkCatalog';
import { renderRows, renderTable, fmtDate, unitLabel, type CEntry, type CBench } from '../lib/leaderboard';

const data = loadBenchmarkData();

// Sıralama ancak yeterli model varsa anlamlı. Yalnızca haberlerden gelen testlerde
// (çoğu tek bir duyurudan) en az 3 model şartı aranır.
const benches: CBench[] = data.benchmarks.filter(b => b.modelCount >= (b.origin === 'canli' ? 2 : 3));
const benchIds = new Set(benches.map(b => b.id));
const entries: CEntry[] = data.entries
	.filter(e => benchIds.has(e.bench))
	.map(e => ({ b: e.bench, m: e.model, v: e.variant, k: e.key, p: e.provider, s: e.score, st: e.setting, src: e.source, u: e.url, d: e.date }));

const categories = BENCHMARK_CATEGORIES
	.map(c => ({ ...c, tests: benches.filter(b => b.category === c.id) }))
	.filter(c => c.tests.length > 0);

const initial = benches.find(b => b.id === 'lmarena-text') ?? benches[0];
const initialOpts = { best: true, q: '', provider: 'all', limit: 25 };
const firstRender = initial ? renderRows(entries, initial, initialOpts) : null;
const firstTable = initial ? renderTable(entries, initial, initialOpts) : '';

const dates = data.entries.map(e => e.date).filter(Boolean).sort() as string[];
const lastUpdate = data.generatedAt || dates[dates.length - 1] || null;
const liveCount = benches.filter(b => b.origin === 'canli').length;

const payload = JSON.stringify({ benches, entries }).replace(/</g, '\\u003c');
---

<Layout
	title="Yapay Zekâ Benchmark Sıralamaları | Yöney"
	description="LMArena ve SWE-bench liderlik tabloları ile resmi duyurulardan doğrulanmış benchmark skorları: kodlama, matematik, sohbet, görsel ve daha fazlası."
>
	<div class="bench-page">
		<header class="page-head">
			<p class="kicker">Benchmarklar</p>
			<h1>Yapay zekâ modelleri hangi testte nerede?</h1>
			<p class="lead">
				{liveCount} canlı liderlik tablosu ve haberlerden doğrulanmış skorlar. Canlı tablolar günde iki kez güncellenir.
				{lastUpdate && <span class="muted"> Son veri: {fmtDate(lastUpdate)}.</span>}
			</p>
		</header>

		{!initial ? (
			<p class="lb-empty">Henüz sıralanabilir benchmark verisi yok.</p>
		) : (
			<>
				<nav class="cat-row" aria-label="Kategoriler">
					<button class="cat-pill" data-cat="all" aria-pressed="true">Tümü</button>
					{categories.map(c => (
						<button class="cat-pill" data-cat={c.id} aria-pressed="false">{c.name}</button>
					))}
				</nav>

				<div class="test-row" id="testChips" role="tablist" aria-label="Testler">
					{benches.map(b => (
						<button class="test-chip" role="tab" data-test={b.id} data-cat={b.category} aria-selected={b.id === initial.id ? 'true' : 'false'}>
							{b.name}<span class="chip-count">{b.modelCount}</span>
						</button>
					))}
				</div>

				<section class="board" aria-live="polite">
					<div class="board-head">
						<div>
							<h2 id="testName">{initial.name}</h2>
							<p class="test-desc" id="testDesc">{initial.description}</p>
							<p class="test-facts" id="testFacts">
								{initial.higherIsBetter ? 'Yüksek skor daha iyi' : 'Düşük skor daha iyi'} · Birim: {unitLabel(initial.unit)} · Kaynak: {initial.sources.join(', ')}
								{initial.latestDate && <> · Güncel: {fmtDate(initial.latestDate)}</>}
							</p>
						</div>
						{initial.link && <a class="ext-link" id="testLink" href={initial.link} target="_blank" rel="noopener noreferrer">Resmi tablo ↗</a>}
						{!initial.link && <a class="ext-link" id="testLink" hidden target="_blank" rel="noopener noreferrer">Resmi tablo ↗</a>}
					</div>

					<div class="controls">
						<label class="search">
							<span class="sr-only">Model ara</span>
							<input type="search" id="q" placeholder="Model ara (ör. Claude, GPT, Qwen)" autocomplete="off" />
						</label>
						<label class="select">
							<span class="sr-only">Sağlayıcı</span>
							<select id="provider"><option value="all">Tüm sağlayıcılar</option></select>
						</label>
						<label class="toggle">
							<input type="checkbox" id="best" checked />
							<span>Her modelin yalnızca en iyi sonucu</span>
						</label>
					</div>

					<ol class="lb" id="list">
						<Fragment set:html={firstRender?.html} />
					</ol>
					<div class="list-foot">
						<span class="muted" id="countNote">{firstRender && `${firstRender.shown} / ${firstRender.total} sonuç gösteriliyor`}</span>
						<button class="more-btn" id="moreBtn" hidden={!firstRender || firstRender.total <= firstRender.shown}>Tümünü göster</button>
					</div>

					<details class="table-view">
						<summary>Tablo görünümü (ayar, kaynak ve tarih ile)</summary>
						<div class="table-wrap">
							<table>
								<thead>
									<tr><th class="num">Sıra</th><th>Model</th><th>Sağlayıcı</th><th class="num">Skor</th><th>Ayar</th><th>Kaynak</th><th>Tarih</th></tr>
								</thead>
								<tbody id="tableBody"><Fragment set:html={firstTable} /></tbody>
							</table>
						</div>
					</details>
				</section>

				<aside class="notes">
					<h3>Bu sayfayı okurken</h3>
					<ul>
						<li><strong>ELO</strong> skorları (LMArena) mutlak değil görelidir: iki model arasındaki 20-30 puanlık fark, kullanıcıların birini biraz daha sık tercih ettiği anlamına gelir.</li>
						<li>Aynı model farklı ayarlarla (ör. düşünme bütçesi, çaba seviyesi) birden çok kez yer alabilir. "En iyi sonuç" seçeneği her modeli bir kez gösterir; kapatırsan tüm varyantları görürsün.</li>
						<li><strong>SWE-bench Verified</strong> skorları modelin değil, model ile onu çalıştıran ajan sisteminin birlikte aldığı skordur.</li>
						<li>Haberlerden gelen skorlar ancak kaynak metinde birebir geçiyorsa ve test adı bilinen bir benchmark ise buraya eklenir. Şirket içi metrikler ve donanım hız ölçümleri yalnızca ilgili haber sayfasında görünür.</li>
					</ul>
				</aside>
			</>
		)}
	</div>
	<script type="application/json" id="bench-data" set:html={payload} />
</Layout>

<script>
	import { renderRows, renderTable, fmtDate, unitLabel, type CEntry, type CBench } from '../lib/leaderboard';

	const el = document.getElementById('bench-data');
	if (el && document.getElementById('list')) {
		const { benches, entries } = JSON.parse(el.textContent || '{}') as { benches: CBench[]; entries: CEntry[] };
		const PAGE = 25;
		const state = { test: 'lmarena-text', cat: 'all', q: '', provider: 'all', best: true, limit: PAGE };

		const $ = (id: string) => document.getElementById(id)!;
		const list = $('list');
		const tableBody = $('tableBody');
		const countNote = $('countNote');
		const moreBtn = $('moreBtn') as HTMLButtonElement;
		const providerSel = $('provider') as HTMLSelectElement;
		const qInput = $('q') as HTMLInputElement;
		const bestBox = $('best') as HTMLInputElement;
		const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.test-chip'));
		const pills = Array.from(document.querySelectorAll<HTMLButtonElement>('.cat-pill'));

		const bench = () => benches.find(b => b.id === state.test) ?? benches[0];

		function fillProviders() {
			const b = bench();
			const counts = new Map<string, number>();
			for (const e of entries) if (e.b === b.id) counts.set(e.p ?? 'Diğer', (counts.get(e.p ?? 'Diğer') ?? 0) + 1);
			const opts = [...counts.entries()].sort((x, y) => y[1] - x[1] || x[0].localeCompare(y[0]));
			if (!counts.has(state.provider)) state.provider = 'all';
			providerSel.innerHTML = '<option value="all">Tüm sağlayıcılar</option>' +
				opts.map(([p, n]) => `<option value="${p.replace(/"/g, '&quot;')}">${p.replace(/</g, '&lt;')} (${n})</option>`).join('');
			providerSel.value = state.provider;
		}

		function renderHead() {
			const b = bench();
			$('testName').textContent = b.name;
			$('testDesc').textContent = b.description;
			$('testFacts').textContent =
				`${b.higherIsBetter ? 'Yüksek skor daha iyi' : 'Düşük skor daha iyi'} · Birim: ${unitLabel(b.unit)} · Kaynak: ${b.sources.join(', ')}` +
				(b.latestDate ? ` · Güncel: ${fmtDate(b.latestDate)}` : '');
			const link = $('testLink') as HTMLAnchorElement;
			if (b.link) { link.href = b.link; link.hidden = false; } else { link.hidden = true; }
			chips.forEach(c => c.setAttribute('aria-selected', String(c.dataset.test === b.id)));
		}

		function renderList() {
			const b = bench();
			const r = renderRows(entries, b, state);
			list.innerHTML = r.html;
			tableBody.innerHTML = renderTable(entries, b, state);
			countNote.textContent = r.total ? `${r.shown} / ${r.total} sonuç gösteriliyor` : '';
			moreBtn.hidden = r.total <= r.shown;
		}

		function applyCategory() {
			pills.forEach(p => p.setAttribute('aria-pressed', String(p.dataset.cat === state.cat)));
			chips.forEach(c => { c.hidden = state.cat !== 'all' && c.dataset.cat !== state.cat; });
		}

		function select(test: string, push = true) {
			if (!benches.some(b => b.id === test)) return;
			state.test = test;
			state.limit = PAGE;
			fillProviders();
			renderHead();
			renderList();
			if (push) history.replaceState(null, '', `#${encodeURIComponent(test)}`);
		}

		pills.forEach(p => p.addEventListener('click', () => {
			state.cat = p.dataset.cat || 'all';
			applyCategory();
			const visible = chips.filter(c => !c.hidden);
			if (!visible.some(c => c.dataset.test === state.test) && visible[0]) select(visible[0].dataset.test!);
		}));
		chips.forEach(c => c.addEventListener('click', () => select(c.dataset.test!)));
		qInput.addEventListener('input', () => { state.q = qInput.value; renderList(); });
		providerSel.addEventListener('change', () => { state.provider = providerSel.value; state.limit = PAGE; renderList(); });
		bestBox.addEventListener('change', () => { state.best = bestBox.checked; state.limit = PAGE; renderList(); });
		moreBtn.addEventListener('click', () => { state.limit = Infinity; renderList(); });

		const readHash = () => {
			try { return decodeURIComponent(location.hash.slice(1)); } catch { return ''; }
		};
		const fromHash = readHash();
		const startTest = benches.some(b => b.id === fromHash) ? fromHash : (benches.find(b => b.id === 'lmarena-text') ?? benches[0]).id;
		select(startTest, false);
		window.addEventListener('hashchange', () => select(readHash(), false));
	}
</script>

<style>
	.bench-page {
		--viz-bar: #2a78d6;
		--viz-track: rgba(22, 19, 15, 0.06);
		max-width: 980px;
		margin: 0 auto;
	}
	@media (prefers-color-scheme: dark) {
		.bench-page {
			--viz-bar: #3987e5;
			--viz-track: rgba(230, 226, 218, 0.07);
		}
	}

	.page-head { margin-bottom: 1.75rem; }
	.kicker {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--accent-color);
		margin: 0 0 0.5rem;
	}
	h1 { font-size: clamp(1.9rem, 4vw, 2.6rem); margin-bottom: 0.75rem; }
	.lead { font-size: 1.05rem; color: var(--text-color); max-width: 46rem; margin: 0; }
	.muted { color: var(--text-muted); }

	.cat-row, .test-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.cat-row {
		padding-bottom: 0.9rem;
		border-bottom: 1px solid var(--border-color);
		margin-bottom: 0.9rem;
	}
	.cat-pill {
		background: none;
		border: 1px solid var(--border-color);
		color: var(--text-color);
		font-family: var(--font-mono);
		font-size: 0.78rem;
		padding: 0.35rem 0.75rem;
		cursor: pointer;
	}
	.cat-pill:hover { border-color: var(--text-color); }
	.cat-pill[aria-pressed="true"] {
		background: var(--text-color);
		color: var(--bg-color);
		border-color: var(--text-color);
	}

	.test-row { margin-bottom: 1.5rem; }
	.test-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		background: var(--card-bg);
		border: 1px solid var(--border-color);
		color: var(--text-color);
		font-family: var(--font-sans);
		font-size: 0.88rem;
		padding: 0.45rem 0.7rem;
		cursor: pointer;
	}
	.test-chip:hover { border-color: var(--text-color); }
	.test-chip[aria-selected="true"] {
		border-color: var(--accent-color);
		box-shadow: inset 0 -2px 0 var(--accent-color);
		font-weight: 600;
	}
	.chip-count {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--text-muted);
		font-weight: 400;
	}

	.board {
		background: var(--card-bg);
		border: 1px solid var(--border-color);
		padding: 1.5rem;
	}
	.board-head {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		align-items: flex-start;
		margin-bottom: 1.25rem;
	}
	.board-head h2 { font-size: 1.6rem; margin-bottom: 0.35rem; }
	.test-desc { margin: 0 0 0.35rem; }
	.test-facts {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--text-muted);
	}
	.ext-link {
		flex-shrink: 0;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		white-space: nowrap;
	}

	.controls {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 1rem;
		align-items: center;
		padding: 0.75rem 0;
		border-top: 1px solid var(--border-color);
		border-bottom: 1px solid var(--border-color);
		margin-bottom: 0.75rem;
	}
	.search { flex: 1 1 14rem; }
	.search input, .select select {
		width: 100%;
		font: inherit;
		font-size: 0.9rem;
		padding: 0.45rem 0.6rem;
		border: 1px solid var(--border-color);
		background: var(--bg-color);
		color: var(--text-color);
		border-radius: 0;
	}
	.select { flex: 0 1 13rem; }
	.toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.85rem;
		cursor: pointer;
	}
	.toggle input { accent-color: var(--accent-color); width: 1rem; height: 1rem; }
	.sr-only {
		position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap;
	}

	/* Sıralama listesi: sıra · model · çubuk · skor */
	.lb { list-style: none; margin: 0; padding: 0; }
	:global(.lb-row) {
		display: grid;
		grid-template-columns: 2.25rem minmax(0, 17rem) minmax(0, 1fr) 5.5rem;
		align-items: center;
		gap: 0.75rem;
		padding: 0.5rem 0.25rem;
		border-bottom: 1px solid var(--border-color);
	}
	:global(.lb-row:hover) { background: var(--viz-track); }
	:global(.lb-rank) {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--text-muted);
		text-align: right;
		font-variant-numeric: tabular-nums;
	}
	:global(.lb-row.is-first .lb-rank) { color: var(--accent-color); font-weight: 600; }
	:global(.lb-name) { min-width: 0; line-height: 1.3; }
	:global(.lb-name strong) { font-weight: 600; }
	:global(.lb-variant) {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--text-muted);
		white-space: nowrap;
	}
	:global(.lb-meta) {
		display: block;
		font-size: 0.75rem;
		color: var(--text-muted);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	:global(.lb-track) {
		height: 12px;
		background: var(--viz-track);
		position: relative;
	}
	:global(.lb-bar) {
		display: block;
		height: 100%;
		background: var(--viz-bar);
		border-radius: 0 4px 4px 0;
		transition: width 0.25s ease;
	}
	:global(.lb-score) {
		font-family: var(--font-mono);
		font-size: 0.95rem;
		font-weight: 600;
		text-align: right;
		font-variant-numeric: tabular-nums;
	}
	:global(.lb-empty) { padding: 2rem 0; text-align: center; color: var(--text-muted); }

	.list-foot {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		padding: 0.9rem 0 0.25rem;
		font-size: 0.8rem;
		font-family: var(--font-mono);
	}
	.more-btn {
		background: none;
		border: 1px solid var(--text-color);
		color: var(--text-color);
		font-family: var(--font-mono);
		font-size: 0.8rem;
		padding: 0.4rem 0.9rem;
		cursor: pointer;
	}
	.more-btn:hover { background: var(--text-color); color: var(--bg-color); }

	.table-view { margin-top: 1rem; }
	.table-view summary {
		cursor: pointer;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--text-muted);
	}
	.table-wrap { overflow-x: auto; margin-top: 0.75rem; }
	table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
	th, :global(td) {
		text-align: left;
		padding: 0.45rem 0.5rem;
		border-bottom: 1px solid var(--border-color);
		vertical-align: top;
	}
	th { font-weight: 600; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-muted); }
	th.num, :global(td.num) { text-align: right; font-variant-numeric: tabular-nums; font-family: var(--font-mono); }
	:global(td.nowrap) { white-space: nowrap; }

	.notes {
		margin-top: 2rem;
		font-size: 0.92rem;
		color: var(--text-color);
	}
	.notes h3 { font-size: 1.15rem; }
	.notes ul { padding-left: 1.2rem; margin: 0; }
	.notes li { margin-bottom: 0.5rem; }

	@media (max-width: 640px) {
		.board { padding: 1rem; }
		.board-head { flex-direction: column; }
		:global(.lb-row) {
			grid-template-columns: 1.75rem minmax(0, 1fr) 4.75rem;
			gap: 0.35rem 0.6rem;
		}
		:global(.lb-track) { grid-column: 2 / 4; grid-row: 2; height: 8px; }
	}
</style>

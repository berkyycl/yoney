---
import Layout from '../../layouts/Layout.astro';
import Story from '../../components/Story.astro';
import { loadArticles } from '../../lib/articles';
import { NEWS_CATEGORIES, categoryOf, type NewsCategory } from '../../lib/categories';
import { categoryPalette } from '../../lib/palettes';

export function getStaticPaths() {
	return NEWS_CATEGORIES.map(category => ({ params: { id: category.id }, props: { category } }));
}

const { category: c } = Astro.props as { category: NewsCategory };
const PAGE = 12;
const list = loadArticles().filter(a => categoryOf(a) === c.id);

// Bölümün manşeti: en yeni görselli haberlerden en önemlisi
const withImage = list.filter(a => a.gorsel_url).slice(0, 6);
const lead = [...withImage].sort((a, b) => (b.onem ?? 0) - (a.onem ?? 0))[0];
const rest = list.filter(a => a !== lead);

const i = NEWS_CATEGORIES.indexOf(c);
const prev = NEWS_CATEGORIES[(i - 1 + NEWS_CATEGORIES.length) % NEWS_CATEGORIES.length];
const next = NEWS_CATEGORIES[(i + 1) % NEWS_CATEGORIES.length];
const latest = list[0] ? new Date(list[0].date).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', timeZone: 'Europe/Istanbul' }) : null;
---

<Layout title={`${c.name}: yapay zekâ haberleri | Yöney`} description={c.desc} palette={categoryPalette(c.id)}>
	<header class="cover" data-cat={c.id}>
		<div class="cover-art tilt">
			<span class="shine"></span>
			<span class="cover-num" aria-hidden="true">{c.numeral}</span>
			<svg class="cover-emblem" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={c.emblem} /></svg>
		</div>
		<div class="cover-text pose">
			<p class="cover-over">Bölüm {c.numeral}</p>
			<h1>{c.name}</h1>
			<p class="cover-tag deck">{c.tagline}</p>
			<p class="lead">{c.desc}</p>
			<p class="cover-count"><strong>{list.length}</strong> haber{latest && <> · son haber {latest}</>}</p>
		</div>
	</header>

	<nav class="chapter-nav" aria-label="Bölümler">
		{NEWS_CATEGORIES.map(o => (
			<a class="chapter-link" href={`/kategori/${o.id}`} data-cat={o.id} aria-current={o.id === c.id ? 'page' : undefined}>
				<span class="swatch"></span>{o.numeral} · {o.name}
			</a>
		))}
	</nav>

	{list.length === 0 ? (
		<p class="empty">Bu bölümde henüz haber yok. Yeni gelişmeler geldikçe burada yer alacak.</p>
	) : (
		<>
			{lead && (
				<section class="cat-lead" aria-label="Bölüm manşeti">
					<Story article={lead} variant="big" eager />
				</section>
			)}

			{rest.length > 0 && (
				<section aria-labelledby="catFeed">
					<div class="section-head">
						<span class="sec-num">{c.numeral}</span>
						<h2 id="catFeed">Bölümdeki haberler</h2>
						<span class="sec-line" aria-hidden="true"></span>
					</div>
					<div class="cat-grid" id="catGrid" data-paged={PAGE}>
						{rest.map((a, n) => <Story article={a} variant="card" hidden={n >= PAGE} delay={(n % 3) * 0.08} />)}
					</div>
					<div class="grid-foot">
						<button class="btn" type="button" data-more="catGrid" hidden={rest.length <= PAGE}>Daha fazla haber</button>
						<p class="muted" data-count="catGrid">{Math.min(PAGE, rest.length)} / {rest.length} haber</p>
					</div>
				</section>
			)}
		</>
	)}

	<nav class="pager" aria-label="Önceki ve sonraki bölüm">
		<a class="pager-link" href={`/kategori/${prev.id}`} data-cat={prev.id}>
			<small>← Önceki bölüm</small>
			<strong>{prev.numeral} · {prev.name}</strong>
		</a>
		<a class="pager-link next" href={`/kategori/${next.id}`} data-cat={next.id}>
			<small>Sonraki bölüm →</small>
			<strong>{next.numeral} · {next.name}</strong>
		</a>
	</nav>
</Layout>

<script>
	import '../../scripts/paged';
</script>

<style>
	.cover {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
		gap: 56px;
		align-items: center;
		margin: 10px 0 48px;
	}

	.cover-art {
		position: relative;
		display: grid;
		place-items: center;
		aspect-ratio: 1;
		max-height: 520px;
		overflow: hidden;
		background: var(--pat), var(--c);
		color: var(--c-on);
		border: 3px solid var(--line);
		box-shadow: 16px 16px 0 var(--a1);
	}

	.cover-num {
		position: absolute;
		left: 22px;
		top: 6px;
		font-family: var(--font-serif);
		font-size: clamp(5rem, 11vw, 9rem);
		font-style: italic;
		font-weight: 900;
		line-height: 1;
	}

	.cover-emblem {
		width: 52%;
		height: auto;
		filter: drop-shadow(8px 8px 0 rgba(23, 15, 51, 0.35));
		animation: emblem-float 6s ease-in-out infinite alternate;
	}

	@keyframes emblem-float {
		from { transform: rotate(-6deg) translateY(4px); }
		to { transform: rotate(6deg) translateY(-8px); }
	}

	.cover-over {
		margin: 0;
		color: var(--c);
		font-family: var(--font-serif);
		font-size: 1.4rem;
		font-style: italic;
		font-weight: 800;
	}

	.cover-text h1 {
		margin: 6px 0 14px;
		font-size: clamp(3rem, 7.4vw, 6.6rem);
		line-height: 0.88;
		text-transform: uppercase;
		transform: skewX(-6deg);
		transform-origin: left bottom;
		text-shadow: 6px 6px 0 var(--c);
	}

	.cover-tag {
		margin: 0 0 18px;
		color: var(--text);
		font-size: clamp(1.3rem, 2.4vw, 1.8rem);
		line-height: 1.25;
	}

	.cover-count {
		margin: 22px 0 0;
		padding-top: 14px;
		border-top: 3px solid var(--line);
		color: var(--text-2);
		font-size: 0.9rem;
	}

	.cover-count strong {
		color: var(--c);
		font-family: var(--font-display);
		font-size: 1.6rem;
		font-weight: 400;
	}

	.chapter-nav {
		display: flex;
		gap: 10px;
		margin: 0 -24px 64px;
		padding: 16px 24px;
		overflow-x: auto;
		background: var(--surface);
		border-top: 2px solid var(--line);
		border-bottom: 2px solid var(--line);
		scrollbar-width: none;
	}

	.chapter-nav::-webkit-scrollbar {
		display: none;
	}

	.chapter-link {
		display: inline-flex;
		align-items: center;
		gap: 9px;
		padding: 9px 13px;
		border: 2px solid transparent;
		color: var(--text-2);
		font-size: 0.72rem;
		font-weight: 800;
		font-stretch: 80%;
		letter-spacing: 0.12em;
		text-decoration: none;
		text-transform: uppercase;
		white-space: nowrap;
		transition: transform 0.2s var(--ease-pose);
	}

	.chapter-link:hover {
		border-color: var(--c);
		color: var(--text);
		transform: rotate(-2deg);
	}

	.chapter-link[aria-current='page'] {
		background: var(--pat), var(--c);
		border-color: var(--line);
		color: var(--c-on);
	}

	.chapter-link[aria-current='page'] .swatch {
		background: var(--c-on);
	}

	.cat-lead {
		margin: 0 0 96px;
	}

	.cat-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 56px 36px;
	}

	.grid-foot {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12px;
		margin-top: 52px;
	}

	.grid-foot p {
		margin: 0;
		font-size: 0.85rem;
	}

	.pager {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 24px;
		margin-top: 96px;
	}

	.pager-link {
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding: 22px 24px;
		background: var(--pat), var(--c);
		color: var(--c-on);
		border: 3px solid var(--line);
		box-shadow: 8px 8px 0 var(--shadow);
		text-decoration: none;
		transition: transform 0.3s var(--ease-pose);
	}

	.pager-link:hover {
		transform: rotate(-1.5deg) translateY(-4px);
	}

	.pager-link.next {
		align-items: flex-end;
		text-align: right;
	}

	.pager-link.next:hover {
		transform: rotate(1.5deg) translateY(-4px);
	}

	.pager-link small {
		font-size: 0.7rem;
		font-weight: 900;
		font-stretch: 80%;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.pager-link strong {
		font-family: var(--font-display);
		font-size: clamp(1.4rem, 2.6vw, 2rem);
		font-weight: 400;
		text-transform: uppercase;
	}

	@media (max-width: 960px) {
		.cover {
			grid-template-columns: 1fr;
			gap: 32px;
		}
		.cover-art {
			aspect-ratio: 16 / 9;
			margin-right: 16px;
		}
		.cover-emblem {
			width: 34%;
		}
		.cat-grid {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (max-width: 640px) {
		.cover-art {
			box-shadow: 9px 9px 0 var(--a1);
		}
		.chapter-nav {
			margin: 0 -16px 48px;
			padding: 14px 16px;
		}
		.cat-grid {
			grid-template-columns: 1fr;
			gap: 44px;
		}
		.pager {
			grid-template-columns: 1fr;
		}
		.pager-link.next {
			align-items: flex-start;
			text-align: left;
		}
	}
</style>

---
import Layout from '../layouts/Layout.astro';
import { loadBenchmarkData } from '../lib/benchmarks';
import { categoryName } from '../data/benchmarkCatalog';

const data = loadBenchmarkData();

interface Best { s: number; v: string; st: string | null; src: string; u: string | null }
const benchById = new Map(data.benchmarks.map(b => [b.id, b]));

// Her model + test için en iyi sonuç (varyantlar tek satıra iner)
const best = new Map<string, Record<string, Best>>();
const names = new Map<string, { name: string; provider: string | null }>();
for (const e of data.entries) {
	const b = benchById.get(e.bench);
	if (!b) continue;
	if (!names.has(e.key)) names.set(e.key, { name: e.model, provider: e.provider });
	const rec = best.get(e.key) ?? {};
	const cur = rec[e.bench];
	const better = !cur || (b.higherIsBetter ? e.score > cur.s : e.score < cur.s);
	if (better) rec[e.bench] = { s: e.score, v: e.variant, st: e.setting, src: e.source, u: e.url };
	best.set(e.key, rec);
}

// Karşılaştırılabilir modeller: en az 2 testte skoru olanlar
const models = [...best.entries()]
	.map(([k, rec]) => ({ k, name: names.get(k)!.name, provider: names.get(k)!.provider ?? 'Diğer', n: Object.keys(rec).length }))
	.filter(m => m.n >= 2)
	.sort((a, b) => a.provider.localeCompare(b.provider, 'tr') || b.name.localeCompare(a.name, 'tr', { numeric: true }));

const groups = [...new Set(models.map(m => m.provider))].map(p => ({ p, items: models.filter(m => m.provider === p) }));

// Test başına çubuk ölçeği (sıralama sayfasıyla aynı mantık)
const benches = data.benchmarks.map(b => {
	const vals = data.entries.filter(e => e.bench === b.id).map(e => e.score);
	const max = Math.max(...vals);
	const min = Math.min(...vals);
	let lo = 0, hi = max;
	if (b.unit === '%' && max <= 100) hi = 100;
	if (b.unit.toLowerCase() === 'elo') lo = Math.floor((min - 25) / 25) * 25;
	return { id: b.id, name: b.name, category: categoryName(b.category), unit: b.unit, hib: b.higherIsBetter, lo, hi };
});

// Varsayılan ikili: genel arena sıralamasında öne çıkan iki farklı sağlayıcının en iyi modelleri
const arenaScore = (k: string) => best.get(k)?.['lmarena-text']?.s ?? 0;
const byProvider = new Map<string, string>();
for (const m of [...models].sort((a, b) => arenaScore(b.k) - arenaScore(a.k))) {
	if (m.provider !== 'Diğer' && !byProvider.has(m.provider)) byProvider.set(m.provider, m.k);
}
const leaders = [...byProvider.values()].slice(0, 4);
const pairs: [string, string][] = [];
for (let i = 0; i < leaders.length; i++) for (let j = i + 1; j < leaders.length; j++) pairs.push([leaders[i], leaders[j]]);
const quick = pairs.slice(0, 4).map(([a, b]) => ({ a, b, label: `${names.get(a)!.name} – ${names.get(b)!.name}` }));
const defA = leaders[0] ?? models[0]?.k;
const defB = leaders[1] ?? models[1]?.k;

const scores = Object.fromEntries([...best.entries()].filter(([k]) => models.some(m => m.k === k)));
const payload = JSON.stringify({ benches, scores, names: Object.fromEntries([...names.entries()].filter(([k]) => scores[k])), defA, defB }).replace(/</g, '\\u003c');
---

<Layout
	title="Model Karşılaştırma | Yöney"
	description="İki yapay zekâ modelini LMArena, SWE-bench ve resmi duyurulardaki ortak testlerde yan yana karşılaştırın."
>
	<div class="cmp-page">
		<header class="page-head">
			<p class="kicker">Karşılaştır</p>
			<h1>İki modeli yan yana koy</h1>
			<p class="lead">İki model seç; ikisinin de skoru olan testlerde kimin önde olduğunu ve farkı gör. Bir modelin farklı ayarları (çaba seviyesi, düşünme modu) varsa en iyi sonucu kullanılır.</p>
		</header>

		{models.length < 2 ? (
			<p class="empty">Karşılaştırma için yeterli veri yok.</p>
		) : (
			<>
				<div class="pickers">
					<label class="picker picker-a">
						<span class="picker-label"><i class="swatch swatch-a"></i>Model A</span>
						<select id="selA">
							{groups.map(g => (
								<optgroup label={g.p}>
									{g.items.map(m => <option value={m.k} selected={m.k === defA}>{m.name} ({m.n} test)</option>)}
								</optgroup>
							))}
						</select>
					</label>
					<button class="swap" id="swap" type="button" aria-label="Modellerin yerini değiştir" title="Yer değiştir">⇄</button>
					<label class="picker picker-b">
						<span class="picker-label"><i class="swatch swatch-b"></i>Model B</span>
						<select id="selB">
							{groups.map(g => (
								<optgroup label={g.p}>
									{g.items.map(m => <option value={m.k} selected={m.k === defB}>{m.name} ({m.n} test)</option>)}
								</optgroup>
							))}
						</select>
					</label>
				</div>

				{quick.length > 0 && (
					<div class="quick">
						<span class="quick-label">Hızlı seçim:</span>
						{quick.map(q => <button class="quick-btn" type="button" data-a={q.a} data-b={q.b}>{q.label}</button>)}
					</div>
				)}

				<section class="result" aria-live="polite">
					<div class="summary" id="summary"></div>
					<label class="toggle">
						<input type="checkbox" id="onlyCommon" checked />
						<span>Yalnızca ikisinin de skoru olan testler</span>
					</label>
					<div class="rows" id="rows"></div>
				</section>

				<p class="note">Skorlar farklı kaynaklardan ve farklı tarihlerden gelir. LMArena skorları (ELO) insan oylarına dayalı görelidir; SWE-bench skorları model ile ajan sisteminin birlikte aldığı sonuçtur. Ayrıntılar için <a href="/benchmarklar">Benchmarklar</a> sayfasına bak.</p>
			</>
		)}
	</div>
	<script type="application/json" id="cmp-data" set:html={payload} />
</Layout>

<script>
	import { esc, fmtScore } from '../lib/leaderboard';

	interface Bench { id: string; name: string; category: string; unit: string; hib: boolean; lo: number; hi: number }
	interface Best { s: number; v: string; st: string | null; src: string; u: string | null }

	const raw = document.getElementById('cmp-data');
	const selA = document.getElementById('selA') as HTMLSelectElement | null;
	const selB = document.getElementById('selB') as HTMLSelectElement | null;

	if (raw && selA && selB) {
		const data = JSON.parse(raw.textContent || '{}') as {
			benches: Bench[]; scores: Record<string, Record<string, Best>>; names: Record<string, { name: string; provider: string | null }>; defA: string; defB: string;
		};
		const rowsEl = document.getElementById('rows')!;
		const summaryEl = document.getElementById('summary')!;
		const onlyCommon = document.getElementById('onlyCommon') as HTMLInputElement;

		const width = (b: Bench, v: number) => {
			const pct = ((v - b.lo) / ((b.hi - b.lo) || 1)) * 100;
			return Math.max(1.5, Math.min(100, b.hib ? pct : 100 - pct));
		};
		const diffText = (b: Bench, d: number) => {
			const n = Math.abs(d).toLocaleString('tr-TR', { maximumFractionDigits: 2 });
			if (b.unit === '%') return `${n} puan`;
			return `${n} ${b.unit}`;
		};

		function side(cls: string, b: Bench, r: Best | undefined, win: boolean) {
			if (!r) return `<div class="side ${cls} none"><span class="val">—</span><span class="track"></span></div>`;
			const extra = [r.v, r.st].filter(Boolean).join(' · ');
			return `<div class="side ${cls}${win ? ' win' : ''}" title="${esc(extra ? `${extra} · ${r.src}` : r.src)}">
				<span class="val">${esc(fmtScore(r.s, b.unit))}</span>
				<span class="track"><span class="bar" style="width:${width(b, r.s).toFixed(1)}%"></span></span>
			</div>`;
		}

		function render() {
			const a = selA!.value, bKey = selB!.value;
			const A = data.scores[a] ?? {}, B = data.scores[bKey] ?? {};
			const nameA = data.names[a]?.name ?? a, nameB = data.names[bKey]?.name ?? bKey;
			let winsA = 0, winsB = 0, common = 0;
			const html: string[] = [];
			for (const b of data.benches) {
				const ra = A[b.id], rb = B[b.id];
				if (!ra && !rb) continue;
				const both = !!(ra && rb);
				if (!both && onlyCommon.checked) continue;
				let verdict = '<span class="verdict muted">Ortak veri yok</span>';
				let winA = false, winB = false;
				if (both) {
					common++;
					const d = ra!.s - rb!.s;
					if (d === 0) verdict = '<span class="verdict">Berabere</span>';
					else {
						winA = b.hib ? d > 0 : d < 0;
						winB = !winA;
						if (winA) winsA++; else winsB++;
						verdict = `<span class="verdict"><i class="swatch ${winA ? 'swatch-a' : 'swatch-b'}"></i>${esc(winA ? nameA : nameB)} <strong>+${esc(diffText(b, d))}</strong></span>`;
					}
				}
				html.push(`<div class="row">
					<div class="test"><strong>${esc(b.name)}</strong><span class="cat">${esc(b.category)}</span></div>
					<div class="sides">${side('a', b, ra, winA)}${side('b', b, rb, winB)}</div>
					${verdict}
				</div>`);
			}
			rowsEl.innerHTML = html.length ? html.join('') : '<p class="empty">Bu iki modelin ortak testi yok. Ortak olmayanları görmek için yukarıdaki seçeneği kapat.</p>';
			summaryEl.innerHTML = common
				? `<div class="score-a"><i class="swatch swatch-a"></i><span>${esc(nameA)}</span><strong>${winsA}</strong></div>
				   <div class="score-mid">${common} ortak test</div>
				   <div class="score-b"><strong>${winsB}</strong><span>${esc(nameB)}</span><i class="swatch swatch-b"></i></div>`
				: `<div class="score-mid">${esc(nameA)} ile ${esc(nameB)} arasında ortak test yok</div>`;
			history.replaceState(null, '', `#a=${encodeURIComponent(a)}&b=${encodeURIComponent(bKey)}`);
		}

		const params = new URLSearchParams(location.hash.slice(1));
		const has = (k: string | null) => !!k && Array.from(selA.options).some(o => o.value === k);
		if (has(params.get('a'))) selA.value = params.get('a')!;
		if (has(params.get('b'))) selB.value = params.get('b')!;

		selA.addEventListener('change', render);
		selB.addEventListener('change', render);
		onlyCommon.addEventListener('change', render);
		document.getElementById('swap')?.addEventListener('click', () => {
			const t = selA.value; selA.value = selB.value; selB.value = t; render();
		});
		document.querySelectorAll<HTMLButtonElement>('.quick-btn').forEach(btn => btn.addEventListener('click', () => {
			selA.value = btn.dataset.a!; selB.value = btn.dataset.b!; render();
		}));
		render();
	}
</script>

<style>
	.cmp-page {
		--series-a: #2a78d6;
		--series-b: #eb6834;
		--viz-track: rgba(22, 19, 15, 0.06);
		max-width: 980px;
		margin: 0 auto;
	}
	@media (prefers-color-scheme: dark) {
		.cmp-page {
			--series-a: #3987e5;
			--series-b: #d95926;
			--viz-track: rgba(230, 226, 218, 0.07);
		}
	}
	.page-head { margin-bottom: 1.75rem; }
	.kicker {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--accent-color);
		margin: 0 0 0.5rem;
	}
	h1 { font-size: clamp(1.9rem, 4vw, 2.6rem); margin-bottom: 0.75rem; }
	.lead { font-size: 1.05rem; max-width: 46rem; margin: 0; }

	.pickers {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		gap: 0.75rem;
		align-items: end;
		margin-bottom: 0.9rem;
	}
	.picker { display: flex; flex-direction: column; gap: 0.35rem; min-width: 0; }
	.picker-label {
		display: inline-flex; align-items: center; gap: 0.4rem;
		font-family: var(--font-mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em;
	}
	.picker select {
		width: 100%;
		font: inherit;
		font-size: 0.95rem;
		padding: 0.55rem 0.6rem;
		border: 1px solid var(--border-color);
		background: var(--card-bg);
		color: var(--text-color);
		border-radius: 0;
	}
	.picker-a select { border-left: 4px solid var(--series-a); }
	.picker-b select { border-left: 4px solid var(--series-b); }
	.swap {
		height: 2.6rem; width: 2.6rem;
		background: none; border: 1px solid var(--border-color); color: var(--text-color);
		font-size: 1.1rem; cursor: pointer;
	}
	.swap:hover { border-color: var(--text-color); }

	:global(.swatch) {
		display: inline-block; width: 10px; height: 10px; flex-shrink: 0;
	}
	:global(.swatch-a) { background: var(--series-a); }
	:global(.swatch-b) { background: var(--series-b); }

	.quick { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; margin-bottom: 1.5rem; }
	.quick-label { font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted); margin-right: 0.25rem; }
	.quick-btn {
		background: none; border: 1px solid var(--border-color); color: var(--text-color);
		font-size: 0.8rem; padding: 0.3rem 0.6rem; cursor: pointer;
	}
	.quick-btn:hover { border-color: var(--text-color); }

	.result { background: var(--card-bg); border: 1px solid var(--border-color); padding: 1.5rem; }
	.summary {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 1rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--border-color);
		margin-bottom: 0.75rem;
	}
	:global(.score-a), :global(.score-b) { display: flex; align-items: center; gap: 0.6rem; min-width: 0; }
	:global(.score-b) { justify-content: flex-end; text-align: right; }
	:global(.score-a span), :global(.score-b span) { font-weight: 600; overflow: hidden; text-overflow: ellipsis; }
	:global(.score-a strong), :global(.score-b strong) { font-size: 2rem; font-family: var(--font-sans); font-weight: 600; }
	:global(.score-mid) { font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-muted); text-align: center; grid-column: 2; }
	.toggle { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.85rem; cursor: pointer; margin-bottom: 0.5rem; }
	.toggle input { accent-color: var(--accent-color); width: 1rem; height: 1rem; }

	:global(.cmp-page .row) {
		display: grid;
		grid-template-columns: minmax(0, 13rem) minmax(0, 1fr) minmax(0, 13rem);
		gap: 1rem;
		align-items: center;
		padding: 0.7rem 0;
		border-bottom: 1px solid var(--border-color);
	}
	:global(.cmp-page .test strong) { display: block; font-weight: 600; }
	:global(.cmp-page .test .cat) { font-size: 0.75rem; color: var(--text-muted); }
	:global(.cmp-page .sides) { display: flex; flex-direction: column; gap: 0.3rem; }
	:global(.cmp-page .side) { display: grid; grid-template-columns: 4.5rem 1fr; align-items: center; gap: 0.5rem; }
	:global(.cmp-page .side .val) {
		font-family: var(--font-mono); font-size: 0.85rem; text-align: right; font-variant-numeric: tabular-nums; color: var(--text-muted);
	}
	:global(.cmp-page .side.win .val) { color: var(--text-color); font-weight: 600; }
	:global(.cmp-page .track) { height: 10px; background: var(--viz-track); }
	:global(.cmp-page .bar) { display: block; height: 100%; border-radius: 0 4px 4px 0; }
	:global(.cmp-page .side.a .bar) { background: var(--series-a); }
	:global(.cmp-page .side.b .bar) { background: var(--series-b); }
	:global(.cmp-page .verdict) { font-size: 0.85rem; display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap; }
	:global(.cmp-page .verdict.muted) { color: var(--text-muted); }
	:global(.cmp-page .empty) { padding: 1.5rem 0; text-align: center; color: var(--text-muted); }

	.note { font-size: 0.85rem; color: var(--text-muted); margin-top: 1.25rem; }

	@media (max-width: 720px) {
		.pickers { grid-template-columns: 1fr; }
		.swap { justify-self: center; }
		.result { padding: 1rem; }
		:global(.cmp-page .row) { grid-template-columns: 1fr; gap: 0.4rem; }
		.summary { grid-template-columns: 1fr; gap: 0.4rem; }
		:global(.score-b) { flex-direction: row-reverse; justify-content: flex-end; text-align: left; }
		:global(.score-mid) { grid-column: auto; text-align: left; order: 3; }
		:global(.score-a strong), :global(.score-b strong) { font-size: 1.4rem; margin-left: auto; }
		:global(.score-b strong) { margin-left: auto; }
	}
</style>

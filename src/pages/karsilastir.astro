---
import Layout from '../layouts/Layout.astro';
import { loadBenchmarkData } from '../lib/benchmarks';
import { buildStands } from '../lib/stands';
import { categoryName } from '../data/benchmarkCatalog';

const data = loadBenchmarkData();

interface Best { s: number; v: string; st: string | null; src: string; u: string | null }
const benchById = new Map(data.benchmarks.map(b => [b.id, b]));

// Her model + test için en iyi sonuç (varyantlar tek satıra iner)
const best = new Map<string, Record<string, Best>>();
const names = new Map<string, { name: string; provider: string | null }>();
for (const e of data.entries) {
	const b = benchById.get(e.bench);
	if (!b) continue;
	if (!names.has(e.key)) names.set(e.key, { name: e.model, provider: e.provider });
	const rec = best.get(e.key) ?? {};
	const cur = rec[e.bench];
	const better = !cur || (b.higherIsBetter ? e.score > cur.s : e.score < cur.s);
	if (better) rec[e.bench] = { s: e.score, v: e.variant, st: e.setting, src: e.source, u: e.url };
	best.set(e.key, rec);
}

// Karşılaştırılabilir modeller: en az 2 testte skoru olanlar
const models = [...best.entries()]
	.map(([k, rec]) => ({ k, name: names.get(k)!.name, provider: names.get(k)!.provider ?? 'Diğer', n: Object.keys(rec).length }))
	.filter(m => m.n >= 2)
	.sort((a, b) => a.provider.localeCompare(b.provider, 'tr') || b.name.localeCompare(a.name, 'tr', { numeric: true }));

const groups = [...new Set(models.map(m => m.provider))].map(p => ({ p, items: models.filter(m => m.provider === p) }));

// Test başına çubuk ölçeği (sıralama sayfasıyla aynı mantık)
const benches = data.benchmarks.map(b => {
	const vals = data.entries.filter(e => e.bench === b.id).map(e => e.score);
	const max = Math.max(...vals);
	const min = Math.min(...vals);
	let lo = 0, hi = max;
	if (b.unit === '%' && max <= 100) hi = 100;
	if (b.unit.toLowerCase() === 'elo') lo = Math.floor((min - 25) / 25) * 25;
	return { id: b.id, name: b.name, category: categoryName(b.category), unit: b.unit, hib: b.higherIsBetter, lo, hi };
});

// Varsayılan ikili: genel arena sıralamasında öne çıkan iki farklı sağlayıcının en iyi modelleri
const arenaScore = (k: string) => best.get(k)?.['lmarena-text']?.s ?? 0;
const byProvider = new Map<string, string>();
for (const m of [...models].sort((a, b) => arenaScore(b.k) - arenaScore(a.k))) {
	if (m.provider !== 'Diğer' && !byProvider.has(m.provider)) byProvider.set(m.provider, m.k);
}
const leaders = [...byProvider.values()].slice(0, 4);
const pairs: [string, string][] = [];
for (let i = 0; i < leaders.length; i++) for (let j = i + 1; j < leaders.length; j++) pairs.push([leaders[i], leaders[j]]);
const quick = pairs.slice(0, 4).map(([a, b]) => ({ a, b, label: `${names.get(a)!.name} – ${names.get(b)!.name}` }));
const defA = leaders[0] ?? models[0]?.k;
const defB = leaders[1] ?? models[1]?.k;

const scores = Object.fromEntries([...best.entries()].filter(([k]) => models.some(m => m.k === k)));
// Parametre kartları (altıgen) yalnızca seçilebilir modeller için
const stands = Object.fromEntries(buildStands(data.entries).filter(s => scores[s.key]).map(s => [s.key, s]));
const payload = JSON.stringify({ benches, scores, stands, names: Object.fromEntries([...names.entries()].filter(([k]) => scores[k])), defA, defB }).replace(/</g, '\\u003c');
---

<Layout
	title="Model Karşılaştırma | Yöney"
	description="İki yapay zekâ modelini LMArena, SWE-bench ve resmi duyurulardaki ortak testlerde yan yana karşılaştırın."
 palette="kan">
	<div class="cmp-page">
		<header class="page-head">
			<p class="overline">Karşılaştır</p>
			<h1>İki model, <em>karşı karşıya</em></h1>
			<p class="lead">İki model seç; ikisinin de skoru olan testlerde kimin önde olduğunu ve farkı gör. Bir modelin farklı ayarları (çaba seviyesi, düşünme modu) varsa en iyi sonucu kullanılır.</p>
		</header>

		{models.length < 2 ? (
			<p class="empty">Karşılaştırma için yeterli veri yok.</p>
		) : (
			<>
				<div class="vs">
					<label class="fighter fighter-a">
						<span class="fighter-tag">Model A</span>
						<span class="fighter-name" id="nameA" aria-hidden="true"></span>
						<select class="field" id="selA">
							{groups.map(g => (
								<optgroup label={g.p}>
									{g.items.map(m => <option value={m.k} selected={m.k === defA}>{m.name} ({m.n} test)</option>)}
								</optgroup>
							))}
						</select>
					</label>
					<button class="vs-mark" id="swap" type="button" aria-label="Modellerin yerini değiştir" title="Yer değiştir">VS</button>
					<label class="fighter fighter-b">
						<span class="fighter-tag">Model B</span>
						<span class="fighter-name" id="nameB" aria-hidden="true"></span>
						<select class="field" id="selB">
							{groups.map(g => (
								<optgroup label={g.p}>
									{g.items.map(m => <option value={m.k} selected={m.k === defB}>{m.name} ({m.n} test)</option>)}
								</optgroup>
							))}
						</select>
					</label>
				</div>

				{quick.length > 0 && (
					<div class="quick">
						<span class="quick-label">Hızlı seçim:</span>
						{quick.map(q => <button class="quick-btn" type="button" data-a={q.a} data-b={q.b}>{q.label}</button>)}
					</div>
				)}

				<section class="duel" id="duel" aria-label="Parametre karşılaştırması">
					<div class="duel-chart" id="duelChart"></div>
					<div class="duel-side">
						<h2 class="duel-title">Parametreler</h2>
						<p class="duel-note">LMArena sıralamalarına göre: ilk %10 <strong>A</strong> … son dilim <strong>E</strong>, veri yoksa <strong>?</strong></p>
						<table class="duel-grades">
							<thead><tr><th>Eksen</th><th class="ga">A</th><th class="gb">B</th></tr></thead>
							<tbody id="duelGrades"></tbody>
						</table>
					</div>
				</section>

				<section class="result" aria-live="polite">
					<div class="summary" id="summary"></div>
					<label class="toggle">
						<input type="checkbox" id="onlyCommon" checked />
						<span>Yalnızca ikisinin de skoru olan testler</span>
					</label>
					<div class="rows" id="rows"></div>
				</section>

				<p class="note">Skorlar farklı kaynaklardan ve farklı tarihlerden gelir. LMArena skorları (ELO) insan oylarına dayalı görelidir; SWE-bench skorları model ile ajan sisteminin birlikte aldığı sonuçtur. Ayrıntılar için <a href="/benchmarklar">Benchmark</a> sayfasına bak.</p>
			</>
		)}
	</div>
	<script type="application/json" id="cmp-data" set:html={payload} />
</Layout>

<script>
	import { esc, fmtScore } from '../lib/leaderboard';
	import { AXES, standSvg, type StandCard } from '../lib/standChart';

	interface Bench { id: string; name: string; category: string; unit: string; hib: boolean; lo: number; hi: number }
	interface Best { s: number; v: string; st: string | null; src: string; u: string | null }

	const raw = document.getElementById('cmp-data');
	const selA = document.getElementById('selA') as HTMLSelectElement | null;
	const selB = document.getElementById('selB') as HTMLSelectElement | null;

	if (raw && selA && selB) {
		const data = JSON.parse(raw.textContent || '{}') as {
			benches: Bench[];
			scores: Record<string, Record<string, Best>>;
			stands: Record<string, StandCard>;
			names: Record<string, { name: string; provider: string | null }>;
			defA: string;
			defB: string;
		};
		const rowsEl = document.getElementById('rows')!;
		const summaryEl = document.getElementById('summary')!;
		const onlyCommon = document.getElementById('onlyCommon') as HTMLInputElement;
		const duel = document.getElementById('duel')!;
		const duelChart = document.getElementById('duelChart')!;
		const duelGrades = document.getElementById('duelGrades')!;
		const nameAEl = document.getElementById('nameA')!;
		const nameBEl = document.getElementById('nameB')!;

		const width = (b: Bench, v: number) => {
			const pct = ((v - b.lo) / ((b.hi - b.lo) || 1)) * 100;
			return Math.max(1.5, Math.min(100, b.hib ? pct : 100 - pct));
		};
		const diffText = (b: Bench, d: number) => {
			const n = Math.abs(d).toLocaleString('tr-TR', { maximumFractionDigits: 2 });
			if (b.unit === '%') return `${n} puan`;
			return `${n} ${b.unit}`;
		};

		function side(cls: string, b: Bench, r: Best | undefined, win: boolean) {
			if (!r) return `<div class="side ${cls} none"><span class="val">—</span><span class="track"></span></div>`;
			const extra = [r.v, r.st].filter(Boolean).join(' · ');
			return `<div class="side ${cls}${win ? ' win' : ''}" title="${esc(extra ? `${extra} · ${r.src}` : r.src)}">
				<span class="val">${esc(fmtScore(r.s, b.unit))}</span>
				<span class="track"><span class="bar" style="width:${width(b, r.s).toFixed(1)}%"></span></span>
			</div>`;
		}

		function renderDuel(a: string, b: string) {
			const sa = data.stands[a], sb = data.stands[b];
			if (!sa && !sb) {
				duel.hidden = true;
				return;
			}
			duel.hidden = false;
			const series = [sa && { card: sa, color: 'var(--a2)' }, sb && { card: sb, color: 'var(--a3)' }].filter(Boolean) as { card: StandCard; color: string }[];
			duelChart.innerHTML = standSvg(series, { size: 340, title: 'Parametre karşılaştırması' });
			// Tabloyu baştan çizerken şekil sıfırdan büyüsün
			const svg = duelChart.querySelector('svg');
			if (svg) requestAnimationFrame(() => requestAnimationFrame(() => svg.classList.add('live')));
			duelGrades.innerHTML = AXES.map(ax => {
				const ga = sa?.axes[ax.id]?.grade ?? '?';
				const gb = sb?.axes[ax.id]?.grade ?? '?';
				return `<tr><td>${esc(ax.label)}</td><td class="ga" data-g="${ga}">${ga}</td><td class="gb" data-g="${gb}">${gb}</td></tr>`;
			}).join('');
		}

		function render() {
			const a = selA!.value, bKey = selB!.value;
			const A = data.scores[a] ?? {}, B = data.scores[bKey] ?? {};
			const nameA = data.names[a]?.name ?? a, nameB = data.names[bKey]?.name ?? bKey;
			nameAEl.textContent = nameA;
			nameBEl.textContent = nameB;
			let winsA = 0, winsB = 0, common = 0;
			const html: string[] = [];
			for (const b of data.benches) {
				const ra = A[b.id], rb = B[b.id];
				if (!ra && !rb) continue;
				const both = !!(ra && rb);
				if (!both && onlyCommon.checked) continue;
				let verdict = '<span class="verdict muted">Ortak veri yok</span>';
				let winA = false, winB = false;
				if (both) {
					common++;
					const d = ra!.s - rb!.s;
					if (d === 0) verdict = '<span class="verdict">Berabere</span>';
					else {
						winA = b.hib ? d > 0 : d < 0;
						winB = !winA;
						if (winA) winsA++; else winsB++;
						verdict = `<span class="verdict"><i class="swatch ${winA ? 'swatch-a' : 'swatch-b'}"></i>${esc(winA ? nameA : nameB)} <strong>+${esc(diffText(b, d))}</strong></span>`;
					}
				}
				html.push(`<div class="row">
					<div class="test"><strong>${esc(b.name)}</strong><span class="cat">${esc(b.category)}</span></div>
					<div class="sides">${side('a', b, ra, winA)}${side('b', b, rb, winB)}</div>
					${verdict}
				</div>`);
			}
			rowsEl.innerHTML = html.length ? html.join('') : '<p class="empty">Bu iki modelin ortak testi yok. Ortak olmayanları görmek için yukarıdaki seçeneği kapat.</p>';
			summaryEl.innerHTML = common
				? `<div class="score-a"><span>${esc(nameA)}</span><strong>${winsA}</strong></div>
				   <div class="score-mid">${common} ortak test</div>
				   <div class="score-b"><strong>${winsB}</strong><span>${esc(nameB)}</span></div>`
				: `<div class="score-mid">${esc(nameA)} ile ${esc(nameB)} arasında ortak test yok</div>`;
			renderDuel(a, bKey);
			history.replaceState(null, '', `#a=${encodeURIComponent(a)}&b=${encodeURIComponent(bKey)}`);
		}

		const params = new URLSearchParams(location.hash.slice(1));
		const has = (k: string | null) => !!k && Array.from(selA.options).some(o => o.value === k);
		if (has(params.get('a'))) selA.value = params.get('a')!;
		if (has(params.get('b'))) selB.value = params.get('b')!;

		selA.addEventListener('change', render);
		selB.addEventListener('change', render);
		onlyCommon.addEventListener('change', render);
		const swapBtn = document.getElementById('swap');
		swapBtn?.addEventListener('click', () => {
			const t = selA.value; selA.value = selB.value; selB.value = t;
			swapBtn.classList.remove('spin');
			void swapBtn.offsetWidth;
			swapBtn.classList.add('spin');
			render();
		});
		document.querySelectorAll<HTMLButtonElement>('.quick-btn').forEach(btn => btn.addEventListener('click', () => {
			selA.value = btn.dataset.a!; selB.value = btn.dataset.b!; render();
		}));
		render();
	}
</script>

<style>
	.cmp-page {
		--series-a: var(--a2);
		--series-b: var(--a3);
		max-width: 1140px;
		margin: 0 auto;
	}

	/* ---------- VS sahnesi ---------- */
	.vs {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr) 0 minmax(0, 1fr);
		margin-bottom: 18px;
		border: 3px solid var(--line);
		box-shadow: 12px 12px 0 var(--shadow);
	}

	.fighter {
		display: flex;
		flex-direction: column;
		gap: 12px;
		min-width: 0;
		min-height: 230px;
		padding: 24px 28px 26px;
		color: var(--on-a2);
	}

	.fighter-a {
		background: var(--series-a);
		clip-path: polygon(0 0, 100% 0, calc(100% - 40px) 100%, 0 100%);
		padding-right: 70px;
	}

	.fighter-b {
		grid-column: 3;
		align-items: flex-end;
		text-align: right;
		background: var(--series-b);
		color: var(--on-a1);
		margin-left: -40px;
		padding-left: 80px;
		clip-path: polygon(40px 0, 100% 0, 100% 100%, 0 100%);
	}

	.fighter-tag {
		font-size: 0.72rem;
		font-weight: 900;
		font-stretch: 80%;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.fighter-name {
		flex: 1;
		display: flex;
		align-items: center;
		font-family: var(--font-display);
		font-size: clamp(1.8rem, 3.8vw, 3.3rem);
		line-height: 0.95;
		text-transform: uppercase;
		text-shadow: 4px 4px 0 rgba(23, 15, 51, 0.35);
		overflow-wrap: anywhere;
	}

	.fighter .field {
		height: 46px;
		max-width: 100%;
		border-color: currentColor;
		background: rgba(255, 255, 255, 0.92);
		color: #170f33;
		font-weight: 700;
		cursor: pointer;
	}

	.vs-mark {
		position: absolute;
		left: 50%;
		top: 50%;
		z-index: 3;
		width: 92px;
		height: 92px;
		display: grid;
		place-items: center;
		margin: -46px 0 0 -46px;
		border: 3px solid var(--line);
		border-radius: 50%;
		background: var(--a1);
		color: var(--on-a1);
		font-family: var(--font-display);
		font-size: 2.3rem;
		letter-spacing: 0.02em;
		box-shadow: 6px 6px 0 var(--shadow);
		cursor: pointer;
		transition: transform 0.3s var(--ease-pose);
	}

	.vs-mark:hover {
		transform: rotate(-12deg) scale(1.08);
	}

	.vs-mark.spin {
		animation: vs-spin 0.6s var(--ease-pose);
	}

	@keyframes vs-spin {
		from { transform: rotate(-360deg) scale(0.6); }
	}

	:global(.cmp-page .swatch-a) { background: var(--series-a); }
	:global(.cmp-page .swatch-b) { background: var(--series-b); }

	.quick {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px 16px;
		margin: 28px 0 56px;
	}

	.quick-label {
		color: var(--muted);
		font-size: 0.7rem;
		font-weight: 900;
		font-stretch: 80%;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.quick-btn {
		padding: 2px 0;
		border: 0;
		border-bottom: 2px solid var(--rule);
		background: none;
		color: var(--text);
		font: inherit;
		font-family: var(--font-serif);
		font-size: 1rem;
		font-style: italic;
		font-weight: 700;
		cursor: pointer;
	}

	.quick-btn:hover {
		border-color: var(--a1);
		color: var(--a1);
	}

	/* ---------- Parametre düellosu ---------- */
	.duel {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 40px;
		align-items: center;
		margin-bottom: 64px;
		padding: 32px;
		background: var(--surface);
		border: 3px solid var(--line);
		box-shadow: 12px 12px 0 var(--a1);
	}

	.duel-chart {
		max-width: 400px;
		width: 100%;
		margin: 0 auto;
	}

	.duel-title {
		margin: 0 0 6px;
		font-size: 2.2rem;
		text-transform: uppercase;
	}

	.duel-note {
		margin: 0 0 18px;
		color: var(--muted);
		font-size: 0.86rem;
	}

	.duel-note strong {
		color: var(--a1);
		font-family: var(--font-display);
		font-weight: 400;
	}

	.duel-grades {
		width: 100%;
		border-collapse: collapse;
	}

	.duel-grades th {
		padding: 8px 6px;
		color: var(--muted);
		font-size: 0.7rem;
		font-weight: 900;
		font-stretch: 80%;
		letter-spacing: 0.14em;
		text-align: left;
		text-transform: uppercase;
		border-bottom: 2px solid var(--line);
	}

	.duel-grades th.ga { color: var(--series-a); text-align: center; }
	.duel-grades th.gb { color: var(--series-b); text-align: center; }

	.duel-grades :global(td) {
		padding: 9px 6px;
		border-bottom: 1px solid var(--rule);
		font-weight: 700;
	}

	.duel-grades :global(td.ga),
	.duel-grades :global(td.gb) {
		width: 64px;
		font-family: var(--font-display);
		font-size: 1.5rem;
		font-weight: 400;
		text-align: center;
	}

	.duel-grades :global(td.ga) { color: var(--series-a); }
	.duel-grades :global(td.gb) { color: var(--series-b); }
	.duel-grades :global(td[data-g='?']) { color: var(--muted); }

	/* ---------- Skor tabelası ---------- */
	.summary {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 20px;
		margin-bottom: 22px;
		padding: 26px 0;
		border-top: 3px solid var(--line);
		border-bottom: 1px solid var(--rule);
	}

	:global(.score-a),
	:global(.score-b) {
		display: flex;
		align-items: center;
		gap: 16px;
		min-width: 0;
	}

	:global(.score-b) {
		justify-content: flex-end;
		text-align: right;
	}

	:global(.score-a span),
	:global(.score-b span) {
		overflow: hidden;
		font-family: var(--font-display);
		font-size: 1.5rem;
		line-height: 1.05;
		text-overflow: ellipsis;
		text-transform: uppercase;
	}

	:global(.score-a strong),
	:global(.score-b strong) {
		font-family: var(--font-display);
		font-size: 4.6rem;
		font-weight: 400;
		line-height: 0.9;
		font-variant-numeric: tabular-nums;
		text-shadow: 5px 5px 0 var(--shadow);
	}

	:global(.score-a strong) { color: var(--series-a); }
	:global(.score-b strong) { color: var(--series-b); }

	:global(.score-mid) {
		grid-column: 2;
		color: var(--text-2);
		font-family: var(--font-serif);
		font-size: 1.05rem;
		font-style: italic;
		font-weight: 700;
		text-align: center;
		white-space: nowrap;
	}

	.toggle {
		display: inline-flex;
		align-items: center;
		gap: 9px;
		margin-bottom: 10px;
		color: var(--text-2);
		font-size: 0.88rem;
		cursor: pointer;
	}

	.toggle input {
		width: 1.1rem;
		height: 1.1rem;
		accent-color: var(--a2);
	}

	:global(.cmp-page .row) {
		display: grid;
		grid-template-columns: minmax(0, 14rem) minmax(0, 1fr) minmax(0, 13rem);
		align-items: center;
		gap: 20px;
		padding: 16px 0;
		border-bottom: 1px solid var(--rule);
	}

	:global(.cmp-page .test strong) {
		display: block;
		font-family: var(--font-display);
		font-size: 1.15rem;
		font-weight: 400;
		line-height: 1.1;
		text-transform: uppercase;
	}

	:global(.cmp-page .test .cat) {
		color: var(--muted);

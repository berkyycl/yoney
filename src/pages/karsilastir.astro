---
import Layout from '../layouts/Layout.astro';
import fs from 'fs';
import path from 'path';

const benchmarkFile = path.join(process.cwd(), 'data', 'benchmarks.json');
let benchmarks = [];
if (fs.existsSync(benchmarkFile)) {
    benchmarks = JSON.parse(fs.readFileSync(benchmarkFile, 'utf-8'));
}

// Get unique models
const models = Array.from(new Set(benchmarks.map(b => b.model))).sort();
---

<Layout title="Modelleri Karşılaştır | Yöney">
	<div class="compare-page">
		<div class="header-section">
			<span class="badge">Kafa Kafaya Karşılaştırma</span>
			<h1>Modelleri Karşılaştır</h1>
			<p class="subtitle">İki yapay zekâ modelini doğrulanmış benchmark testlerine, skor farklarına ve kaynaklarına göre kafa kafaya kıyaslayın.</p>
		</div>

		{models.length < 2 ? (
			<div class="empty-state">
				<p>Karşılaştırma yapabilmek için henüz yeterli benchmark verisi toplanmadı.</p>
			</div>
		) : (
			<div class="comparison-tool">
				<div class="selectors-card">
					<div class="select-group">
						<label for="modelA">1. Model:</label>
						<select id="modelA">
							{models.map((m, idx) => (
								<option value={m} selected={m === 'GPT-4o' || (m !== 'Claude 3.5 Sonnet' && idx === 0)}>{m}</option>
							))}
						</select>
					</div>

					<div class="vs-circle">VS</div>

					<div class="select-group">
						<label for="modelB">2. Model:</label>
						<select id="modelB">
							{models.map((m, idx) => (
								<option value={m} selected={m === 'Claude 3.5 Sonnet' || (m !== 'GPT-4o' && idx === 1)}>{m}</option>
							))}
						</select>
					</div>
				</div>

				<div class="stats-summary" id="statsSummary"></div>

				<div class="results-table-container">
					<table id="compareTable">
						<thead>
							<tr>
								<th>Benchmark / Metrik</th>
								<th id="thModelA">Model A</th>
								<th id="thModelB">Model B</th>
								<th>Skor Farkı</th>
								<th>Açıklama / Durum</th>
							</tr>
						</thead>
						<tbody id="compareBody">
						</tbody>
					</table>
				</div>
			</div>
		)}
	</div>
</Layout>

<script is:inline define:vars={{ benchmarks }}>
	const allBenchmarks = benchmarks;

	function updateComparison() {
		const selA = document.getElementById('modelA');
		const selB = document.getElementById('modelB');
		if (!selA || !selB) return;

		const modelA = selA.value;
		const modelB = selB.value;

		document.getElementById('thModelA').textContent = modelA;
		document.getElementById('thModelB').textContent = modelB;

		const benchmarksA = allBenchmarks.filter(b => b.model === modelA);
		const benchmarksB = allBenchmarks.filter(b => b.model === modelB);

		// Unique tests
		const testNames = Array.from(new Set([
			...benchmarksA.map(b => b.benchmark),
			...benchmarksB.map(b => b.benchmark)
		])).sort();

		const tbody = document.getElementById('compareBody');
		const statsSummary = document.getElementById('statsSummary');
		tbody.innerHTML = '';

		let winsA = 0;
		let winsB = 0;
		let commonCount = 0;

		testNames.forEach(test => {
			const itemA = benchmarksA.find(b => b.benchmark === test);
			const itemB = benchmarksB.find(b => b.benchmark === test);

			const tr = document.createElement('tr');
			const tdName = document.createElement('td');
			tdName.innerHTML = `<strong>${test}</strong>`;

			const tdA = document.createElement('td');
			tdA.className = 'tabular';
			tdA.textContent = itemA ? `${itemA.skor} ${itemA.birim}` : 'Veri yok';

			const tdB = document.createElement('td');
			tdB.className = 'tabular';
			tdB.textContent = itemB ? `${itemB.skor} ${itemB.birim}` : 'Veri yok';

			const tdDiff = document.createElement('td');
			tdDiff.className = 'tabular';

			const tdStatus = document.createElement('td');
			tdStatus.className = 'status-cell';

			if (itemA && itemB) {
				commonCount++;
				const higherIsBetter = itemA.yuksek_iyi_mi !== false;
				const diffVal = Number((itemA.skor - itemB.skor).toFixed(2));
				
				if (diffVal === 0) {
					tdDiff.textContent = 'Eşit (0)';
					tdStatus.innerHTML = '<span class="pill-tie">Berabere</span>';
				} else {
					const isAWinner = higherIsBetter ? diffVal > 0 : diffVal < 0;
					const formattedDiff = Math.abs(diffVal) + ` ${itemA.birim}`;
					
					if (isAWinner) {
						winsA++;
						tdDiff.innerHTML = `<span class="win-a">+${formattedDiff} (${modelA})</span>`;
						tdStatus.innerHTML = `<span class="pill-a">${modelA} Önde</span>`;
					} else {
						winsB++;
						tdDiff.innerHTML = `<span class="win-b">+${formattedDiff} (${modelB})</span>`;
						tdStatus.innerHTML = `<span class="pill-b">${modelB} Önde</span>`;
					}
				}
			} else {
				tdDiff.textContent = '-';
				tdStatus.innerHTML = `<span class="pill-na">Ortak test yok</span>`;
			}

			tr.appendChild(tdName);
			tr.appendChild(tdA);
			tr.appendChild(tdB);
			tr.appendChild(tdDiff);
			tr.appendChild(tdStatus);
			tbody.appendChild(tr);
		});

		if (statsSummary) {
			if (commonCount > 0) {
				statsSummary.innerHTML = `
					<div class="stat-box">
						<span class="stat-label">Ortak Metrikler</span>
						<span class="stat-value">${commonCount} Test</span>
					</div>
					<div class="stat-box">
						<span class="stat-label">${modelA}</span>
						<span class="stat-value stat-lead">${winsA} Kazanma</span>
					</div>
					<div class="stat-box">
						<span class="stat-label">${modelB}</span>
						<span class="stat-value stat-lead">${winsB} Kazanma</span>
					</div>
				`;
			} else {
				statsSummary.innerHTML = `
					<div class="stat-notice">
						Bu iki model arasında henüz aynı test parametresinde ortak metrik bulunmuyor. Diğer modelleri seçerek kıyaslayabilirsiniz.
					</div>
				`;
			}
		}
	}

	window.addEventListener('DOMContentLoaded', () => {
		const selA = document.getElementById('modelA');
		const selB = document.getElementById('modelB');
		if (selA && selB) {
			selA.addEventListener('change', updateComparison);
			selB.addEventListener('change', updateComparison);
			updateComparison();
		}
	});

	if (document.readyState === 'complete' || document.readyState === 'interactive') {
		const selA = document.getElementById('modelA');
		const selB = document.getElementById('modelB');
		if (selA && selB) {
			selA.addEventListener('change', updateComparison);
			selB.addEventListener('change', updateComparison);
			updateComparison();
		}
	}
</script>

<style>
	.compare-page {
		max-width: 1000px;
		margin: 0 auto;
	}

	.header-section {
		margin-bottom: 2.5rem;
	}

	.badge {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		text-transform: uppercase;
		background: var(--text-color);
		color: var(--bg-color);
		padding: 0.2rem 0.5rem;
		display: inline-block;
		margin-bottom: 0.75rem;
	}

	h1 {
		font-size: 2.4rem;
		margin: 0 0 0.5rem 0;
	}

	.subtitle {
		font-size: 1.1rem;
		color: var(--secondary-color);
		line-height: 1.6;
	}

	.selectors-card {
		display: flex;
		align-items: center;
		justify-content: space-around;
		gap: 1.5rem;
		margin-bottom: 2rem;
		padding: 2rem;
		background: #ffffff;
		border: 1px solid var(--border-color);
		box-shadow: 0 2px 8px rgba(0,0,0,0.03);
	}

	.select-group {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		flex: 1;
		max-width: 380px;
	}

	.select-group label {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		text-transform: uppercase;
		font-weight: 600;
	}

	select {
		padding: 0.75rem 1rem;
		font-family: var(--font-sans);
		font-size: 1.05rem;
		border: 1px solid var(--border-color);
		background: var(--bg-color);
		color: var(--text-color);
		border-radius: 4px;
		cursor: pointer;
		font-weight: 500;
	}

	.vs-circle {
		font-family: var(--font-mono);
		font-weight: 700;
		color: #ffffff;
		background: var(--accent-color);
		width: 48px;
		height: 48px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 1.1rem;
		flex-shrink: 0;
		box-shadow: 0 2px 6px rgba(194, 54, 31, 0.3);
	}

	.stats-summary {
		display: flex;
		gap: 1.5rem;
		margin-bottom: 2rem;
	}

	:global(.stat-box) {
		flex: 1;
		background: #ffffff;
		border: 1px solid var(--border-color);
		padding: 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	:global(.stat-label) {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		text-transform: uppercase;
		color: var(--secondary-color);
	}

	:global(.stat-value) {
		font-size: 1.4rem;
		font-weight: 700;
		font-family: var(--font-mono);
	}

	:global(.stat-lead) {
		color: var(--accent-color);
	}

	:global(.stat-notice) {
		width: 100%;
		padding: 1rem;
		background: rgba(0,0,0,0.03);
		border: 1px solid var(--border-color);
		font-family: var(--font-mono);
		font-size: 0.9rem;
	}

	.results-table-container {
		background: #ffffff;
		border: 1px solid var(--border-color);
		overflow-x: auto;
	}

	table {
		width: 100%;
		border-collapse: collapse;
		font-family: var(--font-sans);
	}

	th, td {
		border-bottom: 1px solid var(--border-color);
		padding: 1rem 1.25rem;
		text-align: left;
	}

	th {
		background: rgba(0,0,0,0.02);
		font-family: var(--font-mono);
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	.tabular {
		font-family: var(--font-mono);
		font-size: 0.95rem;
	}

	:global(.win-a) {
		color: #1a73e8;
		font-weight: 600;
	}

	:global(.win-b) {
		color: #188038;
		font-weight: 600;
	}

	:global(.pill-a) {
		background: rgba(26, 115, 232, 0.1);
		color: #1a73e8;
		padding: 0.2rem 0.5rem;
		font-size: 0.75rem;
		font-family: var(--font-mono);
		font-weight: 600;
	}

	:global(.pill-b) {
		background: rgba(24, 128, 56, 0.1);
		color: #188038;
		padding: 0.2rem 0.5rem;
		font-size: 0.75rem;
		font-family: var(--font-mono);
		font-weight: 600;
	}

	:global(.pill-tie) {
		background: rgba(0,0,0,0.06);
		color: var(--secondary-color);
		padding: 0.2rem 0.5rem;
		font-size: 0.75rem;
		font-family: var(--font-mono);
	}

	:global(.pill-na) {
		color: #888;
		font-size: 0.8rem;
		font-family: var(--font-mono);
	}

	@media (max-width: 768px) {
		.selectors-card {
			flex-direction: column;
		}
		.select-group {
			width: 100%;
			max-width: none;
		}
		.stats-summary {
			flex-direction: column;
		}
	}
</style>

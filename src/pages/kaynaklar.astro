---
import Layout from '../layouts/Layout.astro';
import fs from 'fs';
import path from 'path';

const sourcesFile = path.join(process.cwd(), 'config', 'sources.json');
let sources: any[] = [];
if (fs.existsSync(sourcesFile)) {
    sources = JSON.parse(fs.readFileSync(sourcesFile, 'utf-8'));
}

const TIER: Record<string, string> = { resmi: 'Resmi', bagimsiz: 'Bağımsız basın', topluluk: 'Topluluk' };
// Topluluk tarafından üretilen akışlar GitHub'dan okunuyor; listede asıl site gösterilir
const SITE: Record<string, string> = {
	'anthropic-news': 'anthropic.com/news',
	'anthropic-research': 'anthropic.com/research',
	'xai-news': 'x.ai/news',
	'mistral-news': 'mistral.ai/news',
};
const host = (s: any) => { try { return SITE[s.id] ?? new URL(s.url).hostname.replace(/^www\./, ''); } catch { return s.url; } };
const byActive = (a: any, b: any) => Number(b.enabled) - Number(a.enabled);
const groups = [
	{ title: 'Laboratuvarların kendi duyuruları', items: sources.filter(s => s.type !== 'benchmark_api' && s.tier === 'resmi').sort(byActive) },
	{ title: 'Bağımsız basın', items: sources.filter(s => s.type !== 'benchmark_api' && s.tier === 'bagimsiz').sort(byActive) },
	{ title: 'Topluluk', items: sources.filter(s => s.type !== 'benchmark_api' && s.tier === 'topluluk').sort(byActive) },
	{ title: 'Canlı liderlik tabloları', items: sources.filter(s => s.type === 'benchmark_api').sort(byActive) },
].filter(g => g.items.length > 0);
const activeCount = sources.filter(s => s.enabled).length;

const STEPS = [
	{ t: 'Tarama', d: 'RSS akışları her 3 saatte bir taranır. Benchmark liderlik tabloları (LMArena, SWE-bench) günde iki kez güncellenir.' },
	{ t: 'Yapay zekâ analizi', d: 'Yeni içerikler büyük dil modelleriyle (öncelikle Groq üzerinde gpt-oss-120b, gerekirse Gemini) analiz edilir ve Türkçe özetlenir. Reklam ve müşteri hikâyesi niteliğindeki içerikler yayınlanmaz.' },
	{ t: 'Doğrulama', d: 'Yapay zekânın çıkardığı benchmark skorları kaynak metinle karşılaştırılır; metinde birebir geçmeyen skorlar eklenmez.' },
	{ t: 'Yayın', d: 'Haberler ve skorlar statik sayfalar olarak derlenip birkaç dakika içinde yayına alınır.' },
];
---

<Layout title="Kaynaklar | Yöney" description="Yöney'in haber ve benchmark verilerini topladığı kaynaklar ve içeriklerin nasıl hazırlandığı.">
	<div class="sources-page">
		<header class="page-head">
			<p class="overline">Kaynaklar</p>
			<h1>Bilgi <em>nereden</em> geliyor?</h1>
			<p class="lead">Yöney {activeCount} kaynağı izler. Her haberin altında orijinal kaynağa bağlantı bulunur; özetler hiçbir zaman kaynağın yerine geçmez.</p>
		</header>

		{groups.map((g, i) => (
			<section class="group">
				<div class="section-head">
					<span class="sec-num">{String(i + 1).padStart(2, '0')}</span>
					<h2>{g.title}</h2>
				</div>
				<ul class="source-list">
					{g.items.map(s => (
						<li class:list={['source', { off: !s.enabled }]}>
							<a class="source-name" href={s.url} target="_blank" rel="noopener noreferrer" lang="en">{s.name}</a>
							<p class="source-host">{host(s)}</p>
							<p class="source-info">
								<span class:list={['status', s.enabled ? 'on' : 'off']}>{s.enabled ? 'Aktif' : 'Pasif'}</span>
								<span>{TIER[s.tier] ?? s.tier}</span>
								<span>{s.type === 'benchmark_api' ? 'Liderlik tablosu' : 'RSS akışı'}{s.maxItems ? ` · turda en fazla ${s.maxItems}` : ''}</span>
							</p>
							{s.note && <p class="source-note">{s.note}</p>}
						</li>
					))}
				</ul>
			</section>
		))}

		<section class="how">
			<div class="section-head">
				<span class="sec-num">→</span>
				<h2>Nasıl çalışır?</h2>
			</div>
			<ol class="steps">
				{STEPS.map((s, i) => (
					<li class="step">
						<span class="step-num">{i + 1}</span>
						<h3>{s.t}</h3>
						<p>{s.d}</p>
					</li>
				))}
			</ol>
		</section>
	</div>
</Layout>

<style>
	.sources-page {
		max-width: 1080px;
		margin: 0 auto;
	}

	.group {
		margin-bottom: 56px;
	}

	.source-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		column-gap: 48px;
	}

	.source {
		padding: 18px 0;
		border-bottom: 1px solid var(--rule);
	}

	.source.off {
		opacity: 0.55;
	}

	.source-name {
		color: var(--ink);
		font-family: var(--font-display);
		font-size: 1.35rem;
		font-weight: 800;
		line-height: 1.15;
		text-decoration: none;
	}

	.source-name:hover {
		color: var(--link);
	}

	.source-name::after {
		content: ' ↗';
		color: var(--ink-3);
		font-family: var(--font-sans);
		font-size: 0.8em;
		font-weight: 500;
	}

	.source-host {
		margin: 2px 0 8px;
		color: var(--ink-3);
		font-size: 0.85rem;
	}

	.source-info {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 14px;
		margin: 0;
		color: var(--ink-2);
		font-size: 0.7rem;
		font-weight: 800;
		font-stretch: 82%;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.status::before {
		content: '';
		display: inline-block;
		width: 7px;
		height: 7px;
		margin-right: 6px;
		border-radius: 50%;
		background: var(--ink-3);
		vertical-align: 1px;
	}

	.status.on {
		color: var(--teal);
	}

	.status.on::before {
		background: var(--teal);
	}

	.source-note {
		margin: 8px 0 0;
		color: var(--ink-3);
		font-family: var(--font-display);
		font-size: 0.95rem;
		font-style: italic;
		line-height: 1.4;
	}

	.steps {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
	}

	.step {
		padding: 4px 22px 0;
		border-left: 1px solid var(--rule-strong);
	}

	.step:first-child {
		padding-left: 0;
		border-left: 0;
	}

	.step-num {
		display: block;
		margin-bottom: 8px;
		color: var(--magenta);
		font-family: var(--font-display);
		font-size: 3.4rem;
		font-style: italic;
		font-weight: 900;
		line-height: 1;
	}

	.step h3 {
		margin-bottom: 8px;
		font-size: 1.2rem;
	}

	.step p {
		margin: 0;
		color: var(--ink-2);
		font-size: 0.92rem;
		line-height: 1.55;
	}

	@media (max-width: 860px) {
		.source-list {
			grid-template-columns: 1fr;
		}
		.steps {
			grid-template-columns: 1fr 1fr;
			row-gap: 28px;
		}
		.step:nth-child(odd) {
			padding-left: 0;
			border-left: 0;
		}
	}

	@media (max-width: 560px) {
		.steps {
			grid-template-columns: 1fr;
		}
		.step {
			padding-left: 0;
			border-left: 0;
		}
	}
</style>

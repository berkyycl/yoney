---
import Layout from '../layouts/Layout.astro';
import fs from 'fs';
import path from 'path';

const sourcesFile = path.join(process.cwd(), 'config', 'sources.json');
let sources: any[] = [];
if (fs.existsSync(sourcesFile)) {
    sources = JSON.parse(fs.readFileSync(sourcesFile, 'utf-8'));
}

const TIER: Record<string, string> = { resmi: 'Resmi', bagimsiz: 'Bağımsız', topluluk: 'Topluluk' };
// Topluluk tarafından üretilen akışlar GitHub'dan okunuyor; kartta asıl site gösterilir
const SITE: Record<string, string> = { 'anthropic-news': 'anthropic.com/news', 'anthropic-research': 'anthropic.com/research' };
const host = (s: any) => { try { return SITE[s.id] ?? new URL(s.url).hostname.replace(/^www\./, ''); } catch { return s.url; } };
const byActive = (a: any, b: any) => Number(b.enabled) - Number(a.enabled);
const groups = [
	{ title: 'Haber kaynakları', desc: 'Yapay zekâ laboratuvarlarının kendi duyuruları, bağımsız teknoloji basını ve topluluk.', items: sources.filter(s => s.type !== 'benchmark_api').sort(byActive) },
	{ title: 'Benchmark kaynakları', desc: 'Canlı liderlik tabloları; skorlar doğrudan buradan çekilir.', items: sources.filter(s => s.type === 'benchmark_api').sort(byActive) },
].filter(g => g.items.length > 0);

const STEPS = [
	{ t: 'Tarama', d: 'RSS akışları her 3 saatte bir taranır. Benchmark liderlik tabloları (LMArena, SWE-bench) günde iki kez güncellenir.' },
	{ t: 'Yapay zekâ analizi', d: 'Yeni içerikler büyük dil modelleriyle (öncelikle Groq üzerinde gpt-oss-120b, gerekirse Gemini) analiz edilir ve Türkçe özetlenir. Reklam ve müşteri hikâyesi niteliğindeki içerikler yayınlanmaz.' },
	{ t: 'Doğrulama', d: 'Yapay zekânın çıkardığı benchmark skorları kaynak metinle karşılaştırılır; metinde birebir geçmeyen skorlar eklenmez.' },
	{ t: 'Yayın', d: 'Haberler ve skorlar statik sayfalar olarak derlenip birkaç dakika içinde yayına alınır.' },
];
---

<Layout title="Kaynaklar | Yöney" description="Yöney'in haber ve benchmark verilerini topladığı kaynaklar ve içeriklerin nasıl hazırlandığı.">
	<div class="sources-page">
		<header class="page-head">
			<p class="kicker">Kaynaklar</p>
			<h1>Bilgi nereden geliyor?</h1>
			<p class="lead">Yöney yalnızca aşağıdaki kaynakları izler. Her haberin altında orijinal kaynağa bağlantı bulunur.</p>
		</header>

		{groups.map(g => (
			<section class="group">
				<div class="group-head">
					<h2>{g.title}</h2>
					<p class="muted">{g.desc}</p>
				</div>
				<div class="source-grid">
					{g.items.map(s => (
						<a class:list={['source-card', { off: !s.enabled }]} href={s.url} target="_blank" rel="noopener noreferrer">
							<div class="source-top">
								<span class="avatar" aria-hidden="true">{s.name.charAt(0)}</span>
								<span class={`tier tier-${s.tier}`}>{TIER[s.tier] ?? s.tier}</span>
							</div>
							<h3 lang="en">{s.name}</h3>
							<p class="source-host">{host(s)}</p>
							<p class="source-info">
								<span class:list={['status', s.enabled ? 'on' : 'off']}>{s.enabled ? 'Aktif' : 'Pasif'}</span>
								{s.type === 'benchmark_api' ? 'Liderlik tablosu' : 'RSS akışı'}{s.maxItems ? ` · turda en fazla ${s.maxItems}` : ''}
							</p>
							{s.note && <p class="source-note">{s.note}</p>}
						</a>
					))}
				</div>
			</section>
		))}

		<section class="how">
			<div class="group-head">
				<h2>Nasıl çalışır?</h2>
				<p class="muted">Her şey otomatik; insan eli değmeden 3 saatte bir tekrarlanır.</p>
			</div>
			<ol class="steps">
				{STEPS.map((s, i) => (
					<li class="step">
						<span class="step-num">{i + 1}</span>
						<h3>{s.t}</h3>
						<p>{s.d}</p>
					</li>
				))}
			</ol>
		</section>
	</div>
</Layout>

<style>
	.sources-page {
		max-width: 1080px;
		margin: 0 auto;
	}

	.group {
		margin-bottom: 48px;
	}

	.group-head {
		margin-bottom: 18px;
	}

	.group-head h2 {
		margin-bottom: 4px;
		font-size: 1.4rem;
		letter-spacing: -0.03em;
	}

	.group-head p {
		margin: 0;
	}

	.source-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: 16px;
	}

	.source-card {
		display: flex;
		flex-direction: column;
		padding: 18px;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
		color: var(--text);
		text-decoration: none;
		transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
	}

	.source-card:hover {
		transform: translateY(-2px);
		border-color: var(--border-strong);
		box-shadow: var(--shadow-md);
	}

	.source-card.off {
		opacity: 0.55;
	}

	.source-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 14px;
	}

	.avatar {
		width: 38px;
		height: 38px;
		display: grid;
		place-items: center;
		border-radius: 11px;
		background: var(--surface-2);
		color: var(--text-2);
		font-weight: 700;
	}

	.tier {
		padding: 3px 10px;
		border-radius: 999px;
		background: var(--surface-2);
		color: var(--text-2);
		font-size: 0.72rem;
		font-weight: 600;
	}

	.tier-resmi {
		background: var(--accent-soft);
		color: var(--accent-text);
	}

	.source-card h3 {
		margin: 0 0 2px;
		font-size: 1.02rem;
		letter-spacing: -0.015em;
	}

	.source-host {
		margin: 0 0 12px;
		color: var(--muted);
		font-size: 0.82rem;
	}

	.source-info {
		display: flex;
		align-items: center;
		gap: 8px;
		margin: auto 0 0;
		color: var(--text-2);
		font-size: 0.8rem;
	}

	.status {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		font-weight: 600;
	}

	.status::before {
		content: '';
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--muted);
	}

	.status.on {
		color: #16a34a;
	}

	.status.on::before {
		background: #22c55e;
	}

	.source-note {
		margin: 10px 0 0;
		padding-top: 10px;
		border-top: 1px solid var(--border);
		color: var(--muted);
		font-size: 0.8rem;
		line-height: 1.5;
	}

	.steps {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 16px;
	}

	.step {
		padding: 20px;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
	}

	.step-num {
		width: 34px;
		height: 34px;
		display: grid;
		place-items: center;
		margin-bottom: 14px;
		border-radius: 10px;
		background: linear-gradient(135deg, var(--accent), var(--accent-2));
		color: #fff;
		font-weight: 700;
	}

	.step h3 {
		margin-bottom: 6px;
		font-size: 1.02rem;
	}

	.step p {
		margin: 0;
		color: var(--text-2);
		font-size: 0.9rem;
		line-height: 1.55;
	}
</style>

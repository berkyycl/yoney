---
import Layout from '../layouts/Layout.astro';
import fs from 'fs';
import path from 'path';

const sourcesFile = path.join(process.cwd(), 'config', 'sources.json');
let sources: any[] = [];
if (fs.existsSync(sourcesFile)) {
    sources = JSON.parse(fs.readFileSync(sourcesFile, 'utf-8'));
}

const TIER: Record<string, string> = { resmi: 'Resmi', bagimsiz: 'Bağımsız basın', topluluk: 'Topluluk' };
// Topluluk tarafından üretilen akışlar GitHub'dan okunuyor; listede asıl site gösterilir
const SITE: Record<string, string> = {
	'anthropic-news': 'anthropic.com/news',
	'anthropic-research': 'anthropic.com/research',
	'xai-news': 'x.ai/news',
	'mistral-news': 'mistral.ai/news',
};
const host = (s: any) => { try { return SITE[s.id] ?? new URL(s.url).hostname.replace(/^www\./, ''); } catch { return s.url; } };
const byActive = (a: any, b: any) => Number(b.enabled) - Number(a.enabled);
const groups = [
	{ title: 'Laboratuvarlar', color: 'var(--a2)', items: sources.filter(s => s.type !== 'benchmark_api' && s.tier === 'resmi').sort(byActive) },
	{ title: 'Bağımsız basın', color: 'var(--a3)', items: sources.filter(s => s.type !== 'benchmark_api' && s.tier === 'bagimsiz').sort(byActive) },
	{ title: 'Topluluk', color: 'var(--a4)', items: sources.filter(s => s.type !== 'benchmark_api' && s.tier === 'topluluk').sort(byActive) },
	{ title: 'Liderlik tabloları', color: 'var(--a1)', items: sources.filter(s => s.type === 'benchmark_api').sort(byActive) },
].filter(g => g.items.length > 0);
const activeCount = sources.filter(s => s.enabled).length;
---

<Layout title="Kaynaklar | Yöney" description="Yöney'in haber ve benchmark verilerini topladığı kaynaklar ve içeriklerin nasıl hazırlandığı." palette="denizci">
	<div class="sources-page">
		<header class="page-head">
			<p class="overline">Kaynaklar</p>
			<h1>Bilgi <em>nereden</em> geliyor?</h1>
			<p class="lead">Yöney {activeCount} kaynağı izler. Her haberin altında orijinal kaynağa bağlantı bulunur; özetler hiçbir zaman kaynağın yerine geçmez.</p>
		</header>

		{groups.map((g, i) => (
			<section class="group" style={`--g:${g.color}`}>
				<div class="section-head">
					<span class="sec-num">{String(i + 1).padStart(2, '0')}</span>
					<h2>{g.title}</h2>
					<span class="sec-line" aria-hidden="true"></span>
				</div>
				<ul class="source-list">
					{g.items.map((s, n) => (
						<li class:list={['source', 'pose', { off: !s.enabled }]} style={`--delay:${(n % 3) * 0.06}s`}>
							<a class="source-name" href={s.url} target="_blank" rel="noopener noreferrer" lang="en">{s.name}</a>
							<p class="source-host">{host(s)}</p>
							<p class="source-info">
								<span class:list={['status', s.enabled ? 'on' : 'off']}>{s.enabled ? 'Aktif' : 'Pasif'}</span>
								<span>{TIER[s.tier] ?? s.tier}</span>
								<span>{s.type === 'benchmark_api' ? 'Liderlik tablosu' : 'RSS'}{s.maxItems ? ` · turda en fazla ${s.maxItems}` : ''}</span>
							</p>
							{s.note && <p class="source-note">{s.note}</p>}
						</li>
					))}
				</ul>
			</section>
		))}
	</div>
</Layout>

<style>
	.sources-page {
		max-width: 1140px;
		margin: 0 auto;
	}

	.group {
		margin-bottom: 72px;
	}

	.source-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 22px;
	}

	.source {
		padding: 20px 20px 18px;
		background: var(--surface);
		border: 2px solid var(--line);
		box-shadow: 7px 7px 0 var(--g);
		transition: transform 0.3s var(--ease-pose);
	}

	.source:hover {
		transform: rotate(-1deg) translateY(-3px);
	}

	.source.off {
		opacity: 0.5;
	}

	.source-name {
		color: var(--text);
		font-family: var(--font-display);
		font-size: 1.55rem;
		line-height: 1.02;
		text-decoration: none;
		text-transform: uppercase;
	}

	.source-name:hover {
		color: var(--a1);
	}

	.source-name::after {
		content: ' ↗';
		font-family: var(--font-sans);
		font-size: 0.7em;
		color: var(--muted);
	}

	.source-host {
		margin: 4px 0 10px;
		color: var(--muted);
		font-size: 0.85rem;
	}

	.source-info {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 12px;
		margin: 0;
		color: var(--text-2);
		font-size: 0.68rem;
		font-weight: 900;
		font-stretch: 80%;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.status::before {
		content: '';
		display: inline-block;
		width: 8px;
		height: 8px;
		margin-right: 6px;
		background: var(--muted);
		transform: rotate(45deg);
		vertical-align: 1px;
	}

	.status.on {
		color: var(--a3);
	}

	.status.on::before {
		background: var(--a3);
	}

	.source-note {
		margin: 10px 0 0;
		padding-top: 10px;
		border-top: 1px solid var(--rule);
		color: var(--text-2);
		font-family: var(--font-serif);
		font-size: 0.95rem;
		font-style: italic;
		line-height: 1.4;
	}

	@media (max-width: 960px) {
		.source-list {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (max-width: 600px) {
		.source-list {
			grid-template-columns: 1fr;
		}
	}
</style>
